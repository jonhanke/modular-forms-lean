/-- **Jacobi, § 29** (*Fundamenta nova*, p. 67): the modular equations of orders `3`
and `5` in the variables `q = 1 - 2k² = 1 - 2u⁸`, `l = 1 - 2λ² = 1 - 2v⁸`; the order-`5` bracket in its expanded
form; and the order-`3` equation in `k² = u⁸`, `λ² = v⁸`. -/
@[kb "jacobi1829" "§ 29, p. 67"]
theorem jacobiModEqQL {u v : F} :
    (modEqThree u v = 0 → modEqThreeQL (1 - 2 * u ^ 8) (1 - 2 * v ^ 8) = 0) ∧
    (modEqFive u v = 0 → modEqFiveQL (1 - 2 * u ^ 8) (1 - 2 * v ^ 8) = 0) ∧
    (∀ q l : F, 16 * q * l * (9 - q * l) ^ 2 + 9 * (45 - q * l) * (q - l) ^ 2 =
      405 * (q ^ 2 + l ^ 2) + 486 * q * l - 9 * q * l * (q ^ 2 + l ^ 2) - 270 * q ^ 2 * l ^ 2 +
        16 * q ^ 3 * l ^ 3) ∧
    (modEqThree u v = 0 → (u ^ 8 - v ^ 8) ^ 4 =
      128 * u ^ 8 * v ^ 8 * (1 - u ^ 8) * (1 - v ^ 8) * (2 - u ^ 8 - v ^ 8 + 2 * u ^ 8 * v ^ 8)) := by
  refine ⟨modEqThreeQL_of, modEqFiveQL_of, fun q l => by ring, fun h => ?_⟩
  have h3 := modEqThreeQL_of h
  unfold modEqThreeQL at h3
  linear_combination (1 / 16 : F) * h3

/-- **Jacobi, § 29** (*Fundamenta nova*, pp. 66–67, first part): the relations in
`q = 1 - 2k²`, `l = 1 - 2λ²` are unchanged by `(q, l) ↦ (-q, -l)`, which is `(k², λ²) ↦ (1 - k², 1 - λ²) = (k'², λ'²)`. -/
@[kb "jacobi1829" "§ 29, pp. 66–67"]
theorem jacobiModEqQL_neg (q l : F) :
    modEqThreeQL (-q) (-l) = modEqThreeQL q l ∧ modEqFiveQL (-q) (-l) = modEqFiveQL q l := by
  unfold modEqThreeQL modEqFiveQL
  constructor <;> ring

end Algebra

section Real

open Real

private theorem legendreIdent (u v : ℝ) :
    (1 - u ^ 2 * v ^ 2) ^ 4 - (1 - u ^ 8) * (1 - v ^ 8) = -(modEqThree u v * modEqThree v u) := by
  unfold modEqThree; ring

private theorem lt_of_modEqThree {u v : ℝ} (hu0 : 0 < u) (hu1 : u < 1) (hv0 : 0 < v) (_hv1 : v < 1)
    (h : modEqThree u v = 0) : u < v := by
  by_contra hlt
  replace hlt := not_lt.mp hlt
  have h4 : v ^ 4 ≤ u ^ 4 := pow_le_pow_left₀ hv0.le hlt 4
  have huv : u ^ 2 * v ^ 2 < 1 := by
    have h1 : u ^ 2 < 1 := by nlinarith
    have h2 : v ^ 2 < 1 := by nlinarith
    nlinarith [sq_nonneg u, sq_nonneg v, mul_pos hu0 hu0, mul_pos hv0 hv0]
  have hpos : 0 < 2 * u * v * (1 - u ^ 2 * v ^ 2) := by
    have := mul_pos (mul_pos hu0 hv0) (sub_pos.mpr huv)
    linarith
  unfold modEqThree at h
  linarith

/-- **Legendre's relation** (Jacobi, *Fundamenta nova* § 30, pp. 68–69): for
`0 ≤ u, v ≤ 1`, with `k = u⁴`, `λ = v⁴`, `k' = √(1 - k²)`, `λ' = √(1 - λ²)`,
`√(kλ) + √(k'λ') = 1` holds exactly when `modEqThree u v = 0` or `modEqThree v u = 0` (`λ` the transform of order `3`
of `k`, or `k` that of `λ`). -/
@[kb "jacobi1829" "§ 30, pp. 68–69"]
theorem legendreRelationThree {u v : ℝ} (hu0 : 0 ≤ u) (hu1 : u ≤ 1) (hv0 : 0 ≤ v) (hv1 : v ≤ 1) :
    √(u ^ 4 * v ^ 4) + √(√(1 - (u ^ 4) ^ 2) * √(1 - (v ^ 4) ^ 2)) = 1 ↔
      modEqThree u v = 0 ∨ modEqThree v u = 0 := by
  have hu4 : u ^ 4 ≤ 1 := pow_le_one₀ hu0 hu1
  have hv4 : v ^ 4 ≤ 1 := pow_le_one₀ hv0 hv1
  have huv : u ^ 2 * v ^ 2 ≤ 1 :=
    (mul_le_of_le_one_right (by positivity) (pow_le_one₀ hv0 hv1)).trans (pow_le_one₀ hu0 hu1)
  have hc : 0 ≤ 1 - u ^ 2 * v ^ 2 := by linarith
  have h1 : √(u ^ 4 * v ^ 4) = u ^ 2 * v ^ 2 := by
    rw [show u ^ 4 * v ^ 4 = (u ^ 2 * v ^ 2) ^ 2 by ring]
    exact Real.sqrt_sq (by positivity)
  have hA : 0 ≤ 1 - (u ^ 4) ^ 2 := by nlinarith [pow_nonneg hu0 4]
  have hB : 0 ≤ 1 - (v ^ 4) ^ 2 := by nlinarith [pow_nonneg hv0 4]
  rw [h1, ← Real.sqrt_mul hA]
  have hY : 0 ≤ (1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2) := mul_nonneg hA hB
  have key : √(√((1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2))) = 1 - u ^ 2 * v ^ 2 ↔
      (1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2) = (1 - u ^ 2 * v ^ 2) ^ 4 := by
    constructor
    · intro h
      have h2 : √((1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2)) = (1 - u ^ 2 * v ^ 2) ^ 2 := by
        rw [← h, Real.sq_sqrt (Real.sqrt_nonneg _)]
      have := Real.sq_sqrt hY
      rw [h2] at this
      rw [← this]; ring
    · intro h
      rw [h, show (1 - u ^ 2 * v ^ 2) ^ 4 = ((1 - u ^ 2 * v ^ 2) ^ 2) ^ 2 by ring,
        Real.sqrt_sq (by positivity), Real.sqrt_sq hc]
  have e : u ^ 2 * v ^ 2 + √(√((1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2))) = 1 ↔
      √(√((1 - (u ^ 4) ^ 2) * (1 - (v ^ 4) ^ 2))) = 1 - u ^ 2 * v ^ 2 := by
    constructor <;> intro h <;> linarith
  rw [e, key]
  have hid := legendreIdent u v
  constructor
  · intro h
    have : modEqThree u v * modEqThree v u = 0 := by
      have h' : (1 - u ^ 8) * (1 - v ^ 8) = (1 - u ^ 2 * v ^ 2) ^ 4 := by
        have := h; ring_nf at this ⊢; linarith
      linarith
    exact mul_eq_zero.mp this
  · intro h
    have : modEqThree u v * modEqThree v u = 0 := by
      rcases h with h | h <;> rw [h] <;> simp
    have h' : (1 - u ^ 8) * (1 - v ^ 8) = (1 - u ^ 2 * v ^ 2) ^ 4 := by linarith
    ring_nf at h' ⊢; linarith

/-- **Jacobi, § 29** (*Fundamenta nova*, pp. 66–67, second part): if `0 < u, v < 1` satisfy
the modular equation of order `3` and `u'`, `v' ∈ (0, 1)` are the fourth roots of the complementary moduli
(`u'⁸ = 1 - u⁸`, `v'⁸ = 1 - v⁸`), then `modEqThree v' u' = 0`: the complementary moduli are related by the same
equation, with `k'` the transform of `λ'`. -/
@[kb "jacobi1829" "§ 29, pp. 66–67"]
theorem jacobiModEqThree_compl {u v u' v' : ℝ} (hu0 : 0 < u) (hu1 : u < 1) (hv0 : 0 < v) (hv1 : v < 1)
    (hu'0 : 0 < u') (hv'0 : 0 < v') (hu' : u' ^ 8 = 1 - u ^ 8) (hv' : v' ^ 8 = 1 - v ^ 8)
    (h : modEqThree u v = 0) : modEqThree v' u' = 0 := by
  have hu'1 : u' < 1 := by
    by_contra hc
    have := one_le_pow₀ (n := 8) (not_lt.mp hc)
    have : 0 < u ^ 8 := by positivity
    linarith
  have hv'1 : v' < 1 := by
    by_contra hc
    have := one_le_pow₀ (n := 8) (not_lt.mp hc)
    have : 0 < v ^ 8 := by positivity
    linarith
  have huv : u < v := lt_of_modEqThree hu0 hu1 hv0 hv1 h
  have h8 : u ^ 8 < v ^ 8 := (pow_lt_pow_iff_left₀ hu0.le hv0.le (by norm_num)).mpr huv
  have hvu' : v' < u' := by
    refine (pow_lt_pow_iff_left₀ hv'0.le hu'0.le (by norm_num : (8:ℕ) ≠ 0)).mp ?_
    rw [hu', hv']; linarith
  have hid := legendreIdent u v
  rw [h, zero_mul, neg_zero] at hid
  have e0 : ((u' * v') ^ 2) ^ 4 = (1 - u ^ 2 * v ^ 2) ^ 4 := by
    have : ((u' * v') ^ 2) ^ 4 = u' ^ 8 * v' ^ 8 := by ring
    rw [this, hu', hv']; linarith
  have hc0 : 0 ≤ 1 - u ^ 2 * v ^ 2 := by
    have h1 : u ^ 2 < 1 := by nlinarith
    have h2 : v ^ 2 < 1 := by nlinarith
    nlinarith [sq_nonneg u, sq_nonneg v, mul_pos hu0 hu0, mul_pos hv0 hv0]
  have e1 : (u' * v') ^ 2 = 1 - u ^ 2 * v ^ 2 :=
    (pow_left_inj₀ (by positivity) hc0 (by norm_num : (4:ℕ) ≠ 0)).mp e0
  have e1' : 1 - u' ^ 2 * v' ^ 2 = u ^ 2 * v ^ 2 := by rw [← mul_pow]; linarith
  have hid' := legendreIdent u' v'
  rw [e1', show 1 - u' ^ 8 = u ^ 8 by linarith, show 1 - v' ^ 8 = v ^ 8 by linarith] at hid'
  have hprod : modEqThree u' v' * modEqThree v' u' = 0 := by
    have : (u ^ 2 * v ^ 2) ^ 4 - u ^ 8 * v ^ 8 = 0 := by ring
    linarith
  rcases mul_eq_zero.mp hprod with h0 | h0
  · exact absurd (lt_of_modEqThree hu'0 hu'1 hv'0 hv'1 h0) (not_lt.mpr hvu'.le)
  · exact h0

private theorem hasDerivAt_sub' {a b : ℝ → ℝ} {a' b' v : ℝ} (h1 : HasDerivAt a a' v)
    (h2 : HasDerivAt b b' v) : HasDerivAt (fun x => a x - b x) (a' - b') v := by
  have := (h1.hasFDerivAt.sub h2.hasFDerivAt).hasDerivAt
  simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.toSpanSingleton_apply,
    smul_eq_mul, mul_one, one_mul] at this
  exact this

private theorem hasDerivAt_add' {a b : ℝ → ℝ} {a' b' v : ℝ} (h1 : HasDerivAt a a' v)
    (h2 : HasDerivAt b b' v) : HasDerivAt (fun x => a x + b x) (a' + b') v := by
  have := (h1.hasFDerivAt.add h2.hasFDerivAt).hasDerivAt
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.toSpanSingleton_apply,
    smul_eq_mul, mul_one, one_mul] at this
  exact this

/-- **Jacobi's multiplier formula for order `3`** (*Fundamenta nova* § 34, pp. 81–82):
let `f` be differentiable at `v` with `f'(v) = d`, and let `u = f(w)` solve the order-`3` equation for all `w` near
`v`. If the branch is non-singular there (`∂/∂u` of the equation non-zero) and `u, v, 1 - u⁸, v + 2u³ ≠ 0`, then
the multiplier `M = v/(v + 2u³)` satisfies `3 M² = v(1 - v⁸)/(u(1 - u⁸)) · du/dv`. -/
@[kb "jacobi1829" "§ 34, pp. 81–82"]
theorem jacobiMultiplierThreeDeriv {f : ℝ → ℝ} {v d : ℝ} (hf : HasDerivAt f d v)
    (hF : ∀ᶠ w in nhds v, modEqThree (f w) w = 0)
    (hns : 4 * f v ^ 3 + 2 * v - 6 * f v ^ 2 * v ^ 3 ≠ 0)
    (hu : f v ≠ 0) (hv : v ≠ 0) (hu8 : 1 - f v ^ 8 ≠ 0) (hM : v + 2 * f v ^ 3 ≠ 0) :
    3 * (v / (v + 2 * f v ^ 3)) ^ 2 = v * (1 - v ^ 8) / (f v * (1 - f v ^ 8)) * d := by
  have hd : HasDerivAt (fun w => f w ^ 4 - w ^ 4 + 2 * f w * w * (1 - f w ^ 2 * w ^ 2))
      ((4 * f v ^ 3 + 2 * v - 6 * f v ^ 2 * v ^ 3) * d + (-4 * v ^ 3 + 2 * f v - 6 * f v ^ 3 * v ^ 2)) v := by
    have hid := hasDerivAt_id v
    exact (hasDerivAt_add' (hasDerivAt_sub' (hf.pow 4) (hid.pow 4)) (((hf.const_mul 2).mul hid).mul
      (hasDerivAt_sub' (hasDerivAt_const v (1 : ℝ)) ((hf.pow 2).mul (hid.pow 2))))).congr_deriv
      (by simp; ring)
  have hc : HasDerivAt (fun w => f w ^ 4 - w ^ 4 + 2 * f w * w * (1 - f w ^ 2 * w ^ 2)) 0 v :=
    (hasDerivAt_const v (0 : ℝ)).congr_of_eventuallyEq
      (hF.mono fun w hw => by unfold modEqThree at hw; exact hw)
  have hz := hd.unique hc
  have E0 : modEqThree (f v) v = 0 := hF.self_of_nhds
  unfold modEqThree at E0
  set u := f v with hu_def
  have key : 3 * v ^ 2 * u * (1 - u ^ 8) - (v + 2 * u ^ 3) ^ 2 * v * (1 - v ^ 8) * d = 0 := by
    have : (4 * u ^ 3 + 2 * v - 6 * u ^ 2 * v ^ 3) *
        (3 * v ^ 2 * u * (1 - u ^ 8) - (v + 2 * u ^ 3) ^ 2 * v * (1 - v ^ 8) * d) = 0 := by
      linear_combination ((-12) * u ^ 8 * v ^ 2 + (-6) * u ^ 7 * v ^ 5 + (-12) * u ^ 6 * v ^ 8 +
        (-6) * u ^ 5 * v ^ 3 + (-12) * u ^ 4 * v ^ 6 + (-14) * u ^ 3 * v ^ 9 + 8 * u ^ 3 * v +
        (-12) * u ^ 2 * v ^ 4 + (-6) * u * v ^ 7 + (-4) * v ^ 10 + 4 * v ^ 2) * E0 -
        ((v + 2 * u ^ 3) ^ 2 * v * (1 - v ^ 8)) * hz
    exact (mul_eq_zero.mp this).resolve_left hns
  field_simp
  apply mul_left_cancel₀ hv
  linear_combination key

/-- **Jacobi's multiplier formula for order `5`** (*Fundamenta nova* § 34, pp. 82–83):
as `jacobiMultiplierThreeDeriv`, for the order-`5` equation and `M = v(1 - uv³)/(v - u⁵)`:
`5 M² = v(1 - v⁸)/(u(1 - u⁸)) · du/dv`. -/
@[kb "jacobi1829" "§ 34, pp. 82–83"]
theorem jacobiMultiplierFiveDeriv {f : ℝ → ℝ} {v d : ℝ} (hf : HasDerivAt f d v)
    (hF : ∀ᶠ w in nhds v, modEqFive (f w) w = 0)
    (hns : 6 * f v ^ 5 + 20 * f v ^ 3 * v ^ 2 - 10 * f v * v ^ 4 + 4 * v - 20 * f v ^ 4 * v ^ 5 ≠ 0)
    (hu : f v ≠ 0) (hv : v ≠ 0) (hu8 : 1 - f v ^ 8 ≠ 0) (hM : v - f v ^ 5 ≠ 0) :
    5 * (v * (1 - f v * v ^ 3) / (v - f v ^ 5)) ^ 2 = v * (1 - v ^ 8) / (f v * (1 - f v ^ 8)) * d := by
  have hd : HasDerivAt (fun w => f w ^ 6 - w ^ 6 + 5 * f w ^ 2 * w ^ 2 * (f w ^ 2 - w ^ 2) +
        4 * f w * w * (1 - f w ^ 4 * w ^ 4))
      ((6 * f v ^ 5 + 20 * f v ^ 3 * v ^ 2 - 10 * f v * v ^ 4 + 4 * v - 20 * f v ^ 4 * v ^ 5) * d +
        (-6 * v ^ 5 + 10 * f v ^ 4 * v - 20 * f v ^ 2 * v ^ 3 + 4 * f v - 20 * f v ^ 5 * v ^ 4)) v := by
    have hid := hasDerivAt_id v
    exact (hasDerivAt_add' (hasDerivAt_add' (hasDerivAt_sub' (hf.pow 6) (hid.pow 6))
      ((((hf.pow 2).const_mul 5).mul (hid.pow 2)).mul (hasDerivAt_sub' (hf.pow 2) (hid.pow 2))))
      (((hf.const_mul 4).mul hid).mul (hasDerivAt_sub' (hasDerivAt_const v (1 : ℝ))
        ((hf.pow 4).mul (hid.pow 4))))).congr_deriv (by simp; ring)
  have hc : HasDerivAt (fun w => f w ^ 6 - w ^ 6 + 5 * f w ^ 2 * w ^ 2 * (f w ^ 2 - w ^ 2) +
        4 * f w * w * (1 - f w ^ 4 * w ^ 4)) 0 v :=
    (hasDerivAt_const v (0 : ℝ)).congr_of_eventuallyEq
      (hF.mono fun w hw => by unfold modEqFive at hw; exact hw)
  have hz := hd.unique hc
  have E0 : modEqFive (f v) v = 0 := hF.self_of_nhds
  unfold modEqFive at E0
  set u := f v with hu_def
  have key : 5 * (v * (1 - u * v ^ 3)) ^ 2 * u * (1 - u ^ 8) -
      (v - u ^ 5) ^ 2 * v * (1 - v ^ 8) * d = 0 := by
    have : (6 * u ^ 5 + 20 * u ^ 3 * v ^ 2 - 10 * u * v ^ 4 + 4 * v - 20 * u ^ 4 * v ^ 5) *
        (5 * (v * (1 - u * v ^ 3)) ^ 2 * u * (1 - u ^ 8) - (v - u ^ 5) ^ 2 * v * (1 - v ^ 8) * d) = 0 := by
      linear_combination ((-30) * u ^ 10 * v ^ 8 + 40 * u ^ 9 * v ^ 5 + (-20) * u ^ 8 * v ^ 2 +
        20 * u ^ 7 * v ^ 7 + (-20) * u ^ 6 * v ^ 4 + 16 * u ^ 5 * v ^ 9 + 4 * u ^ 5 * v +
        (-20) * u ^ 4 * v ^ 6 + 20 * u ^ 3 * v ^ 3 + 10 * u ^ 2 * v ^ 8 + (-20) * u * v ^ 5 +
        (-6) * v ^ 10 + 6 * v ^ 2) * E0 - ((v - u ^ 5) ^ 2 * v * (1 - v ^ 8)) * hz
    exact (mul_eq_zero.mp this).resolve_left hns
  field_simp
  apply mul_left_cancel₀ hv
  linear_combination key

end Real

