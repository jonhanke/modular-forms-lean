import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
import Mathlib.LinearAlgebra.FreeModule.Finite.CardQuotient
import Mathlib.GroupTheory.IndexNSmul
import ModularFormsKB.Milne.Ch5.Matrices

/-!
# Milne, Chapter 5: abstract Hecke operators on lattices (Proposition 5.9, Remark 5.14)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 5, pdf pp. 70–73.

Milne's $D$ is the free abelian group on the set $\mathcal L$ of lattices in $\mathbb C$, with
$T(n)[\Lambda] = \sum_{(\Lambda : \Lambda') = n} [\Lambda']$ and $R(n)[\Lambda] = [n\Lambda]$. Here the operators are
defined on the free abelian group `Submodule ℤ V →₀ ℤ` on all subgroups of an abelian group $V$ (`latticeT`,
`latticeR`); Milne's $D$ is the span of the lattices for $V = \mathbb C$. Propositions 5.9 and 5.10 are proved for
every subgroup $\Lambda$ with a $\mathbb Z$-basis of two elements, which includes every lattice in $\mathbb C$
(a lattice is `PeriodPair.lattice` in Mathlib: $\mathbb Z\omega_1 + \mathbb Z\omega_2$ with $\omega_1, \omega_2$
linearly independent over $\mathbb R$). For an infinite set of sublattices (which happens only when $\Lambda$ has
infinite rank) `latticeT` takes the junk value $0$ (`finsum`).

## Items
- The operators $T(n)$, $R(n)$ on $D$ (`latticeT`, `latticeR`), p. 70.
- Remark 5.14, lattice form: the sublattices of index $n$ of $\mathbb Z\omega_1 + \mathbb Z\omega_2$ are the
  $(a\omega_1 + b\omega_2, d\omega_2)$ (`bijOn_hermiteTriples_subOfIndex`), $p + 1$ of them for $n = p$
  (`ncard_subOfIndex_prime`).
- Proposition 5.9 (`latticeT_mul_of_coprime`, `latticeT_prime_pow_mul_prime`).
- Corollaries 5.10, 5.11 and Proposition 5.12 are in `LatticeHeckeAlgebra.lean`.
-/

open Finsupp

namespace ModularFormsKB.Milne

section General

variable {V : Type*} [AddCommGroup V]

/-- The sublattices $\Lambda' \subseteq \Lambda$ of index $(\Lambda : \Lambda') = n$. -/
def subOfIndex (Λ : Submodule ℤ V) (n : ℕ) : Set (Submodule ℤ V) :=
  {Λ' | Λ' ≤ Λ ∧ Λ'.toAddSubgroup.relIndex Λ.toAddSubgroup = n}

/-- **Milne's $T(n)$ on $D$** (p. 70): the $\mathbb Z$-linear operator with
$T(n)[\Lambda] = \sum_{\Lambda' \subseteq \Lambda,\ (\Lambda : \Lambda') = n}[\Lambda']$. -/
@[kb "milne2017mf" "Section 5, the operators T(n) on D (pdf p. 70)"]
noncomputable def latticeT (n : ℕ) : (Submodule ℤ V →₀ ℤ) →ₗ[ℤ] (Submodule ℤ V →₀ ℤ) :=
  Finsupp.linearCombination ℤ fun Λ ↦ ∑ᶠ Λ' ∈ subOfIndex Λ n, Finsupp.single Λ' (1 : ℤ)

/-- The subgroup $n\Lambda$. -/
def scaleSub (n : ℤ) (Λ : Submodule ℤ V) : Submodule ℤ V := Λ.map (n • LinearMap.id)

/-- **Milne's $R(n)$ on $D$** (p. 70): $R(n)[\Lambda] = [n\Lambda]$. -/
@[kb "milne2017mf" "Section 5, the operators R(n) on D (pdf p. 70)"]
noncomputable def latticeR (n : ℕ) : (Submodule ℤ V →₀ ℤ) →ₗ[ℤ] (Submodule ℤ V →₀ ℤ) :=
  Finsupp.lmapDomain ℤ ℤ (scaleSub (n : ℤ))

namespace LatticeAux

theorem relIndex_eq_natAbs_det' (N M : Submodule ℤ V) (h : N ≤ M) (bN : Module.Basis (Fin 2) ℤ N)
    (bM : Module.Basis (Fin 2) ℤ M) :
    N.toAddSubgroup.relIndex M.toAddSubgroup = (bM.det (fun i => (⟨bN i, h (bN i).2⟩ : M))).natAbs :=
  AddSubgroup.relIndex_eq_natAbs_det N.toAddSubgroup M.toAddSubgroup h (ι := Fin 2) bN bM

theorem finrank_sub (N M : Submodule ℤ V) (h : N ≤ M) [Module.Finite ℤ M] [Module.IsTorsionFree ℤ M]
    (hn : N.toAddSubgroup.relIndex M.toAddSubgroup ≠ 0) : Module.finrank ℤ N = Module.finrank ℤ M := by
  have : N.toAddSubgroup.IsFiniteRelIndex M.toAddSubgroup := ⟨hn⟩
  exact AddSubgroup.finrank_eq_of_isFiniteRelIndex (A := N.toAddSubgroup) (B := M.toAddSubgroup) h

/-- A submodule with a basis of two elements has rank two, is finite and torsion free. -/
theorem finrank_eq_two {Λ : Submodule ℤ V} (b : Module.Basis (Fin 2) ℤ Λ) : Module.finrank ℤ Λ = 2 := by
  simp [Module.finrank_eq_card_basis b]

/-- A finite-index sublattice of a lattice with a basis of two elements has a basis of two elements. -/
theorem nonempty_basis_of_relIndex {Λ Λ' : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ))
    (h : Λ' ≤ Λ) (hn : Λ'.toAddSubgroup.relIndex Λ.toAddSubgroup ≠ 0) :
    Nonempty (Module.Basis (Fin 2) ℤ Λ') := by
  obtain ⟨b⟩ := hΛ
  have := Module.Free.of_basis b
  have := Module.Finite.of_basis b
  have : Module.IsTorsionFree ℤ Λ' :=
    Function.Injective.moduleIsTorsionFree (Submodule.inclusion h) (Submodule.inclusion_injective h)
      (fun _ _ => rfl)
  have : Module.Finite ℤ Λ' :=
    Module.Finite.of_injective (Submodule.inclusion h) (Submodule.inclusion_injective h)
  have : Module.Free ℤ Λ' := Module.free_of_finite_type_torsion_free'
  have h2 := finrank_sub Λ' Λ h hn
  rw [finrank_eq_two b] at h2
  exact ⟨Module.finBasisOfFinrankEq ℤ Λ' h2⟩

/-- The vector $A_{i0}\omega_1 + A_{i1}\omega_2$. -/
def rowVec (ω₁ ω₂ : V) (A : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 2) : V := A i 0 • ω₁ + A i 1 • ω₂

/-- The subgroup generated by the two vectors `rowVec A i`. -/
def rowSpan (ω₁ ω₂ : V) (A : Matrix (Fin 2) (Fin 2) ℤ) : Submodule ℤ V :=
  Submodule.span ℤ (Set.range (rowVec ω₁ ω₂ A))

theorem rowSpan_upperTri (ω₁ ω₂ : V) (a b d : ℤ) :
    rowSpan ω₁ ω₂ (upperTri a b d) = Submodule.span ℤ {a • ω₁ + b • ω₂, d • ω₂} := by
  unfold rowSpan
  congr 1
  ext z
  simp [Fin.exists_fin_two, rowVec, upperTri, eq_comm]

theorem rowVec_mul (ω₁ ω₂ : V) (B A : Matrix (Fin 2) (Fin 2) ℤ) (i : Fin 2) :
    rowVec ω₁ ω₂ (B * A) i = B i 0 • rowVec ω₁ ω₂ A 0 + B i 1 • rowVec ω₁ ω₂ A 1 := by
  simp only [rowVec, Matrix.mul_apply, Fin.sum_univ_two]
  module

theorem rowSpan_mul_le (ω₁ ω₂ : V) (B A : Matrix (Fin 2) (Fin 2) ℤ) :
    rowSpan ω₁ ω₂ (B * A) ≤ rowSpan ω₁ ω₂ A := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  rw [rowVec_mul]
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩))
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, rfl⟩))

theorem rowSpan_unit (ω₁ ω₂ : V) (U : GL (Fin 2) ℤ) (A : Matrix (Fin 2) (Fin 2) ℤ) :
    rowSpan ω₁ ω₂ ((U : Matrix (Fin 2) (Fin 2) ℤ) * A) = rowSpan ω₁ ω₂ A := by
  refine le_antisymm (rowSpan_mul_le _ _ _ _) ?_
  have := rowSpan_mul_le ω₁ ω₂ ((U⁻¹ : GL (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ)
    ((U : Matrix (Fin 2) (Fin 2) ℤ) * A)
  rwa [← Matrix.mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.one_mul] at this

theorem exists_mul_of_rowSpan_le {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂])
    {A A' : Matrix (Fin 2) (Fin 2) ℤ} (h : rowSpan ω₁ ω₂ A' ≤ rowSpan ω₁ ω₂ A) :
    ∃ B : Matrix (Fin 2) (Fin 2) ℤ, A' = B * A := by
  have hp := LinearIndependent.pair_iff.mp hli
  have key : ∀ i, ∃ c : Fin 2 → ℤ, ∑ j, c j • rowVec ω₁ ω₂ A j = rowVec ω₁ ω₂ A' i := by
    intro i
    exact (Submodule.mem_span_range_iff_exists_fun ℤ).1 (h (Submodule.subset_span ⟨i, rfl⟩))
  choose c hc using key
  refine ⟨Matrix.of c, ?_⟩
  ext i k
  have h1 := hc i
  simp only [Fin.sum_univ_two, rowVec] at h1
  have h2 := hp ((c i 0 * A 0 0 + c i 1 * A 1 0) - A' i 0) ((c i 0 * A 0 1 + c i 1 * A 1 1) - A' i 1) (by
    rw [← sub_eq_zero] at h1
    rw [← h1]
    module)
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.of_apply]
  fin_cases k
  · simp only [Fin.zero_eta]; linarith [h2.1]
  · simp only [Fin.mk_one]; linarith [h2.2]

theorem exists_unit_of_rowSpan_eq {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂])
    {A A' : Matrix (Fin 2) (Fin 2) ℤ} (hA : A.det ≠ 0) (hA' : A'.det ≠ 0)
    (h : rowSpan ω₁ ω₂ A = rowSpan ω₁ ω₂ A') :
    ∃ U : GL (Fin 2) ℤ, (U : Matrix (Fin 2) (Fin 2) ℤ) * A = A' := by
  obtain ⟨B, hB⟩ := exists_mul_of_rowSpan_le hli h.le
  obtain ⟨B', hB'⟩ := exists_mul_of_rowSpan_le hli h.ge
  have cancel : ∀ (X Y : Matrix (Fin 2) (Fin 2) ℤ), Y.det ≠ 0 → X * Y = Y → X = 1 := by
    intro X Y hY hXY
    have h1 : (X - 1) * Y = 0 := by rw [sub_mul, hXY, one_mul, sub_self]
    have h3 : (X - 1) * (Y.det • (1 : Matrix (Fin 2) (Fin 2) ℤ)) = 0 := by
      rw [← Matrix.mul_adjugate Y, ← Matrix.mul_assoc, h1, zero_mul]
    rw [Matrix.mul_smul, Matrix.mul_one] at h3
    exact sub_eq_zero.mp ((smul_eq_zero.mp h3).resolve_left hY)
  have e1 : B' * B = 1 := cancel _ A' hA' (by rw [Matrix.mul_assoc, ← hB, ← hB'])
  have e2 : B * B' = 1 := cancel _ A hA (by rw [Matrix.mul_assoc, ← hB', ← hB])
  exact ⟨⟨B', B, e1, e2⟩, hB'.symm⟩

theorem linearIndependent_rowVec {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂])
    {A : Matrix (Fin 2) (Fin 2) ℤ} (hA : A.det ≠ 0) : LinearIndependent ℤ (rowVec ω₁ ω₂ A) := by
  have hp := LinearIndependent.pair_iff.mp hli
  rw [Fintype.linearIndependent_iff]
  intro g hg
  simp only [Fin.sum_univ_two, rowVec] at hg
  have h2 := hp (g 0 * A 0 0 + g 1 * A 1 0) (g 0 * A 0 1 + g 1 * A 1 1) (by rw [← hg]; module)
  rw [Matrix.det_fin_two] at hA
  have e0 : g 0 * (A 0 0 * A 1 1 - A 0 1 * A 1 0) = 0 := by
    linear_combination A 1 1 * h2.1 - A 1 0 * h2.2
  have e1 : g 1 * (A 0 0 * A 1 1 - A 0 1 * A 1 0) = 0 := by
    linear_combination A 0 0 * h2.2 - A 0 1 * h2.1
  intro i
  fin_cases i
  · exact (mul_eq_zero.mp e0).resolve_right hA
  · exact (mul_eq_zero.mp e1).resolve_right hA

theorem coe_eq_repr {M : Submodule ℤ V} (bM : Module.Basis (Fin 2) ℤ M) {ω₁ ω₂ : V}
    (h0 : (bM 0 : V) = ω₁) (h1 : (bM 1 : V) = ω₂) (x : M) :
    (x : V) = bM.repr x 0 • ω₁ + bM.repr x 1 • ω₂ := by
  have h := congrArg Subtype.val (bM.sum_repr x)
  simp only [Fin.sum_univ_two, Submodule.coe_add, Submodule.coe_smul, h0, h1] at h
  exact h.symm

theorem relIndex_eq_natAbs_det_rowVec {M N : Submodule ℤ V} (hNM : N ≤ M)
    (bM : Module.Basis (Fin 2) ℤ M) {ω₁ ω₂ : V}
    (h0 : (bM 0 : V) = ω₁) (h1 : (bM 1 : V) = ω₂)
    (bN : Module.Basis (Fin 2) ℤ N) (A : Matrix (Fin 2) (Fin 2) ℤ)
    (hA : ∀ i, (bN i : V) = rowVec ω₁ ω₂ A i) :
    N.toAddSubgroup.relIndex M.toAddSubgroup = A.det.natAbs := by
  rw [relIndex_eq_natAbs_det' N M hNM bN bM, Module.Basis.det_apply]
  have : bM.toMatrix (fun i => (⟨bN i, hNM (bN i).2⟩ : M)) = A.transpose := by
    ext i j
    rw [Module.Basis.toMatrix_apply]
    have hx : (⟨bN j, hNM (bN j).2⟩ : M) = A j 0 • bM 0 + A j 1 • bM 1 := by
      apply Subtype.ext
      simp [hA, rowVec, h0, h1]
    rw [hx]
    fin_cases i <;> simp
  rw [this, Matrix.det_transpose]

/-- The lattice `ℤω₁ + ℤω₂`, as the span of the range of `![ω₁, ω₂]`. -/
noncomputable def latBasis {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂]) :
    Module.Basis (Fin 2) ℤ (Submodule.span ℤ (Set.range ![ω₁, ω₂])) :=
  Module.Basis.span hli

theorem latBasis_zero {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂]) :
    ((latBasis hli 0 : Submodule.span ℤ (Set.range ![ω₁, ω₂])) : V) = ω₁ := by
  simp [latBasis, Module.Basis.span_apply]

theorem latBasis_one {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂]) :
    ((latBasis hli 1 : Submodule.span ℤ (Set.range ![ω₁, ω₂])) : V) = ω₂ := by
  simp [latBasis, Module.Basis.span_apply]

theorem rowSpan_le_lat (ω₁ ω₂ : V) (A : Matrix (Fin 2) (Fin 2) ℤ) :
    rowSpan ω₁ ω₂ A ≤ Submodule.span ℤ (Set.range ![ω₁, ω₂]) := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩))
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, rfl⟩))

theorem relIndex_rowSpan {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂])
    {A : Matrix (Fin 2) (Fin 2) ℤ} (hA : A.det ≠ 0) :
    (rowSpan ω₁ ω₂ A).toAddSubgroup.relIndex (Submodule.span ℤ (Set.range ![ω₁, ω₂])).toAddSubgroup
      = A.det.natAbs :=
  relIndex_eq_natAbs_det_rowVec (rowSpan_le_lat ω₁ ω₂ A) (latBasis hli) (latBasis_zero hli)
    (latBasis_one hli) (Module.Basis.span (linearIndependent_rowVec hli hA)) A
    (fun i => congrArg Subtype.val (Module.Basis.span_apply (linearIndependent_rowVec hli hA) i))

theorem exists_rowSpan_eq {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂])
    {Λ' : Submodule ℤ V} (h : Λ' ≤ Submodule.span ℤ (Set.range ![ω₁, ω₂]))
    (hn : Λ'.toAddSubgroup.relIndex (Submodule.span ℤ (Set.range ![ω₁, ω₂])).toAddSubgroup ≠ 0) :
    ∃ A : Matrix (Fin 2) (Fin 2) ℤ, Λ' = rowSpan ω₁ ω₂ A ∧
      Λ'.toAddSubgroup.relIndex (Submodule.span ℤ (Set.range ![ω₁, ω₂])).toAddSubgroup
        = A.det.natAbs := by
  obtain ⟨bN⟩ := nonempty_basis_of_relIndex ⟨latBasis hli⟩ h hn
  let A : Matrix (Fin 2) (Fin 2) ℤ := Matrix.of fun i j => (latBasis hli).repr ⟨bN i, h (bN i).2⟩ j
  have hA : ∀ i, (bN i : V) = rowVec ω₁ ω₂ A i := fun i =>
    coe_eq_repr (latBasis hli) (latBasis_zero hli) (latBasis_one hli) ⟨bN i, h (bN i).2⟩
  refine ⟨A, le_antisymm ?_ ?_, relIndex_eq_natAbs_det_rowVec h (latBasis hli) (latBasis_zero hli)
    (latBasis_one hli) bN A hA⟩
  · intro x hx
    have hx' : x = ∑ i, bN.repr ⟨x, hx⟩ i • (bN i : V) := by
      have := congrArg Subtype.val (bN.sum_repr ⟨x, hx⟩)
      simp only [Submodule.coe_sum, Submodule.coe_smul] at this
      exact this.symm
    rw [hx']
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
      (by rw [hA i]; exact Submodule.subset_span ⟨i, rfl⟩)
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    rw [← hA i]
    exact (bN i).2

theorem bijOn_rowSpan {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂]) {n : ℕ} (hn : 0 < n) :
    Set.BijOn (fun t : ℕ × ℕ × ℕ ↦ rowSpan ω₁ ω₂ (upperTri t.1 t.2.1 t.2.2)) (hermiteTriples n)
      (subOfIndex (Submodule.span ℤ (Set.range ![ω₁, ω₂])) n) := by
  have hnz : ((n : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
  refine ⟨?_, ?_, ?_⟩
  · intro t ht
    have hd := det_upperTri_of_mem ht
    refine ⟨rowSpan_le_lat _ _ _, ?_⟩
    rw [relIndex_rowSpan hli (by rw [hd]; exact hnz), hd]
    simp
  · intro t ht t' ht' h
    have hd := det_upperTri_of_mem ht
    have hd' := det_upperTri_of_mem ht'
    obtain ⟨U, hU⟩ := exists_unit_of_rowSpan_eq hli (A := upperTri t.1 t.2.1 t.2.2)
      (A' := upperTri t'.1 t'.2.1 t'.2.2) (by rw [hd]; exact hnz) (by rw [hd']; exact hnz) h
    exact herm_unique hn _ ht ht' 1 U (by simp) hU
  · intro Λ' hΛ'
    obtain ⟨hle, hidx⟩ := hΛ'
    obtain ⟨A, hA, hnat⟩ := exists_rowSpan_eq hli hle (by rw [hidx]; exact hn.ne')
    rw [hidx] at hnat
    let S : Matrix (Fin 2) (Fin 2) ℤ := !![0, 1; 1, 0]
    have hS : S * S = 1 := by
      ext i j
      fin_cases i <;> fin_cases j <;> simp [S]
    obtain ⟨A', hA'det, hA'span⟩ : ∃ A' : Matrix (Fin 2) (Fin 2) ℤ,
        A'.det = n ∧ rowSpan ω₁ ω₂ A' = rowSpan ω₁ ω₂ A := by
      rcases Int.natAbs_eq A.det with h | h
      · exact ⟨A, by omega, rfl⟩
      · refine ⟨S * A, ?_, ?_⟩
        · rw [Matrix.det_mul]
          have : S.det = -1 := by simp [S, Matrix.det_fin_two]
          rw [this]
          omega
        · exact rowSpan_unit ω₁ ω₂ (⟨S, S, hS, hS⟩ : GL (Fin 2) ℤ) A
    obtain ⟨t, ⟨ht, U, hU⟩, -⟩ := exists_unique_hermiteTriple hn A' hA'det
    refine ⟨t, ht, ?_⟩
    show rowSpan ω₁ ω₂ (upperTri t.1 t.2.1 t.2.2) = Λ'
    rw [← hU, rowSpan_unit, hA'span, hA]

theorem exists_lat {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) :
    ∃ ω₁ ω₂ : V, LinearIndependent ℤ ![ω₁, ω₂] ∧ Λ = Submodule.span ℤ (Set.range ![ω₁, ω₂]) := by
  obtain ⟨b⟩ := hΛ
  have hv : (![(b 0 : V), (b 1 : V)] : Fin 2 → V) = Λ.subtype ∘ b := by
    funext i
    fin_cases i <;> rfl
  refine ⟨b 0, b 1, ?_, ?_⟩
  · rw [hv]
    exact b.linearIndependent.map' Λ.subtype (Submodule.ker_subtype _)
  · rw [hv]
    refine le_antisymm ?_ ?_
    · intro x hx
      have hx' : x = ∑ i, b.repr ⟨x, hx⟩ i • ((b i : Λ) : V) := by
        have := congrArg Subtype.val (b.sum_repr ⟨x, hx⟩)
        simp only [Submodule.coe_sum, Submodule.coe_smul] at this
        exact this.symm
      rw [hx']
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _
        (Submodule.subset_span ⟨i, rfl⟩)
    · refine Submodule.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      exact (b i).2

theorem ncard_subOfIndex {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {n : ℕ}
    (hn : 0 < n) : (subOfIndex Λ n).ncard = (hermiteTriples n).card := by
  obtain ⟨ω₁, ω₂, hli, rfl⟩ := exists_lat hΛ
  have h := bijOn_rowSpan hli hn
  rw [← h.image_eq, h.injOn.ncard_image, Set.ncard_coe_finset]

end LatticeAux

open LatticeAux

/-- A subgroup with a basis of two elements has finitely many sublattices of index $n \ge 1$ ("the sum is
obviously finite because any such sublattice contains $n\Lambda$, and $\Lambda/n\Lambda$ is finite"). -/
@[kb "milne2017mf" "Section 5, finiteness of T(n)[Λ] (pdf p. 70)"]
theorem finite_subOfIndex {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {n : ℕ} (hn : 0 < n) :
    (subOfIndex Λ n).Finite := by
  obtain ⟨ω₁, ω₂, hli, rfl⟩ := exists_lat hΛ
  have h := bijOn_rowSpan hli hn
  rw [← h.image_eq]
  exact (hermiteTriples n).finite_toSet.image _

/-- **Milne, Remark 5.14**, lattice form. If $\omega_1, \omega_2$ are $\mathbb Z$-linearly independent, the sublattices
of index $n$ of $\Lambda = \mathbb Z\omega_1 + \mathbb Z\omega_2$ are exactly the lattices
$(a\omega_1 + b\omega_2, d\omega_2)$ with $ad = n$, $a \ge 1$, $0 \le b < d$, each exactly once. -/
@[kb "milne2017mf" "Section 5, Remark 5.14 (pdf p. 72)"]
theorem bijOn_hermiteTriples_subOfIndex {ω₁ ω₂ : V} (hli : LinearIndependent ℤ ![ω₁, ω₂]) {n : ℕ} (hn : 0 < n) :
    Set.BijOn (fun t : ℕ × ℕ × ℕ ↦ Submodule.span ℤ {(t.1 : ℤ) • ω₁ + (t.2.1 : ℤ) • ω₂, (t.2.2 : ℤ) • ω₂})
      (hermiteTriples n) (subOfIndex (Submodule.span ℤ {ω₁, ω₂}) n) := by
  have e : Submodule.span ℤ {ω₁, ω₂} = Submodule.span ℤ (Set.range ![ω₁, ω₂]) := by
    congr 1
    ext z
    simp [or_comm, eq_comm]
  rw [e]
  refine (bijOn_rowSpan hli hn).congr ?_
  intro t _
  exact rowSpan_upperTri ω₁ ω₂ _ _ _

/-- **Milne, Remark 5.14**: a lattice has exactly $p + 1$ sublattices of index $p$. -/
@[kb "milne2017mf" "Section 5, Remark 5.14 (pdf pp. 72-73)"]
theorem ncard_subOfIndex_prime {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ}
    (hp : p.Prime) : (subOfIndex Λ p).ncard = p + 1 := by
  rw [ncard_subOfIndex hΛ hp.pos, card_hermiteTriples_prime hp]

namespace LatticeAux

section Idx

variable {Λ Λ' Λ'' : Submodule ℤ V}

/-- Abbreviation for the relative index of submodules. -/
noncomputable abbrev lIdx (Λ' Λ : Submodule ℤ V) : ℕ := Λ'.toAddSubgroup.relIndex Λ.toAddSubgroup

theorem lIdx_mul (h₁ : Λ'' ≤ Λ') (h₂ : Λ' ≤ Λ) : lIdx Λ'' Λ = lIdx Λ'' Λ' * lIdx Λ' Λ :=
  (AddSubgroup.relIndex_mul_relIndex _ _ _ (fun _ hx => h₁ hx) (fun _ hx => h₂ hx)).symm

theorem nsmul_mem_of_lIdx {x : V} (hx : x ∈ Λ) : lIdx Λ' Λ • x ∈ Λ' :=
  AddSubgroup.nsmul_relIndex_mem Λ'.toAddSubgroup (K := Λ.toAddSubgroup) hx

theorem lIdx_eq_one (h : Λ' ≤ Λ) : lIdx Λ' Λ = 1 ↔ Λ' = Λ := by
  rw [lIdx, AddSubgroup.relIndex_eq_one]
  exact ⟨fun h' => le_antisymm h h', fun h' => h'.symm.le⟩

end Idx

/-- The finite set of sublattices of index `n` (empty if there are infinitely many). -/
noncomputable def subFin (Λ : Submodule ℤ V) (n : ℕ) : Finset (Submodule ℤ V) := by
  classical exact if h : (subOfIndex Λ n).Finite then h.toFinset else ∅

theorem mem_subFin {Λ : Submodule ℤ V} {n : ℕ} {X : Submodule ℤ V} :
    X ∈ subFin Λ n ↔ (subOfIndex Λ n).Finite ∧ X ∈ subOfIndex Λ n := by
  unfold subFin
  by_cases h : (subOfIndex Λ n).Finite <;> simp [h]

theorem mem_subFin_of_finite {Λ : Submodule ℤ V} {n : ℕ} (h : (subOfIndex Λ n).Finite)
    {X : Submodule ℤ V} : X ∈ subFin Λ n ↔ X ∈ subOfIndex Λ n := by
  simp [mem_subFin, h]

theorem latticeT_single_eq {Λ : Submodule ℤ V} {n : ℕ} (h : (subOfIndex Λ n).Finite) :
    latticeT n (single Λ 1) = ∑ X ∈ subFin Λ n, single X (1 : ℤ) := by
  rw [latticeT, Finsupp.linearCombination_single, one_smul, finsum_mem_eq_finite_toFinset_sum _ h]
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext X
  simp [mem_subFin_of_finite h]

theorem smul_eq_zero_of_mem {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {k : ℕ}
    (hk : k ≠ 0) {x : V} (hx : x ∈ Λ) (h : (k : ℤ) • x = 0) : x = 0 := by
  obtain ⟨b⟩ := hΛ
  have := Module.Free.of_basis b
  have h' : (k : ℤ) • (⟨x, hx⟩ : Λ) = 0 := Subtype.ext (by simpa using h)
  have := (smul_eq_zero.mp h').resolve_left (by exact_mod_cast hk)
  exact congrArg Subtype.val this

theorem scaleSub_toAddSubgroup (k : ℕ) (Z : Submodule ℤ V) :
    (scaleSub (k : ℤ) Z).toAddSubgroup = Z.toAddSubgroup.map (nsmulAddMonoidHom (α := V) k) := by
  ext x
  simp [scaleSub, AddSubgroup.mem_map, Submodule.mem_map]

theorem lIdx_scaleSub {Z : Submodule ℤ V} (hZ : Nonempty (Module.Basis (Fin 2) ℤ Z)) (k : ℕ) :
    lIdx (scaleSub (k : ℤ) Z) Z = k ^ 2 := by
  obtain ⟨b⟩ := hZ
  have : Module.Free ℤ ↥Z.toAddSubgroup.toIntSubmodule := Module.Free.of_basis b
  have : Module.Finite ℤ ↥Z.toAddSubgroup.toIntSubmodule := Module.Finite.of_basis b
  have h := AddSubgroup.relIndex_map_nsmul k Z.toAddSubgroup
  have h2 : Module.finrank ℤ Z.toAddSubgroup = 2 := finrank_eq_two b
  rw [h2, ← scaleSub_toAddSubgroup] at h
  exact h

theorem hasBasis_of_mem_subOfIndex {Λ Λ' : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ))
    {n : ℕ} (hn : 0 < n) (h : Λ' ∈ subOfIndex Λ n) : Nonempty (Module.Basis (Fin 2) ℤ Λ') :=
  nonempty_basis_of_relIndex hΛ h.1 (by rw [h.2]; exact hn.ne')

theorem card_subFin {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {k : ℕ}
    (hk : 0 < k) : (subFin Λ k).card = ArithmeticFunction.sigma 1 k := by
  have hf := finite_subOfIndex hΛ hk
  have : subFin Λ k = hf.toFinset := by
    ext X
    simp [mem_subFin_of_finite hf]
  rw [this, ← Set.ncard_eq_toFinset_card _ hf, ncard_subOfIndex hΛ hk, card_hermiteTriples]

section Coprime

variable {Λ Λ' Λ'' : Submodule ℤ V}

theorem eq_sup_scaleSub {m n : ℕ} (hmn : m.Coprime n) (h1 : Λ'' ≤ Λ') (h2 : Λ' ≤ Λ)
    (hn : lIdx Λ' Λ = n) (hm : lIdx Λ'' Λ' = m) : Λ' = Λ'' ⊔ scaleSub (n : ℤ) Λ := by
  apply le_antisymm
  · intro x hx
    obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.mpr hmn
    have hm' : (m : ℤ) • x ∈ Λ'' := by
      have := nsmul_mem_of_lIdx (Λ' := Λ'') (Λ := Λ') hx
      rw [hm] at this
      simpa using this
    have hn' : (n : ℤ) • x ∈ scaleSub (n : ℤ) Λ := ⟨x, h2 hx, by simp⟩
    have : x = u • ((m : ℤ) • x) + v • ((n : ℤ) • x) := by
      rw [smul_smul, smul_smul, ← add_smul, huv, one_smul]
    rw [this]
    exact add_mem (Submodule.mem_sup_left (Submodule.smul_mem _ _ hm'))
      (Submodule.mem_sup_right (Submodule.smul_mem _ _ hn'))
  · refine sup_le h1 ?_
    rintro _ ⟨y, hy, rfl⟩
    have := nsmul_mem_of_lIdx (Λ' := Λ') (Λ := Λ) hy
    rw [hn] at this
    simpa using this

end Coprime

end LatticeAux

/-- **Milne, Proposition 5.9(a).** If $m, n \ge 1$ are coprime then $T(m) \circ T(n) = T(mn)$ (on the generator
$[\Lambda]$ of a lattice $\Lambda$; by linearity on all of $D$). -/
@[kb "milne2017mf" "Section 5, Proposition 5.9(a) (pdf p. 70)"]
theorem latticeT_mul_of_coprime {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {m n : ℕ}
    (hm : 0 < m) (hn : 0 < n) (hmn : m.Coprime n) :
    latticeT m (latticeT n (single Λ 1)) = latticeT (m * n) (single Λ 1) := by
  have hmn0 : 0 < m * n := Nat.mul_pos hm hn
  have hfn := finite_subOfIndex hΛ hn
  rw [latticeT_single_eq hfn, map_sum]
  have hterm : ∀ Λ' ∈ subFin Λ n, latticeT m (single Λ' 1) = ∑ X ∈ subFin Λ' m, single X (1 : ℤ) := by
    intro Λ' hΛ'
    rw [mem_subFin_of_finite hfn] at hΛ'
    exact latticeT_single_eq (finite_subOfIndex (hasBasis_of_mem_subOfIndex hΛ hn hΛ') hm)
  rw [Finset.sum_congr rfl hterm, latticeT_single_eq (finite_subOfIndex hΛ hmn0)]
  have hdisj : (↑(subFin Λ n) : Set (Submodule ℤ V)).PairwiseDisjoint (fun Λ' => subFin Λ' m) := by
    intro Λ₁ h1 Λ₂ h2 hne
    refine Finset.disjoint_left.2 fun X hX1 hX2 => hne ?_
    have a1 := (mem_subFin.1 (Finset.mem_coe.1 h1)).2
    have a2 := (mem_subFin.1 (Finset.mem_coe.1 h2)).2
    have b1 := (mem_subFin.1 hX1).2
    have b2 := (mem_subFin.1 hX2).2
    rw [eq_sup_scaleSub hmn b1.1 a1.1 a1.2 b1.2, eq_sup_scaleSub hmn b2.1 a2.1 a2.2 b2.2]
  rw [← Finset.sum_biUnion hdisj]
  congr 1
  apply Finset.eq_of_subset_of_card_le
  · intro X hX
    obtain ⟨Λ', hΛ', hX'⟩ := Finset.mem_biUnion.1 hX
    have a1 := (mem_subFin.1 hΛ').2
    have b1 := (mem_subFin.1 hX').2
    refine mem_subFin.2 ⟨finite_subOfIndex hΛ hmn0, b1.1.trans a1.1, ?_⟩
    show lIdx X Λ = m * n
    have e1 : lIdx Λ' Λ = n := a1.2
    have e2 : lIdx X Λ' = m := b1.2
    rw [lIdx_mul b1.1 a1.1, e1, e2]
  · rw [Finset.card_biUnion hdisj, card_subFin hΛ hmn0,
      ArithmeticFunction.isMultiplicative_sigma.map_mul_of_coprime hmn]
    have : ∀ Λ' ∈ subFin Λ n, (subFin Λ' m).card = ArithmeticFunction.sigma 1 m := fun Λ' hΛ' =>
      card_subFin (hasBasis_of_mem_subOfIndex hΛ hn ((mem_subFin.1 hΛ').2)) hm
    rw [Finset.sum_congr rfl this, Finset.sum_const, card_subFin hΛ hn, smul_eq_mul, mul_comm]

namespace LatticeAux

section PrimePow

variable {Λ Λ' Y Z Z' : Submodule ℤ V}

theorem mem_subFin_iff (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {n : ℕ} (hn : 0 < n)
    {X : Submodule ℤ V} : X ∈ subFin Λ n ↔ X ≤ Λ ∧ lIdx X Λ = n := by
  rw [mem_subFin_of_finite (finite_subOfIndex hΛ hn)]
  rfl

theorem card_subFin_prime (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) :
    (subFin Λ p).card = p + 1 := by
  rw [card_subFin hΛ hp.pos, ← card_hermiteTriples, card_hermiteTriples_prime hp]

theorem mem_scaleSub {c : ℤ} {x : V} : x ∈ scaleSub c Λ ↔ ∃ y ∈ Λ, c • y = x := by
  simp [scaleSub, Submodule.mem_map]

theorem scaleSub_le_self (c : ℤ) : scaleSub c Λ ≤ Λ := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := mem_scaleSub.1 hx
  exact Λ.smul_mem c hy

theorem scaleSub_mono (c : ℤ) (h : Z ≤ Z') : scaleSub c Z ≤ scaleSub c Z' :=
  Submodule.map_mono h

theorem le_of_scaleSub_le (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p ≠ 0)
    (hZ : Z ≤ Λ) (hZ' : Z' ≤ Λ) (h : scaleSub (p : ℤ) Z ≤ scaleSub (p : ℤ) Z') : Z ≤ Z' := by
  intro x hx
  obtain ⟨x', hx', hxx⟩ := mem_scaleSub.1 (h (mem_scaleSub.2 ⟨x, hx, rfl⟩))
  have : x' = x := by
    have := smul_eq_zero_of_mem hΛ hp (x := x' - x) (sub_mem (hZ' hx') (hZ hx))
      (by rw [smul_sub, hxx, sub_self])
    exact sub_eq_zero.1 this
  rw [← this]
  exact hx'

theorem scaleSub_injOn (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p ≠ 0)
    (hZ : Z ≤ Λ) (hZ' : Z' ≤ Λ) (h : scaleSub (p : ℤ) Z = scaleSub (p : ℤ) Z') : Z = Z' :=
  le_antisymm (le_of_scaleSub_le hΛ hp hZ hZ' h.le) (le_of_scaleSub_le hΛ hp hZ' hZ h.ge)

/-- Nakayama-type argument for a `p`-power index. -/
theorem le_of_le_sup_scaleSub {p : ℕ} (hK : Λ ≤ Y ⊔ scaleSub (p : ℤ) Λ) (j : ℕ)
    (hj : ∀ x ∈ Λ, p ^ j • x ∈ Y) : Λ ≤ Y := by
  induction j with
  | zero =>
    intro x hx
    simpa using hj x hx
  | succ j ih =>
    refine ih fun x hx => ?_
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 (hK hx)
    obtain ⟨w, hw, rfl⟩ := mem_scaleSub.1 hz
    have h1 : p ^ j • y ∈ Y := Y.smul_of_tower_mem _ hy
    have h2 : p ^ j • ((p : ℤ) • w) ∈ Y := by
      have := hj w hw
      rw [pow_succ, mul_smul] at this
      rwa [natCast_zsmul]
    rw [smul_add]
    exact add_mem h1 h2

theorem lIdx_sup_scaleSub (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) {k : ℕ}
    (hY : Y ≤ Λ) (hidx : lIdx Y Λ = p ^ (k + 2)) (hnot : ¬ Y ≤ scaleSub (p : ℤ) Λ) :
    lIdx (Y ⊔ scaleSub (p : ℤ) Λ) Λ = p := by
  have hKΛ : Y ⊔ scaleSub (p : ℤ) Λ ≤ Λ := sup_le hY (scaleSub_le_self _)
  have hPK : scaleSub (p : ℤ) Λ ≤ Y ⊔ scaleSub (p : ℤ) Λ := le_sup_right
  have hP : lIdx (scaleSub (p : ℤ) Λ) Λ = p ^ 2 := lIdx_scaleSub hΛ p
  have hmul := lIdx_mul hPK hKΛ
  rw [hP] at hmul
  have hdvd : lIdx (Y ⊔ scaleSub (p : ℤ) Λ) Λ ∣ p ^ 2 := Dvd.intro_left _ hmul.symm
  obtain ⟨i, hi, ha⟩ := (Nat.dvd_prime_pow hp).1 hdvd
  have hp2 := hp.two_le
  have hp0 : 0 < p ^ 2 := by positivity
  interval_cases i
  · exfalso
    have hK : Y ⊔ scaleSub (p : ℤ) Λ = Λ := (lIdx_eq_one hKΛ).1 (by simpa using ha)
    have hle : Λ ≤ Y := le_of_le_sup_scaleSub hK.ge (k + 2) fun x hx => by
      have := nsmul_mem_of_lIdx (Λ' := Y) hx
      rwa [hidx] at this
    have hYΛ : Y = Λ := le_antisymm hY hle
    have h1 : lIdx Y Λ = 1 := (lIdx_eq_one hY).2 hYΛ
    have : 1 < p ^ (k + 2) := Nat.one_lt_pow (by omega) hp.one_lt
    omega
  · simpa using ha
  · exfalso
    rw [ha] at hmul
    have h1 : lIdx (scaleSub (p : ℤ) Λ) (Y ⊔ scaleSub (p : ℤ) Λ) = 1 := by
      have : lIdx (scaleSub (p : ℤ) Λ) (Y ⊔ scaleSub (p : ℤ) Λ) * p ^ 2 = 1 * p ^ 2 := by
        rw [one_mul]; exact hmul.symm
      exact Nat.eq_of_mul_eq_mul_right hp0 this
    have := (lIdx_eq_one hPK).1 h1
    exact hnot (this ▸ le_sup_left)

theorem mem_inner_iff (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) (k : ℕ)
    (hidx : lIdx Y Λ = p ^ (k + 2)) {Λ' : Submodule ℤ V} (hΛ' : Λ' ∈ subFin Λ p) :
    Y ∈ subFin Λ' (p ^ (k + 1)) ↔ Y ≤ Λ' := by
  have hmem := (mem_subFin_iff hΛ hp.pos).1 hΛ'
  have hb := nonempty_basis_of_relIndex hΛ hmem.1 (fun h => hp.ne_zero (hmem.2.symm.trans h))
  rw [mem_subFin_iff hb (by have := hp.pos; positivity)]
  constructor
  · exact fun h => h.1
  · intro h
    refine ⟨h, ?_⟩
    have h1 := lIdx_mul h hmem.1
    have e : p ^ (k + 2) = p ^ (k + 1) * p := by ring
    rw [hidx, hmem.2, e] at h1
    exact (Nat.eq_of_mul_eq_mul_right hp.pos h1).symm

open scoped Classical in
theorem card_filter_of_le (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) (k : ℕ)
    (hidx : lIdx Y Λ = p ^ (k + 2)) (hYP : Y ≤ scaleSub (p : ℤ) Λ) :
    ((subFin Λ p).filter (fun Λ' => Y ∈ subFin Λ' (p ^ (k + 1)))).card = p + 1 := by
  rw [Finset.filter_true_of_mem, card_subFin_prime hΛ hp]
  intro Λ' hΛ'
  rw [mem_inner_iff hΛ hp k hidx hΛ']
  refine hYP.trans ?_
  intro x hx
  obtain ⟨y, hy, rfl⟩ := mem_scaleSub.1 hx
  have := nsmul_mem_of_lIdx (Λ' := Λ') hy
  rw [((mem_subFin_iff hΛ hp.pos).1 hΛ').2] at this
  simpa using this

open scoped Classical in
theorem card_filter_of_not_le (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) (k : ℕ)
    (hY : Y ≤ Λ) (hidx : lIdx Y Λ = p ^ (k + 2)) (hnot : ¬ Y ≤ scaleSub (p : ℤ) Λ) :
    ((subFin Λ p).filter (fun Λ' => Y ∈ subFin Λ' (p ^ (k + 1)))).card = 1 := by
  rw [Finset.card_eq_one]
  refine ⟨Y ⊔ scaleSub (p : ℤ) Λ, ?_⟩
  have hK := lIdx_sup_scaleSub hΛ hp hY hidx hnot
  have hKΛ : Y ⊔ scaleSub (p : ℤ) Λ ≤ Λ := sup_le hY (scaleSub_le_self _)
  have hKmem : Y ⊔ scaleSub (p : ℤ) Λ ∈ subFin Λ p := (mem_subFin_iff hΛ hp.pos).2 ⟨hKΛ, hK⟩
  ext Λ'
  simp only [Finset.mem_filter, Finset.mem_singleton]
  constructor
  · rintro ⟨hΛ', hYin⟩
    have hmem := (mem_subFin_iff hΛ hp.pos).1 hΛ'
    have hYΛ' := (mem_inner_iff hΛ hp k hidx hΛ').1 hYin
    have hKΛ' : Y ⊔ scaleSub (p : ℤ) Λ ≤ Λ' := by
      refine sup_le hYΛ' ?_
      intro x hx
      obtain ⟨y, hy, rfl⟩ := mem_scaleSub.1 hx
      have := nsmul_mem_of_lIdx (Λ' := Λ') hy
      rw [hmem.2] at this
      simpa using this
    have h1 := lIdx_mul hKΛ' hmem.1
    rw [hK, hmem.2] at h1
    have h2 : lIdx (Y ⊔ scaleSub (p : ℤ) Λ) Λ' = 1 :=
      Nat.eq_of_mul_eq_mul_right hp.pos (by rw [one_mul]; exact h1.symm)
    exact ((lIdx_eq_one hKΛ').1 h2).symm
  · intro h
    rw [h]
    exact ⟨hKmem, (mem_inner_iff hΛ hp k hidx hKmem).2 le_sup_left⟩

theorem scaleSub_prop_of_mem (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime)
    {k : ℕ} (hZ : Z ∈ subFin Λ (p ^ k)) :
    scaleSub (p : ℤ) Z ≤ Λ ∧ lIdx (scaleSub (p : ℤ) Z) Λ = p ^ (k + 2) := by
  have hk : 0 < p ^ k := pow_pos hp.pos k
  have hz := (mem_subFin_iff hΛ hk).1 hZ
  have hb := nonempty_basis_of_relIndex hΛ hz.1 (fun h => hk.ne' (hz.2.symm.trans h))
  refine ⟨(scaleSub_le_self _).trans hz.1, ?_⟩
  rw [lIdx_mul (scaleSub_le_self (Λ := Z) (p : ℤ)) hz.1, lIdx_scaleSub hb p, hz.2]
  ring

open scoped Classical in
theorem card_filter_scaleSub (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) (k : ℕ)
    (hidx : lIdx Y Λ = p ^ (k + 2)) (hYP : Y ≤ scaleSub (p : ℤ) Λ) :
    ((subFin Λ (p ^ k)).filter (fun Z => scaleSub (p : ℤ) Z = Y)).card = 1 := by
  obtain ⟨Z, hmemZ⟩ : ∃ Z : Submodule ℤ V, ∀ x, x ∈ Z ↔ (p : ℤ) • x ∈ Y ∧ x ∈ Λ :=
    ⟨Submodule.comap ((p : ℤ) • (LinearMap.id : V →ₗ[ℤ] V)) Y ⊓ Λ, by
      intro x; simp [Submodule.mem_inf, Submodule.mem_comap]⟩
  have hZΛ : Z ≤ Λ := fun x hx => ((hmemZ x).1 hx).2
  have hsZ : scaleSub (p : ℤ) Z = Y := by
    apply le_antisymm
    · intro x hx
      obtain ⟨z, hz, rfl⟩ := mem_scaleSub.1 hx
      exact ((hmemZ z).1 hz).1
    · intro y hy
      obtain ⟨w, hw, rfl⟩ := mem_scaleSub.1 (hYP hy)
      exact mem_scaleSub.2 ⟨w, (hmemZ w).2 ⟨hy, hw⟩, rfl⟩
  have hbig : scaleSub ((p ^ (k + 1) : ℕ) : ℤ) Λ ≤ Z := by
    intro z hz
    obtain ⟨w, hw, rfl⟩ := mem_scaleSub.1 hz
    refine (hmemZ _).2 ⟨?_, Λ.smul_mem _ hw⟩
    have := nsmul_mem_of_lIdx (Λ' := Y) hw
    rw [hidx] at this
    convert this using 1
    rw [natCast_zsmul, natCast_zsmul, ← mul_smul]
    congr 1
    ring
  have h1 : lIdx (scaleSub ((p ^ (k + 1) : ℕ) : ℤ) Λ) Λ = (p ^ (k + 1)) ^ 2 := lIdx_scaleSub hΛ _
  have h2 : lIdx Z Λ ∣ lIdx (scaleSub ((p ^ (k + 1) : ℕ) : ℤ) Λ) Λ :=
    AddSubgroup.relIndex_dvd_of_le_left Λ.toAddSubgroup (fun _ hx => hbig hx)
  have hne : lIdx Z Λ ≠ 0 := by
    intro h0
    rw [h0, zero_dvd_iff, h1] at h2
    exact pow_ne_zero 2 (pow_ne_zero _ hp.ne_zero) h2
  have hZb := nonempty_basis_of_relIndex hΛ hZΛ hne
  have hYZ : Y ≤ Z := hsZ ▸ scaleSub_le_self _
  have hmul := lIdx_mul hYZ hZΛ
  have hK := lIdx_scaleSub hZb p
  rw [hsZ] at hK
  rw [hidx, hK] at hmul
  have hp2 : 0 < p ^ 2 := pow_pos hp.pos 2
  have hZidx : lIdx Z Λ = p ^ k :=
    Nat.eq_of_mul_eq_mul_left hp2 (by rw [← hmul]; ring)
  have hk : 0 < p ^ k := pow_pos hp.pos k
  rw [Finset.card_eq_one]
  refine ⟨Z, ?_⟩
  ext Z'
  simp only [Finset.mem_filter, Finset.mem_singleton]
  constructor
  · rintro ⟨hZ'mem, hZ'⟩
    have hz' := (mem_subFin_iff hΛ hk).1 hZ'mem
    exact scaleSub_injOn hΛ hp.ne_zero hz'.1 hZΛ (hZ'.trans hsZ.symm)
  · intro h
    rw [h]
    exact ⟨(mem_subFin_iff hΛ hk).2 ⟨hZΛ, hZidx⟩, hsZ⟩

open scoped Classical in
theorem count_b (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ} (hp : p.Prime) (k : ℕ)
    (Y : Submodule ℤ V) :
    ((subFin Λ p).filter (fun Λ' => Y ∈ subFin Λ' (p ^ (k + 1)))).card =
      (if Y ∈ subFin Λ (p ^ (k + 2)) then 1 else 0) +
        p * ((subFin Λ (p ^ k)).filter (fun Z => scaleSub (p : ℤ) Z = Y)).card := by
  have hk2 : 0 < p ^ (k + 2) := pow_pos hp.pos _
  have hk0 : 0 < p ^ k := pow_pos hp.pos _
  by_cases hY : Y ∈ subFin Λ (p ^ (k + 2))
  · obtain ⟨hYΛ, hidx⟩ := (mem_subFin_iff hΛ hk2).1 hY
    simp only [hY, ↓reduceIte]
    by_cases hYP : Y ≤ scaleSub (p : ℤ) Λ
    · rw [card_filter_of_le hΛ hp k hidx hYP, card_filter_scaleSub hΛ hp k hidx hYP]
      ring
    · rw [card_filter_of_not_le hΛ hp k hYΛ hidx hYP]
      have : (subFin Λ (p ^ k)).filter (fun Z => scaleSub (p : ℤ) Z = Y) = ∅ := by
        refine Finset.filter_eq_empty_iff.2 fun Z hZ hZY => hYP ?_
        rw [← hZY]
        exact scaleSub_mono _ ((mem_subFin_iff hΛ hk0).1 hZ).1
      rw [this]
      simp
  · simp only [hY, ↓reduceIte]
    have h1 : (subFin Λ p).filter (fun Λ' => Y ∈ subFin Λ' (p ^ (k + 1))) = ∅ := by
      refine Finset.filter_eq_empty_iff.2 fun Λ' hΛ' hYin => hY ?_
      have hmem := (mem_subFin_iff hΛ hp.pos).1 hΛ'
      have hb := nonempty_basis_of_relIndex hΛ hmem.1 (fun h => hp.ne_zero (hmem.2.symm.trans h))
      have hy := (mem_subFin_iff hb (pow_pos hp.pos _)).1 hYin
      refine (mem_subFin_iff hΛ hk2).2 ⟨hy.1.trans hmem.1, ?_⟩
      rw [lIdx_mul hy.1 hmem.1, hy.2, hmem.2]
      ring
    have h2 : (subFin Λ (p ^ k)).filter (fun Z => scaleSub (p : ℤ) Z = Y) = ∅ := by
      refine Finset.filter_eq_empty_iff.2 fun Z hZ hZY => hY ?_
      have := scaleSub_prop_of_mem hΛ hp hZ
      rw [hZY] at this
      exact (mem_subFin_iff hΛ hk2).2 this
    rw [h1, h2]
    simp

end PrimePow

end LatticeAux

/-- **Milne, Proposition 5.9(b).** If $p$ is prime and $n \ge 1$ then
$T(p^n) \circ T(p) = T(p^{n+1}) + pR(p) \circ T(p^{n-1})$ (on the generator $[\Lambda]$ of a lattice). -/
@[kb "milne2017mf" "Section 5, Proposition 5.9(b) (pdf p. 70)"]
theorem latticeT_prime_pow_mul_prime {Λ : Submodule ℤ V} (hΛ : Nonempty (Module.Basis (Fin 2) ℤ Λ)) {p : ℕ}
    (hp : p.Prime) {n : ℕ} (hn : 1 ≤ n) :
    latticeT (p ^ n) (latticeT p (single Λ 1)) =
      latticeT (p ^ (n + 1)) (single Λ 1) + (p : ℤ) • latticeR p (latticeT (p ^ (n - 1)) (single Λ 1)) := by
  classical
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  have hk1 : 0 < p ^ (k + 1) := pow_pos hp.pos _
  have hk2 : 0 < p ^ (k + 1 + 1) := pow_pos hp.pos _
  have hk0 : 0 < p ^ k := pow_pos hp.pos _
  have hfp := finite_subOfIndex hΛ hp.pos
  rw [latticeT_single_eq hfp, map_sum]
  have hterm : ∀ Λ' ∈ subFin Λ p, latticeT (p ^ (k + 1)) (single Λ' 1) =
      ∑ X ∈ subFin Λ' (p ^ (k + 1)), single X (1 : ℤ) := by
    intro Λ' hΛ'
    rw [mem_subFin_of_finite hfp] at hΛ'
    exact latticeT_single_eq (finite_subOfIndex (hasBasis_of_mem_subOfIndex hΛ hp.pos hΛ') hk1)
  rw [Finset.sum_congr rfl hterm, latticeT_single_eq (finite_subOfIndex hΛ hk2),
    latticeT_single_eq (finite_subOfIndex hΛ hk0)]
  have hR : latticeR p (∑ Z ∈ subFin Λ (p ^ k), single Z (1 : ℤ)) =
      ∑ Z ∈ subFin Λ (p ^ k), single (scaleSub (p : ℤ) Z) (1 : ℤ) := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun Z _ => ?_
    simp [latticeR]
  rw [hR]
  ext Y
  simp only [Finsupp.add_apply, Finsupp.smul_apply, Finset.sum_apply',
    Finsupp.single_apply, Finset.sum_ite_eq', smul_eq_mul]
  have := count_b hΛ hp k Y
  rw [Finset.sum_boole, Finset.sum_boole, show k + 1 + 1 = k + 2 from rfl]
  by_cases hY : Y ∈ subFin Λ (p ^ (k + 2)) <;> simp only [hY, ↓reduceIte] at this ⊢ <;>
    exact_mod_cast this

end General

