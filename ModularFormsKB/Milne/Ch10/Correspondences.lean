import ModularFormsKB.Milne.Ch7.Curves
import Mathlib.AlgebraicGeometry.AlgebraicCycle.Basic
import Mathlib.AlgebraicGeometry.OrderOfVanishing
import Mathlib.AlgebraicGeometry.Morphisms.Finite
import Mathlib.RingTheory.RamificationInertia.Ramification
import Mathlib.FieldTheory.PurelyInseparable.Basic
import TauCeti.AlgebraicGeometry.Frobenius.Twist

/-!
# Milne, Chapter 10: correspondences on curves, the Frobenius map (D108, D109, D111, D112, Proposition 10.2)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 10, pdf pp. 105–107.

Curves are those of Chapter 7 (`ModularFormsKB.Milne.Ch7.Varieties`), as integral schemes over $\operatorname{Spec}
k$. On a regular curve the points of $\operatorname{specm}$ are the points of coheight $1$, so Milne's divisor group
$\operatorname{Div}(X)$ is Mathlib's group of Weil divisors `AlgebraicCycle.weilDivisors X ℤ`, the order of a rational
function at a point is Mathlib's `Scheme.ord`, and pushforward of divisors is Mathlib's `AlgebraicCycle.map`.

## Items

- **Correspondences** (pdf p. 105): `SchemeCorrespondence` (a pair of finite surjective morphisms $X \leftarrow Y \to X'$),
  the transpose (`SchemeCorrespondence.transpose`) and the correspondence of a morphism (its graph,
  `SchemeCorrespondence.ofHom`, in the equivalent form $X \xleftarrow{\ \mathrm{id}\ } X \xrightarrow{\ \alpha\ } X'$).
- The action on divisors $P \mapsto \sum \beta(Q_i)$, $Q_i$ running through $\alpha^{-1}(P)$ with multiplicities
  (`SchemeCorrespondence.IsImage`), the group $J(X) = \operatorname{Div}^0(X)/\{\text{principal divisors}\}$ (`jacobianGroup`),
  and the **ring of correspondences** $A(X)$ (D108, `ringOfCorrespondences`): the subring of $\operatorname{End}(J(X))$
  generated by the maps defined by correspondences. Milne's claims that a correspondence multiplies degrees by
  $\deg\alpha$ and maps principal divisors to principal divisors are not formalized; the definition of $A(X)$ only
  uses endomorphisms that are induced by correspondences.
- **Degree of a morphism of curves** (D111, `morphismDegree`); **separable** and **purely inseparable** morphisms (D112,
  `IsSeparableMorphism`, `IsPurelyInseparableMorphism`).
- **The curve $C^{(q)}$ and the Frobenius map** $\Pi_q : C \to C^{(q)}$ (D109, `frobeniusTwist`, `frobeniusMap`): Tau
  Ceti's iterated Frobenius twist $C \times_{k, F^n} k$ and iterated relative Frobenius, $q = p^n$. For $C$ defined by
  equations $\sum c_{i_0 i_1 \cdots} X_0^{i_0} X_1^{i_1} \cdots = 0$, the base change along $c \mapsto c^q$ is defined
  by the equations with coefficients $c^q$, and the relative Frobenius raises coordinates to the $q$-th power.
- **Proposition 10.2** (named statement): `FrobeniusFactorization`.

Aside 10.1 (Jacobian varieties) is an aside. **Theorem 10.3** (Eichler–Shimura) is not formalized: stating it needs the
reduction modulo $p$ of the canonical model $X_0(N)_{\mathbb Q}$ and of the Hecke correspondence, and Milne's
description of $T_p$ by quotients $E/S_i$ of elliptic curves by subgroups of order $p$; none of these (models over
$\mathbb Z_{(p)}$, quotients of elliptic curves by finite subgroups) is available in Mathlib or Tau Ceti.
-/

universe u

open AlgebraicGeometry CategoryTheory

noncomputable section

namespace ModularFormsKB.Milne

/-! ### Degree, separable and purely inseparable morphisms -/

section Degree

variable {X Y : Scheme.{u}} [IsIntegral X] [IsIntegral Y] (φ : X ⟶ Y) [IsDominant φ]

/-- The function field $k(X)$ as an algebra over $k(Y)$ through $\varphi^*$. -/
@[instance_reducible]
def functionFieldAlgebra : Algebra Y.functionField X.functionField :=
  (functionFieldMap φ).hom.toAlgebra

/-- **Degree of a morphism of curves** (Milne, Section 10, pdf p. 106; D111): a nonconstant morphism
$\alpha : C \to C'$ has degree $[k(C) : \alpha^* k(C')]$ (`0` if the extension is infinite). -/
@[kb "milne2017mf" "Section 10, degree of a morphism of curves (pdf p. 106)"]
def morphismDegree : ℕ :=
  letI := functionFieldAlgebra φ
  Module.finrank Y.functionField X.functionField

/-- **Separable morphism** (Milne, Section 10, pdf p. 106; D112): $k(C)$ is a separable extension of
$\alpha^* k(C')$. -/
@[kb "milne2017mf" "Section 10, separable morphism of curves (pdf p. 106)"]
def IsSeparableMorphism : Prop :=
  letI := functionFieldAlgebra φ
  Algebra.IsSeparable Y.functionField X.functionField

/-- **Purely inseparable morphism** (Milne, Section 10, pdf p. 106; D112): $k(C)$ is a purely inseparable extension
of $\alpha^* k(C')$. -/
@[kb "milne2017mf" "Section 10, purely inseparable morphism of curves (pdf p. 106)"]
def IsPurelyInseparableMorphism : Prop :=
  letI := functionFieldAlgebra φ
  IsPurelyInseparable Y.functionField X.functionField

end Degree

/-! ### Correspondences and the ring of correspondences -/

/-- **A correspondence** between $X$ and $X'$ (Milne, Section 10, pdf p. 105): a pair of finite surjective morphisms
$X \xleftarrow{\alpha} Y \xrightarrow{\beta} X'$. -/
@[kb "milne2017mf" "Section 10, correspondence between curves (pdf p. 105)"]
structure SchemeCorrespondence (X X' : Scheme.{u}) where
  /-- The middle curve. -/
  Y : Scheme.{u}
  /-- The first projection. -/
  α : Y ⟶ X
  /-- The second projection. -/
  β : Y ⟶ X'
  finite_α : IsFinite α
  surjective_α : Surjective α
  finite_β : IsFinite β
  surjective_β : Surjective β

namespace SchemeCorrespondence

variable {X X' : Scheme.{u}}

/-- **The transpose** $T'$ of a correspondence $T$ (Milne, Section 10, pdf p. 105): exchange the two maps. -/
@[kb "milne2017mf" "Section 10, transpose of a correspondence (pdf p. 105)"]
def transpose (T : SchemeCorrespondence X X') : SchemeCorrespondence X' X where
  Y := T.Y
  α := T.β
  β := T.α
  finite_α := T.finite_β
  surjective_α := T.surjective_β
  finite_β := T.finite_α
  surjective_β := T.surjective_α

/-- **The correspondence of a morphism** (Milne, Section 10, pdf p. 105): $\alpha : X \to X'$ as the correspondence
$X \leftarrow \Gamma_\alpha \to X'$. The graph projects isomorphically onto $X$, so we use $X$ itself with the identity
and $\alpha$. -/
@[kb "milne2017mf" "Section 10, the correspondence defined by a morphism (pdf p. 105)"]
def ofHom (φ : X ⟶ X') [IsFinite φ] [Surjective φ] : SchemeCorrespondence X X' where
  Y := X
  α := 𝟙 X
  β := φ
  finite_α := inferInstance
  surjective_α := inferInstance
  finite_β := inferInstance
  surjective_β := inferInstance

/-- The multiplicity $e_Q$ of a point $Q$ in the fibre $\alpha^{-1}(\alpha(Q))$: the ramification index of the local
ring map $\mathcal O_{X, \alpha(Q)} \to \mathcal O_{Y, Q}$. -/
def multiplicity {Y X : Scheme.{u}} (α : Y ⟶ X) (Q : Y) : ℕ :=
  letI := (α.stalkMap Q).hom.toAlgebra
  Ideal.ramificationIdx (IsLocalRing.maximalIdeal (Y.presheaf.stalk Q)) (X.presheaf.stalk (α Q))

/-- **The action of a correspondence on divisors** (Milne, Section 10, pdf p. 105): $T$ maps $D \in \operatorname{Div}(X)$
to $\beta_*(\alpha^* D)$, where $\alpha^* P = \sum_{\alpha(Q) = P} e_Q\,Q$; `IsImage T D D'` says that $D'$ is the image
of $D$. -/
@[kb "milne2017mf" "Section 10, the map Div(X) → Div(X') defined by a correspondence (pdf p. 105)"]
def IsImage (T : SchemeCorrespondence X X') [QuasiCompact T.β]
    (D : AlgebraicCycle X ℤ) (D' : AlgebraicCycle X' ℤ) : Prop :=
  ∃ E : AlgebraicCycle T.Y ℤ, (∀ Q : T.Y, E Q = multiplicity T.α Q * D (T.α Q)) ∧
    AlgebraicCycle.map T.β Order.coheight Order.coheight E = D'

end SchemeCorrespondence

section Jacobian

variable {k : Type u} [Field k] {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] [CompactSpace X]
  (f : X ⟶ Spec (CommRingCat.of k))

/-- The divisors of degree zero, $\operatorname{Div}^0(X)$. -/
def divisorsDegreeZero : AddSubgroup (AlgebraicCycle X ℤ) :=
  AlgebraicCycle.weilDivisors X ℤ ⊓ (AlgebraicCycle.degree f).ker

/-- The principal divisors $\operatorname{div}(g) = \sum_P \operatorname{ord}_P(g)\,P$, $g \in k(X)^\times$. -/
def principalDivisors : AddSubgroup (AlgebraicCycle X ℤ) :=
  AddSubgroup.closure {D | ∃ g : X.functionField, g ≠ 0 ∧ ∀ z : X,
    (Order.coheight z = 1 → D z = Scheme.ord g z) ∧ (Order.coheight z ≠ 1 → D z = 0)}

/-- **The group** $J(X) = \operatorname{Div}^0(X)/\{\text{principal divisors}\}$ (Milne, Section 10, pdf p. 105). -/
@[kb "milne2017mf" "Section 10, J(X) = Div⁰(X)/principal divisors (pdf p. 105)"]
abbrev jacobianGroup : Type u :=
  divisorsDegreeZero f ⧸ (principalDivisors (X := X)).addSubgroupOf (divisorsDegreeZero f)

/-- An endomorphism of $J(X)$ is **defined by** a correspondence $T$ on $X$ if it sends the class of every
$D \in \operatorname{Div}^0(X)$ to the class of its image under $T$. -/
def IsDefinedByCorrespondence (φ : AddMonoid.End (jacobianGroup f)) : Prop :=
  ∃ (T : SchemeCorrespondence X X) (_ : QuasiCompact T.β), ∀ (D : divisorsDegreeZero f) (D' : divisorsDegreeZero f),
    T.IsImage D.1 D'.1 → φ (QuotientAddGroup.mk D) = QuotientAddGroup.mk D'

/-- **The ring of correspondences** $A(X)$ (Milne, Section 10, pdf p. 105; D108): the subring of
$\operatorname{End}(J(X))$ generated by the maps defined by correspondences. -/
@[kb "milne2017mf" "Section 10, ring of correspondences A(X) (pdf p. 105)"]
def ringOfCorrespondences : Subring (AddMonoid.End (jacobianGroup f)) :=
  Subring.closure {φ | IsDefinedByCorrespondence f φ}

end Jacobian

/-! ### The Frobenius map -/

section Frobenius

variable (k : Type u) [Field k] (p : ℕ) [Fact p.Prime]
  (hk : (p : Γ(Spec (CommRingCat.of k), ⊤)) = 0) {C : Scheme.{u}} (f : C ⟶ Spec (CommRingCat.of k))

/-- **The curve $C^{(q)}$**, $q = p^n$ (Milne, Section 10, pdf p. 106; D109): the base change of $C$ along the
$n$-th power of the Frobenius of $k$, i.e. the curve whose equations have the coefficients raised to the $q$-th power
(Tau Ceti's iterated Frobenius twist). -/
@[kb "milne2017mf" "Section 10, the curve C^(q) (pdf p. 106)"]
abbrev frobeniusTwist (n : ℕ) : Scheme.{u} :=
  Limits.pullback f ((Spec (CommRingCat.of k)).iterateFrobenius p hk n)

/-- The structure morphism of $C^{(q)}$ over $k$. -/
abbrev frobeniusTwistStructure (n : ℕ) : frobeniusTwist k p hk f n ⟶ Spec (CommRingCat.of k) :=
  Limits.pullback.snd _ _

/-- **The Frobenius map** $\Pi_q : C \to C^{(q)}$, $q = p^n$ (Milne, Section 10, pdf p. 106; D109): it sends the point
$(a_0 : a_1 : \cdots)$ to $(a_0^q : a_1^q : \cdots)$ (Tau Ceti's iterated relative Frobenius, a morphism over $k$). -/
@[kb "milne2017mf" "Section 10, the Frobenius map Π_q : C → C^(q) (pdf p. 106)"]
def frobeniusMap (n : ℕ) : C ⟶ frobeniusTwist k p hk f n :=
  f.iterateRelativeFrobenius p hk n

/-- $\Pi_q$ is a morphism over $k$. -/
theorem frobeniusMap_comp (n : ℕ) : frobeniusMap k p hk f n ≫ frobeniusTwistStructure k p hk f n = f :=
  Scheme.Hom.iterateRelativeFrobenius_snd f p hk n

/-- **Milne, Proposition 10.2** (named statement). Let $k$ be an algebraically closed field of characteristic $p$,
$q = p^n$, and $C$ a complete nonsingular curve over $k$. The Frobenius map $\Pi_q : C \to C^{(q)}$ is purely
inseparable of degree $q$ (in particular $C^{(q)}$ is an integral curve and $\Pi_q$ is dominant), and every purely
inseparable map $\varphi : C \to C'$ of degree $q$ of complete nonsingular curves factors as
$C \xrightarrow{\Pi_q} C^{(q)} \xrightarrow{\ \sim\ } C'$. -/
@[kb "milne2017mf" "Section 10, Proposition 10.2 (pdf p. 106)"]
structure FrobeniusFactorization [IsAlgClosed k] : Prop where
  frobenius : ∀ {C : Scheme.{u}} [IsIntegral C] (f : C ⟶ Spec (CommRingCat.of k)), IsCompleteRegularCurve k f →
    ∀ n : ℕ, ∃ (_ : IsIntegral (frobeniusTwist k p hk f n)) (_ : IsDominant (frobeniusMap k p hk f n)),
      IsCompleteRegularCurve k (frobeniusTwistStructure k p hk f n) ∧
      IsPurelyInseparableMorphism (frobeniusMap k p hk f n) ∧ morphismDegree (frobeniusMap k p hk f n) = p ^ n
  factors : ∀ {C C' : Scheme.{u}} [IsIntegral C] [IsIntegral C'] (f : C ⟶ Spec (CommRingCat.of k))
    (f' : C' ⟶ Spec (CommRingCat.of k)), IsCompleteRegularCurve k f → IsCompleteRegularCurve k f' →
    ∀ (φ : C ⟶ C') [IsDominant φ], φ ≫ f' = f → IsPurelyInseparableMorphism φ →
    ∀ n : ℕ, morphismDegree φ = p ^ n →
      ∃ e : frobeniusTwist k p hk f n ≅ C', e.hom ≫ f' = frobeniusTwistStructure k p hk f n ∧
        frobeniusMap k p hk f n ≫ e.hom = φ

end Frobenius

end ModularFormsKB.Milne
