/-!
# Milne, Chapter 2: the modular group `SL₂(ℤ)`

Milne, *Modular Functions and Modular Forms* (`milne2017mf`), §2, pdf pp. 31–39.

* Remark 2.11: every elliptic point of `SL₂(ℤ)` is equivalent to exactly one of `i`, `ρ`. (The cusp part of 2.11 is
  Mathlib's `isCusp_SL2Z_iff`.) Mathlib's `UpperHalfPlane.ρ` is `e^{2πi/3}`, which is `T`-equivalent to the book's
  `ρ = e^{2πi/6}`.
* Remark 2.14: `SL₂(ℤ)/{±I}` is the free product of the cyclic group of order 2 generated by `S` and the cyclic group
  of order 3 generated by `ST`.
* Aside 2.15: reduction of positive definite real binary quadratic forms; finiteness of classes of integral forms
  (Tau Ceti `TauCeti.BinaryQuadraticForm.finite_orbitRel_quotient_of_forall_discrim_eq`); the hexagonal lattice is
  the densest lattice packing of the plane.
* Example 2.23 and Exercise 2.24: the index of `Γ(N)` and the number `μ_N / N` of cusps of `Γ(N)` (from the Miyake
  files of this library, restated in the book's form).

Binary quadratic forms are Tau Ceti's `TauCeti.BinaryQuadraticForm` (`a x² + b xy + c y²`), with Tau Ceti's action
`γ • f = f ∘ γ⁻¹` of `SL₂`; Milne's equivalence `Q = Aᵀ Q' A` has the same orbits. `SL₂(ℤ)` acts on real forms
through `SL₂(ℤ) → SL₂(ℝ)`. The book treats definite forms; here positive definite ones (`a > 0`, `b² - 4ac < 0`),
negative definite forms being their negatives.
-/

open Matrix MatrixGroups UpperHalfPlane CongruenceSubgroup TauCeti

namespace ModularFormsKB.Milne

/-! ### Remark 2.11: elliptic points of `SL₂(ℤ)` -/

/-- `SL₂(ℤ)` as a subgroup of `SL₂(ℝ)`. -/
noncomputable def SL2ZinSL2R : Subgroup SL(2, ℝ) :=
  (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ)).range

namespace Remark211

lemma orbit_eq_iff (z w : ℍ) :
    (Quotient.mk'' z : MulAction.orbitRel.Quotient SL(2, ℤ) ℍ) = Quotient.mk'' w ↔
      ∃ γ : SL(2, ℤ), γ • z = w := by
  constructor
  · intro h
    obtain ⟨g, hg⟩ := Quotient.exact' h
    exact ⟨g⁻¹, by rw [inv_smul_eq_iff]; exact hg.symm⟩
  · rintro ⟨g, hg⟩
    exact Quotient.sound' ⟨g⁻¹, by show g⁻¹ • w = z; rw [← hg]; exact inv_smul_smul g z⟩

lemma map_smul' (g : SL(2, ℤ)) (z : ℍ) :
    (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) g) • z = g • z := by
  ext
  simp [UpperHalfPlane.specialLinearGroup_apply]

lemma isElliptic_map (h : SL(2, ℤ)) (htr : (h : Matrix (Fin 2) (Fin 2) ℤ).trace ^ 2 < 4) :
    ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) h : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ).IsElliptic := by
  unfold Matrix.IsElliptic
  have hd := (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) h).det_coe
  rw [Matrix.discr_fin_two, hd]
  have : ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) h : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ).trace = (((h : Matrix (Fin 2) (Fin 2) ℤ).trace : ℤ) : ℝ) := by
    simp [Matrix.trace_fin_two]
  rw [this]
  have h4 : (((h : Matrix (Fin 2) (Fin 2) ℤ).trace : ℤ) : ℝ) ^ 2 < 4 := by exact_mod_cast htr
  linarith

lemma ne_of_isElliptic {g : SL(2, ℤ)}
    (h : ((Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) g : SL(2, ℝ)) :
      Matrix (Fin 2) (Fin 2) ℝ).IsElliptic) : g ≠ 1 ∧ g ≠ -1 := by
  constructor <;> rintro rfl <;>
    simp [Matrix.IsElliptic, Matrix.discr_fin_two, Matrix.det_fin_two] at h <;> norm_num at h

lemma neg_one_ne_one : (-1 : SL(2, ℤ)) ≠ 1 := fun h => by
  have h00 := congrArg (fun g : SL(2, ℤ) => (g : Matrix (Fin 2) (Fin 2) ℤ) 0 0) h
  norm_num at h00

lemma ell_of {z w : ℍ} (γ : SL(2, ℤ)) (hγ : γ • z = w) (s : SL(2, ℤ)) (hs : s • w = w)
    (htr : (s : Matrix (Fin 2) (Fin 2) ℤ).trace ^ 2 < 4) :
    IsEllipticPoint SL2ZinSL2R z := by
  refine ⟨Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) (γ⁻¹ * s * γ),
    MonoidHom.mem_range.2 ⟨_, rfl⟩, isElliptic_map _ ?_, ?_⟩
  · have h1 : (γ : Matrix (Fin 2) (Fin 2) ℤ) * ((γ⁻¹ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) = 1 := by
      rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel]; rfl
    rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.trace_mul_cycle, h1, one_mul]
    exact htr
  · rw [map_smul', mul_smul, mul_smul, hγ, hs, inv_smul_eq_iff, hγ]

end Remark211

/-- **Milne, Remark 2.11** (elliptic points): every elliptic point of `Γ(1) = SL₂(ℤ)` is `Γ(1)`-equivalent to exactly
one of `i` and `ρ`. -/
@[kb "milne2017mf" "Remark 2.11: elliptic points of Gamma(1), pdf p. 31"]
theorem isEllipticPoint_SL2Z_iff (z : ℍ) :
    IsEllipticPoint SL2ZinSL2R z ↔
      Xor (∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.I) (∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.ρ) := by
  have hnb : ¬ ((∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.I) ∧
      (∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.ρ)) := by
    rintro ⟨h1, h2⟩
    apply TauCeti.ModularGroup.orbit_mk_I_ne_orbit_mk_ρ
    rw [← Remark211.orbit_eq_iff] at h1 h2
    exact h1.symm.trans h2
  have key : IsEllipticPoint SL2ZinSL2R z ↔
      ((∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.I) ∨ (∃ γ : SL(2, ℤ), γ • z = UpperHalfPlane.ρ)) := by
    constructor
    · rintro ⟨_, ⟨g, rfl⟩, hell, hfix⟩
      rw [Remark211.map_smul'] at hfix
      by_contra hPQ
      push Not at hPQ
      have hI : (Quotient.mk'' z : MulAction.orbitRel.Quotient SL(2, ℤ) ℍ) ≠ Quotient.mk'' UpperHalfPlane.I :=
        fun h => by
          obtain ⟨γ, hγ⟩ := (Remark211.orbit_eq_iff _ _).1 h
          exact hPQ.1 γ hγ
      have hρ : (Quotient.mk'' z : MulAction.orbitRel.Quotient SL(2, ℤ) ℍ) ≠ Quotient.mk'' UpperHalfPlane.ρ :=
        fun h => by
          obtain ⟨γ, hγ⟩ := (Remark211.orbit_eq_iff _ _).1 h
          exact hPQ.2 γ hγ
      have hc := TauCeti.ModularGroup.card_stabilizer_eq_two_of_orbit_ne_I_of_orbit_ne_ρ z hI hρ
      obtain ⟨x, y, hxy, hset⟩ := Nat.card_eq_two_iff.1 hc
      have hall : ∀ t : MulAction.stabilizer SL(2, ℤ) z, t = x ∨ t = y := by
        intro t
        have := (Set.ext_iff.1 hset t).2 (Set.mem_univ t)
        simpa using this
      obtain ⟨hg1, hg2⟩ := Remark211.ne_of_isElliptic hell
      let a : MulAction.stabilizer SL(2, ℤ) z := 1
      let b : MulAction.stabilizer SL(2, ℤ) z := ⟨-1, by simp [MulAction.mem_stabilizer_iff]⟩
      let c : MulAction.stabilizer SL(2, ℤ) z := ⟨g, hfix⟩
      have hab : a ≠ b := fun h => Remark211.neg_one_ne_one (congrArg Subtype.val h).symm
      have hac : a ≠ c := fun h => hg1 (congrArg Subtype.val h).symm
      have hbc : b ≠ c := fun h => hg2 (congrArg Subtype.val h).symm
      rcases hall a with ha | ha <;> rcases hall b with hb | hb <;> rcases hall c with hc' | hc' <;>
        first
        | exact hab (ha.trans hb.symm)
        | exact hac (ha.trans hc'.symm)
        | exact hbc (hb.trans hc'.symm)
    · rintro (⟨γ, hγ⟩ | ⟨γ, hγ⟩)
      · exact Remark211.ell_of γ hγ ModularGroup.S
          (ModularGroup.stabilizer_I.mpr (by simp)) (by decide +kernel)
      · exact Remark211.ell_of γ hγ (ModularGroup.S * ModularGroup.T)
          (ModularGroup.stabilizer_ρ.mpr (by simp)) (by decide +kernel)
  rw [key]
  unfold Xor
  tauto

/-! ### Remark 2.14 -/

namespace Remark214

/-- The homomorphism `Multiplicative (ZMod n) →* G` sending the generator to `g`, when `g ^ n = 1`. -/
def cycHom {n : ℕ} [NeZero n] {G : Type*} [Group G] (g : G) (h : g ^ n = 1) :
    Multiplicative (ZMod n) →* G where
  toFun x := g ^ (Multiplicative.toAdd x).val
  map_one' := by simp
  map_mul' x y := by
    simp only [toAdd_mul, ZMod.val_add]
    rw [← pow_add]
    conv_rhs => rw [← Nat.mod_add_div ((Multiplicative.toAdd x).val + (Multiplicative.toAdd y).val) n,
      pow_add, pow_mul, h, one_pow, mul_one]

/-- The family of cyclic groups `C₂, C₃` indexed by `Bool`, to use Mathlib's indexed free product. -/
abbrev Hs (b : Bool) : Type := bif b then Multiplicative (ZMod 3) else Multiplicative (ZMod 2)

instance (b : Bool) : Group (Hs b) := by
  cases b
  · exact inferInstanceAs (Group (Multiplicative (ZMod 2)))
  · exact inferInstanceAs (Group (Multiplicative (ZMod 3)))

abbrev A := Multiplicative (ZMod 2)
abbrev B := Multiplicative (ZMod 3)

/-- `C₂ * C₃ → ∐_{Bool} Hs`. -/
def toI : Monoid.Coprod A B →* Monoid.CoprodI Hs :=
  Monoid.Coprod.lift (Monoid.CoprodI.of (i := false) : Hs false →* _)
    (Monoid.CoprodI.of (i := true) : Hs true →* _)

/-- `∐_{Bool} Hs → C₂ * C₃`. -/
def fromI : Monoid.CoprodI Hs →* Monoid.Coprod A B :=
  Monoid.CoprodI.lift (fun b => match b with
    | false => Monoid.Coprod.inl
    | true => Monoid.Coprod.inr)

/-- The binary free product is the indexed free product over `Bool`. -/
def eI : Monoid.Coprod A B ≃* Monoid.CoprodI Hs :=
  MonoidHom.toMulEquiv toI fromI
    (by
      apply Monoid.Coprod.hom_ext <;> rfl)
    (by
      apply Monoid.CoprodI.ext_hom
      intro i
      cases i <;> rfl)

lemma S_sq : ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) ^ 2 = 1 := by
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff,
    SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one]
  exact Or.inr (by decide +kernel)

lemma U_cube : (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ^ 3 = 1 := by
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff,
    SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one]
  exact Or.inr (by decide +kernel)

lemma U_sq : (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ^ 2 =
    ((ModularGroup.T⁻¹ * ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) := by
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq,
    SpecialLinearGroup.mem_center_iff_eq_one_or_eq_neg_one]
  exact Or.inl (by decide +kernel)

/-- The homomorphisms `C₂ → PSL₂(ℤ)`, `C₃ → PSL₂(ℤ)` sending generators to `S`, `ST`. -/
noncomputable def fam : ∀ b : Bool, Hs b →* PSL(2, ℤ)
  | false => cycHom (n := 2) ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) S_sq
  | true => cycHom (n := 3) (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) U_cube

/-- The induced homomorphism from the free product. -/
noncomputable def Fm : Monoid.CoprodI Hs →* PSL(2, ℤ) := Monoid.CoprodI.lift fam

lemma S_re (z : ℍ) : (ModularGroup.S • z).re = -z.re / Complex.normSq (z : ℂ) := by
  rw [UpperHalfPlane.modular_S_smul]
  simp [Complex.inv_re, neg_div]

lemma S_pos {z : ℍ} (h : z.re < 0) : 0 < (ModularGroup.S • z).re := by
  rw [S_re]
  exact div_pos (by linarith) (Complex.normSq_pos.2 z.ne_zero)

lemma S_neg {z : ℍ} (h : 0 < z.re) : (ModularGroup.S • z).re < 0 := by
  rw [S_re]
  exact div_neg_of_neg_of_pos (by linarith) (Complex.normSq_pos.2 z.ne_zero)

lemma U_neg {z : ℍ} (h : 0 < z.re) :
    ((ModularGroup.S * ModularGroup.T : SL(2, ℤ)) • z).re < 0 := by
  rw [mul_smul]
  apply S_neg
  rw [ModularGroup.re_T_smul]
  linarith

lemma U2_neg {z : ℍ} (h : 0 < z.re) :
    ((ModularGroup.T⁻¹ * ModularGroup.S : SL(2, ℤ)) • z).re < 0 := by
  rw [mul_smul]
  have h1 := S_neg h
  have : (ModularGroup.T⁻¹ • (ModularGroup.S • z)).re = (ModularGroup.S • z).re - 1 := by
    have := ModularGroup.re_T_smul (ModularGroup.T⁻¹ • (ModularGroup.S • z))
    rw [← mul_smul, mul_inv_cancel, one_smul] at this
    linarith
  rw [this]
  linarith

lemma pp_false (h : A) (hne : h ≠ 1) (w : ℍ) (hw : w.re < 0) :
    0 < (fam false h • w).re := by
  obtain ⟨x, rfl⟩ := Multiplicative.ofAdd.surjective h
  have hx : x = 0 ∨ x = 1 := by revert x; decide
  rcases hx with rfl | rfl
  · exact absurd rfl hne
  · have e : fam false (Multiplicative.ofAdd (1 : ZMod 2)) =
        ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) := by
      show ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) ^ ((1 : ZMod 2).val) = _
      have : (1 : ZMod 2).val = 1 := rfl
      rw [this, pow_one]
    refine lt_of_lt_of_eq ?_ (congrArg (fun g : PSL(2, ℤ) => (g • w).re) e).symm
    exact S_pos hw

lemma pp_true (h : B) (hne : h ≠ 1) (w : ℍ) (hw : 0 < w.re) :
    (fam true h • w).re < 0 := by
  obtain ⟨x, rfl⟩ := Multiplicative.ofAdd.surjective h
  have hx : x = 0 ∨ x = 1 ∨ x = 2 := by revert x; decide
  rcases hx with rfl | rfl | rfl
  · exact absurd rfl hne
  · have e : fam true (Multiplicative.ofAdd (1 : ZMod 3)) =
        (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) := by
      show (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ^ ((1 : ZMod 3).val) = _
      have : (1 : ZMod 3).val = 1 := rfl
      rw [this, pow_one]
    refine Eq.trans_lt (congrArg (fun g : PSL(2, ℤ) => (g • w).re) e) ?_
    exact U_neg hw
  · have e : fam true (Multiplicative.ofAdd (2 : ZMod 3)) =
        (((ModularGroup.T⁻¹ * ModularGroup.S : SL(2, ℤ))) : PSL(2, ℤ)) := by
      show (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ^ ((2 : ZMod 3).val) = _
      have : (2 : ZMod 3).val = 2 := rfl
      rw [this, U_sq]
    refine Eq.trans_lt (congrArg (fun g : PSL(2, ℤ) => (g • w).re) e) ?_
    exact U2_neg hw

/-- Ping-pong on `ℍ` with the half planes `Re < 0`, `Re > 0`: the map from the free product is injective. -/
theorem Fm_inj : Function.Injective Fm := by
  refine Monoid.CoprodI.lift_injective_of_ping_pong fam (Or.inr ⟨true, ?_⟩)
    (fun b : Bool => if b then {z : ℍ | z.re < 0} else {z : ℍ | 0 < z.re}) ?_ ?_ ?_
  · show 3 ≤ Cardinal.mk (Multiplicative (ZMod 3))
    rw [Cardinal.mk_fintype]
    simp
  · intro b
    cases b
    · exact ⟨(1 : ℝ) +ᵥ UpperHalfPlane.I, by simp⟩
    · exact ⟨(-1 : ℝ) +ᵥ UpperHalfPlane.I, by simp⟩
  · intro i j hij
    cases i <;> cases j <;> simp at hij ⊢
    · exact Set.disjoint_left.2 fun z h1 h2 => by simp at h1 h2; linarith
    · exact Set.disjoint_left.2 fun z h1 h2 => by simp at h1 h2; linarith
  · intro i j hij
    cases i <;> cases j <;> simp at hij
    · intro h hne z hz
      obtain ⟨w, hw, rfl⟩ := Set.mem_smul_set.1 hz
      exact pp_false h hne w hw
    · intro h hne z hz
      obtain ⟨w, hw, rfl⟩ := Set.mem_smul_set.1 hz
      exact pp_true h hne w hw

lemma fam_false_one : fam false (Multiplicative.ofAdd (1 : ZMod 2)) =
    ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) := by
  show ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) ^ ((1 : ZMod 2).val) = _
  have : (1 : ZMod 2).val = 1 := rfl
  rw [this, pow_one]

lemma fam_true_one : fam true (Multiplicative.ofAdd (1 : ZMod 3)) =
    (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) := by
  show (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ^ ((1 : ZMod 3).val) = _
  have : (1 : ZMod 3).val = 1 := rfl
  rw [this, pow_one]

lemma Fm_surj : Function.Surjective Fm := by
  intro g
  obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective g
  have hS : ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ)) ∈ Fm.range :=
    ⟨Monoid.CoprodI.of (i := false) (Multiplicative.ofAdd (1 : ZMod 2)), by
      exact fam_false_one⟩
  have hU : (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) ∈ Fm.range :=
    ⟨Monoid.CoprodI.of (i := true) (Multiplicative.ofAdd (1 : ZMod 3)), by
      exact fam_true_one⟩
  have hT : ((ModularGroup.T : SL(2, ℤ)) : PSL(2, ℤ)) ∈ Fm.range := by
    have := mul_mem (inv_mem hS) hU
    have e : ((ModularGroup.S : SL(2, ℤ)) : PSL(2, ℤ))⁻¹ *
        (((ModularGroup.S * ModularGroup.T : SL(2, ℤ))) : PSL(2, ℤ)) =
        ((ModularGroup.T : SL(2, ℤ)) : PSL(2, ℤ)) := by
      rw [← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
      congr 1
      group
    rwa [e] at this
  have hle : Subgroup.closure {ModularGroup.S, ModularGroup.T} ≤
      Fm.range.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) := by
    rw [Subgroup.closure_le]
    rintro y (rfl | rfl)
    · exact hS
    · exact hT
  have hx : x ∈ Fm.range.comap (QuotientGroup.mk' (Subgroup.center SL(2, ℤ))) :=
    hle (by rw [SpecialLinearGroup.SL2Z_generators]; trivial)
  exact hx

end Remark214

/-- **Milne, Remark 2.14.** `SL₂(ℤ)/{±I}` is the free product of the cyclic group of order 2 generated by `S` and the
cyclic group of order 3 generated by `ST`: the homomorphism from `C₂ * C₃` sending the generators to `S` and `ST` is an
isomorphism onto `PSL₂(ℤ)`. -/
@[kb "milne2017mf" "Remark 2.14, pdf p. 33"]
theorem exists_mulEquiv_coprod :
    ∃ φ : Monoid.Coprod (Multiplicative (ZMod 2)) (Multiplicative (ZMod 3)) ≃* PSL(2, ℤ),
      φ (Monoid.Coprod.inl (Multiplicative.ofAdd 1)) = (ModularGroup.S : PSL(2, ℤ)) ∧
      φ (Monoid.Coprod.inr (Multiplicative.ofAdd 1)) =
        ((ModularGroup.S * ModularGroup.T : SL(2, ℤ)) : PSL(2, ℤ)) := by
  refine ⟨Remark214.eI.trans (MulEquiv.ofBijective Remark214.Fm
    ⟨Remark214.Fm_inj, Remark214.Fm_surj⟩), ?_, ?_⟩
  · show Remark214.Fm (Monoid.CoprodI.of (i := false) (Multiplicative.ofAdd (1 : ZMod 2))) = _
    exact Remark214.fam_false_one
  · show Remark214.Fm (Monoid.CoprodI.of (i := true) (Multiplicative.ofAdd (1 : ZMod 3))) = _
    exact Remark214.fam_true_one

/-! ### Aside 2.15: binary quadratic forms -/

/-- `SL₂(ℤ)` acting on real binary quadratic forms. -/
noncomputable def slZSmul (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) : BinaryQuadraticForm ℝ :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) γ • f

/-- A positive definite real binary form `a x² + b xy + c y²`: `a > 0` and `b² - 4ac < 0`. -/
def IsPosDefForm (f : BinaryQuadraticForm ℝ) : Prop := 0 < f.a ∧ f.b ^ 2 - 4 * f.a * f.c < 0

/-- **Reduced form** (Milne, Aside 2.15, p. 34): `-a < b ≤ a < c` or `0 ≤ b ≤ a = c`. -/
@[kb "milne2017mf" "Aside 2.15: reduced binary quadratic form, pdf p. 34"]
def IsReducedForm (f : BinaryQuadraticForm ℝ) : Prop :=
  (-f.a < f.b ∧ f.b ≤ f.a ∧ f.a < f.c) ∨ (0 ≤ f.b ∧ f.b ≤ f.a ∧ f.a = f.c)

section Aux

lemma slZSmul_one (f : BinaryQuadraticForm ℝ) : slZSmul 1 f = f := by
  simp [slZSmul]

lemma slZSmul_mul (δ γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    slZSmul (δ * γ) f = slZSmul δ (slZSmul γ f) := by
  simp [slZSmul, mul_smul]

lemma slZSmul_a (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    (slZSmul γ f).a = f.a * (γ 1 1 : ℝ) ^ 2 - f.b * γ 1 0 * γ 1 1 + f.c * (γ 1 0 : ℝ) ^ 2 := by
  simp [slZSmul]

lemma slZSmul_b (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    (slZSmul γ f).b = f.b * (γ 0 0 * γ 1 1 + γ 0 1 * γ 1 0 : ℝ) - 2 * f.a * γ 0 1 * γ 1 1 -
      2 * f.c * γ 0 0 * γ 1 0 := by
  simp [slZSmul]

lemma slZSmul_c (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    (slZSmul γ f).c = f.a * (γ 0 1 : ℝ) ^ 2 - f.b * γ 0 0 * γ 0 1 + f.c * (γ 0 0 : ℝ) ^ 2 := by
  simp [slZSmul]

lemma slZSmul_discrim (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    (slZSmul γ f).b ^ 2 - 4 * (slZSmul γ f).a * (slZSmul γ f).c = f.b ^ 2 - 4 * f.a * f.c := by
  have := BinaryQuadraticForm.discrim_smul (Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ) γ) f
  simpa [BinaryQuadraticForm.discrim_def, discrim, slZSmul, sq] using this

lemma slZSmul_eval (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) (x y : ℤ) :
    (slZSmul γ f).eval x y =
      f.eval ((γ 1 1 * x - γ 0 1 * y : ℤ) : ℝ) ((-γ 1 0 * x + γ 0 0 * y : ℤ) : ℝ) := by
  simp [slZSmul]

lemma det_SL2Z (γ : SL(2, ℤ)) : γ 0 0 * γ 1 1 - γ 0 1 * γ 1 0 = 1 := by
  have := γ.det_coe
  rw [Matrix.det_fin_two] at this
  exact this

lemma transform_ne_zero (γ : SL(2, ℤ)) {x y : ℤ} (h : (x, y) ≠ (0, 0)) :
    ((γ 1 1 * x - γ 0 1 * y : ℤ), (-γ 1 0 * x + γ 0 0 * y : ℤ)) ≠ (0, 0) := by
  intro h'
  have h1 := congrArg Prod.fst h'
  have h2 := congrArg Prod.snd h'
  simp only at h1 h2
  have hd := det_SL2Z γ
  apply h
  have hx : x = 0 := by linear_combination (γ 0 0) * h1 + (γ 0 1) * h2 - x * hd
  have hy : y = 0 := by linear_combination (γ 1 0) * h1 + (γ 1 1) * h2 - y * hd
  rw [hx, hy]

lemma transform_isCoprime (γ : SL(2, ℤ)) {x y : ℤ} (h : IsCoprime x y) :
    IsCoprime (γ 1 1 * x - γ 0 1 * y : ℤ) (-γ 1 0 * x + γ 0 0 * y : ℤ) := by
  obtain ⟨u, v, huv⟩ := h
  have hd := det_SL2Z γ
  refine ⟨u * γ 0 0 + v * γ 1 0, u * γ 0 1 + v * γ 1 1, ?_⟩
  linear_combination huv + (u * x + v * y) * hd

lemma cast_ne_zero {x y : ℤ} (h : (x, y) ≠ (0, 0)) : ((x : ℝ), (y : ℝ)) ≠ (0, 0) := by
  intro h'
  apply h
  have h1 := congrArg Prod.fst h'
  have h2 := congrArg Prod.snd h'
  simp only [Int.cast_eq_zero] at h1 h2
  rw [h1, h2]

lemma eval_pos_of_posDef {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) {x y : ℝ}
    (h : (x, y) ≠ (0, 0)) : 0 < f.eval x y := by
  obtain ⟨ha, hd⟩ := hf
  rw [BinaryQuadraticForm.eval_def]
  by_cases hy : y = 0
  · have hx : x ≠ 0 := by
      rintro rfl
      exact h (by simp [hy])
    subst hy
    simp only [mul_zero, add_zero, zero_pow two_ne_zero]
    positivity
  · have hy2 : 0 < y ^ 2 := by positivity
    have : 0 < 4 * f.a * (f.a * x ^ 2 + f.b * x * y + f.c * y ^ 2) := by
      nlinarith [sq_nonneg (2 * f.a * x + f.b * y), mul_pos (sub_pos.2 hd) hy2]
    nlinarith

lemma posDef_slZSmul {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) (γ : SL(2, ℤ)) :
    IsPosDefForm (slZSmul γ f) := by
  refine ⟨?_, by rw [slZSmul_discrim]; exact hf.2⟩
  have h := slZSmul_eval γ f 1 0
  simp only [Int.cast_one, Int.cast_zero, BinaryQuadraticForm.eval_one_zero] at h
  rw [h]
  exact eval_pos_of_posDef hf (cast_ne_zero (transform_ne_zero γ (x := 1) (y := 0) (by simp)))

lemma reduced_bounds {h : BinaryQuadraticForm ℝ} (hr : IsReducedForm h) :
    -h.a ≤ h.b ∧ h.b ≤ h.a ∧ h.a ≤ h.c := by
  rcases hr with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
  · exact ⟨h1.le, h2, h3.le⟩
  · exact ⟨by linarith, h2, h3.le⟩

lemma one_le_sq_aux {x y : ℤ} (h : (x, y) ≠ (0, 0)) : 1 ≤ x ^ 2 + y ^ 2 := by
  by_contra hc
  apply h
  have hx : x = 0 := by nlinarith [sq_nonneg x, sq_nonneg y]
  have hy : y = 0 := by nlinarith [sq_nonneg x, sq_nonneg y]
  rw [hx, hy]

lemma quad_aux {x y : ℤ} (h : (x, y) ≠ (0, 0)) :
    (1 : ℝ) ≤ (x : ℝ) ^ 2 - x * y + y ^ 2 ∧ (1 : ℝ) ≤ (x : ℝ) ^ 2 + x * y + y ^ 2 := by
  have h1 := one_le_sq_aux h
  have a1 : (1 : ℤ) ≤ x ^ 2 - x * y + y ^ 2 := by nlinarith [sq_nonneg (x - y)]
  have a2 : (1 : ℤ) ≤ x ^ 2 + x * y + y ^ 2 := by nlinarith [sq_nonneg (x + y)]
  exact ⟨by exact_mod_cast a1, by exact_mod_cast a2⟩

lemma reduced_a_le_eval {h : BinaryQuadraticForm ℝ} (hr : IsReducedForm h) (ha : 0 < h.a) {x y : ℤ}
    (hxy : (x, y) ≠ (0, 0)) : h.a ≤ h.eval x y := by
  obtain ⟨hb1, hb2, hc⟩ := reduced_bounds hr
  obtain ⟨q1, q2⟩ := quad_aux hxy
  rw [BinaryQuadraticForm.eval_def]
  rcases le_or_gt 0 ((x : ℝ) * y) with hp | hp
  · nlinarith [mul_nonneg (show 0 ≤ h.b + h.a by linarith) hp,
      mul_nonneg (sub_nonneg.2 hc) (sq_nonneg (y : ℝ)), mul_le_mul_of_nonneg_left q1 ha.le]
  · nlinarith [mul_nonneg (show 0 ≤ h.a - h.b by linarith) (neg_nonneg.2 hp.le),
      mul_nonneg (sub_nonneg.2 hc) (sq_nonneg (y : ℝ)), mul_le_mul_of_nonneg_left q2 ha.le]

lemma reduced_c_le_eval {h : BinaryQuadraticForm ℝ} (hr : IsReducedForm h) (ha : 0 < h.a) {x y : ℤ}
    (hy : y ≠ 0) : h.c ≤ h.eval x y := by
  obtain ⟨hb1, hb2, hc⟩ := reduced_bounds hr
  have hxy : (x, y) ≠ (0, 0) := fun h' => hy (congrArg Prod.snd h')
  obtain ⟨q1, q2⟩ := quad_aux hxy
  have hy1 : (1 : ℝ) ≤ (y : ℝ) ^ 2 := by
    have : (1 : ℤ) ≤ y ^ 2 := by
      have := one_le_sq_aux (x := 0) (y := y) (fun h' => hy (congrArg Prod.snd h'))
      simpa using this
    exact_mod_cast this
  rw [BinaryQuadraticForm.eval_def]
  rcases le_or_gt 0 ((x : ℝ) * y) with hp | hp
  · nlinarith [mul_nonneg (show 0 ≤ h.b + h.a by linarith) hp,
      mul_nonneg (sub_nonneg.2 hc) (sub_nonneg.2 hy1), mul_le_mul_of_nonneg_left q1 ha.le]
  · nlinarith [mul_nonneg (show 0 ≤ h.a - h.b by linarith) (neg_nonneg.2 hp.le),
      mul_nonneg (sub_nonneg.2 hc) (sub_nonneg.2 hy1), mul_le_mul_of_nonneg_left q2 ha.le]

lemma slZSmul_a_eq (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    (slZSmul γ f).a = f.eval ((γ 1 1 : ℤ) : ℝ) ((-γ 1 0 : ℤ) : ℝ) := by
  have h := slZSmul_eval γ f 1 0
  simp only [Int.cast_one, Int.cast_zero, BinaryQuadraticForm.eval_one_zero] at h
  rw [h]
  simp

lemma vec_ne_zero (γ : SL(2, ℤ)) : ((γ 1 1 : ℤ), (-γ 1 0 : ℤ)) ≠ (0, 0) := by
  have := transform_ne_zero γ (x := 1) (y := 0) (by simp)
  simpa using this

lemma abs_le_sq_aux (y : ℤ) : |y| ≤ y ^ 2 := by
  rcases eq_or_ne y 0 with rfl | h
  · simp
  · have := Int.one_le_abs h
    nlinarith [sq_abs y]

end Aux

section Aux3

/-- `g.a` is minimal among the values of `g` at primitive integral vectors. -/
def IsMinForm (g : BinaryQuadraticForm ℝ) : Prop :=
  ∀ x y : ℤ, IsCoprime x y → g.a ≤ g.eval x y

lemma exists_eval_eq_of_coprime (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) {x y : ℤ}
    (h : IsCoprime x y) : ∃ u v : ℤ, IsCoprime u v ∧ (slZSmul γ f).eval x y = f.eval u v :=
  ⟨_, _, transform_isCoprime γ h, slZSmul_eval γ f x y⟩

lemma exists_min_coprime {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) :
    ∃ x y : ℤ, IsCoprime x y ∧ ∀ x' y' : ℤ, IsCoprime x' y' → f.eval x y ≤ f.eval x' y' := by
  obtain ⟨ha, hd⟩ := hf
  have hDpos : 0 < 4 * f.a * f.c - f.b ^ 2 := by linarith
  have hc : 0 < f.c := by
    by_contra hc
    nlinarith [sq_nonneg f.b, mul_nonneg ha.le (not_lt.1 hc |>.trans' le_rfl |> fun _ => le_rfl)]
  set D := 4 * f.a * f.c - f.b ^ 2 with hD
  set K0 := (4 * f.a ^ 2 + 4 * f.a * f.c) / D with hK0
  let S : Set (ℤ × ℤ) := {p | IsCoprime p.1 p.2 ∧ f.eval p.1 p.2 ≤ f.eval 1 0}
  have hfin : S.Finite := by
    refine ((Set.finite_Icc (-⌈K0⌉) ⌈K0⌉).prod (Set.finite_Icc (-⌈K0⌉) ⌈K0⌉)).subset ?_
    rintro ⟨x, y⟩ ⟨_, hle⟩
    simp only [BinaryQuadraticForm.eval_one_zero] at hle
    have e1 : 4 * f.a * f.eval x y = (2 * f.a * x + f.b * y) ^ 2 + D * (y : ℝ) ^ 2 := by
      rw [BinaryQuadraticForm.eval_def, hD]; ring
    have e2 : 4 * f.c * f.eval x y = (2 * f.c * y + f.b * x) ^ 2 + D * (x : ℝ) ^ 2 := by
      rw [BinaryQuadraticForm.eval_def, hD]; ring
    have hy : (y : ℝ) ^ 2 ≤ K0 := by
      rw [hK0, le_div_iff₀ hDpos]
      nlinarith [sq_nonneg (2 * f.a * x + f.b * y), mul_le_mul_of_nonneg_left hle ha.le,
        mul_pos ha hc]
    have hx : (x : ℝ) ^ 2 ≤ K0 := by
      rw [hK0, le_div_iff₀ hDpos]
      nlinarith [sq_nonneg (2 * f.c * y + f.b * x), mul_le_mul_of_nonneg_left hle hc.le,
        mul_pos ha hc, mul_pos ha ha]
    have hy' : y ^ 2 ≤ ⌈K0⌉ := by
      have : ((y ^ 2 : ℤ) : ℝ) ≤ (⌈K0⌉ : ℝ) := by push_cast; exact hy.trans (Int.le_ceil K0)
      exact_mod_cast this
    have hx' : x ^ 2 ≤ ⌈K0⌉ := by
      have : ((x ^ 2 : ℤ) : ℝ) ≤ (⌈K0⌉ : ℝ) := by push_cast; exact hx.trans (Int.le_ceil K0)
      exact_mod_cast this
    have ay := abs_le.1 ((abs_le_sq_aux y).trans hy')
    have ax := abs_le.1 ((abs_le_sq_aux x).trans hx')
    exact ⟨⟨ax.1, ax.2⟩, ⟨ay.1, ay.2⟩⟩
  obtain ⟨p, hp, hmin⟩ := Set.exists_min_image S (fun p : ℤ × ℤ => f.eval p.1 p.2) hfin
    ⟨(1, 0), isCoprime_one_left, by simp⟩
  refine ⟨p.1, p.2, hp.1, fun x' y' hc' => ?_⟩
  by_cases hle : f.eval x' y' ≤ f.eval 1 0
  · exact hmin (x', y') ⟨hc', hle⟩
  · exact hp.2.trans (not_le.1 hle).le

lemma exists_isMinForm {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) :
    ∃ γ : SL(2, ℤ), IsMinForm (slZSmul γ f) := by
  obtain ⟨x, y, hxy, hmin⟩ := exists_min_coprime hf
  obtain ⟨γ, h0, h1⟩ := (hxy.symm.neg_left).exists_SL2_row 1
  refine ⟨γ, fun x' y' hc => ?_⟩
  obtain ⟨u, v, huv, e⟩ := exists_eval_eq_of_coprime γ f hc
  rw [e, slZSmul_a_eq, h0, h1]
  simpa using hmin u v huv

lemma exists_reduced_of_min {g : BinaryQuadraticForm ℝ} (hg : IsPosDefForm g) (hm : IsMinForm g) :
    ∃ δ : SL(2, ℤ), IsReducedForm (slZSmul δ g) := by
  have ha := hg.1
  let Tn : ℤ → SL(2, ℤ) := fun n => ⟨!![1, n; 0, 1], by simp⟩
  have T00 : ∀ n, (Tn n) 0 0 = 1 := fun n => rfl
  have T01 : ∀ n, (Tn n) 0 1 = n := fun n => rfl
  have T10 : ∀ n, (Tn n) 1 0 = 0 := fun n => rfl
  have T11 : ∀ n, (Tn n) 1 1 = 1 := fun n => rfl
  set n : ℤ := ⌈(g.b - g.a) / (2 * g.a)⌉ with hn
  set g1 := slZSmul (Tn n) g with hg1
  have a1 : g1.a = g.a := by rw [hg1, slZSmul_a, T10, T11]; simp
  have b1 : g1.b = g.b - 2 * g.a * n := by
    rw [hg1, slZSmul_b, T00, T01, T10, T11]; simp
  have hm1 : IsMinForm g1 := by
    intro x y hc
    obtain ⟨u, v, huv, e⟩ := exists_eval_eq_of_coprime (Tn n) g hc
    rw [a1, hg1, e]
    exact hm u v huv
  have hc1 : g1.a ≤ g1.c := by
    have := hm1 0 1 ⟨0, 1, by simp⟩
    simpa using this
  have n1 : (g.b - g.a) / (2 * g.a) ≤ n := Int.le_ceil _
  have n2 : (n : ℝ) < (g.b - g.a) / (2 * g.a) + 1 := Int.ceil_lt_add_one _
  rw [div_le_iff₀ (by linarith)] at n1
  have n2' : (n : ℝ) * (2 * g.a) < g.b + g.a := by
    have h3 : (n : ℝ) < (g.b + g.a) / (2 * g.a) := by
      calc (n : ℝ) < _ := n2
        _ = _ := by field_simp; ring
    exact (lt_div_iff₀ (by linarith)).1 h3
  have lo : -g1.a < g1.b := by rw [a1, b1]; nlinarith
  have hi : g1.b ≤ g1.a := by rw [a1, b1]; nlinarith
  rcases hc1.lt_or_eq with hlt | heq
  · exact ⟨Tn n, Or.inl ⟨lo, hi, hlt⟩⟩
  · by_cases hb : 0 ≤ g1.b
    · exact ⟨Tn n, Or.inr ⟨hb, hi, heq⟩⟩
    · refine ⟨ModularGroup.S * Tn n, ?_⟩
      rw [slZSmul_mul, ← hg1]
      have S00 : (ModularGroup.S : SL(2, ℤ)) 0 0 = 0 := by simp [ModularGroup.S]
      have S01 : (ModularGroup.S : SL(2, ℤ)) 0 1 = -1 := by simp [ModularGroup.S]
      have S10 : (ModularGroup.S : SL(2, ℤ)) 1 0 = 1 := by simp [ModularGroup.S]
      have S11 : (ModularGroup.S : SL(2, ℤ)) 1 1 = 0 := by simp [ModularGroup.S]
      have sa : (slZSmul ModularGroup.S g1).a = g1.c := by
        rw [slZSmul_a, S10, S11]; simp
      have sb : (slZSmul ModularGroup.S g1).b = -g1.b := by
        rw [slZSmul_b, S00, S01, S10, S11]; simp
      have sc : (slZSmul ModularGroup.S g1).c = g1.a := by
        rw [slZSmul_c, S00, S01]; simp
      right
      rw [sa, sb, sc]
      refine ⟨by linarith, by linarith, heq.symm⟩

end Aux3

/-- **Milne, Aside 2.15.** Every positive definite real binary quadratic form is `SL₂(ℤ)`-equivalent to a reduced
form. -/
@[kb "milne2017mf" "Aside 2.15: every definite form is equivalent to a reduced form, pdf p. 34"]
theorem exists_slZSmul_isReducedForm {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) :
    ∃ γ : SL(2, ℤ), IsReducedForm (slZSmul γ f) := by
  obtain ⟨γ, hγ⟩ := exists_isMinForm hf
  obtain ⟨δ, hδ⟩ := exists_reduced_of_min (posDef_slZSmul hf γ) hγ
  exact ⟨δ * γ, by rw [slZSmul_mul]; exact hδ⟩

section Aux2

lemma slZSmul_inv_slZSmul (γ : SL(2, ℤ)) (f : BinaryQuadraticForm ℝ) :
    slZSmul γ⁻¹ (slZSmul γ f) = f := by
  rw [← slZSmul_mul, inv_mul_cancel, slZSmul_one]

lemma a_eq_of_reduced {f g : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) (hfr : IsReducedForm f)
    (hgr : IsReducedForm g) {γ : SL(2, ℤ)} (h : slZSmul γ f = g) : g.a = f.a := by
  have hg : IsPosDefForm g := h ▸ posDef_slZSmul hf γ
  have h1 : f.a ≤ g.a := by
    rw [← h, slZSmul_a_eq]
    exact reduced_a_le_eval hfr hf.1 (vec_ne_zero γ)
  have h2 : g.a ≤ f.a := by
    have e : f = slZSmul γ⁻¹ g := by rw [← h, slZSmul_inv_slZSmul]
    rw [e, slZSmul_a_eq]
    exact reduced_a_le_eval hgr hg.1 (vec_ne_zero γ⁻¹)
  exact le_antisymm h2 h1

lemma eq_of_lt_aux {f g : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) (hfr : IsReducedForm f)
    (hgr : IsReducedForm g) (hlt : f.a < f.c) {γ : SL(2, ℤ)} (h : slZSmul γ f = g) : f = g := by
  have hg : IsPosDefForm g := h ▸ posDef_slZSmul hf γ
  have ha : g.a = f.a := a_eq_of_reduced hf hfr hgr h
  have hγ10 : γ 1 0 = 0 := by
    by_contra hne
    have := reduced_c_le_eval hfr hf.1 (x := γ 1 1) (y := -γ 1 0) (by simpa using hne)
    have e : g.a = f.eval ((γ 1 1 : ℤ) : ℝ) ((-γ 1 0 : ℤ) : ℝ) := by rw [← h, slZSmul_a_eq]
    linarith
  have hd := det_SL2Z γ
  rw [hγ10] at hd
  have hk : ∃ k : ℤ, g.b = f.b - 2 * f.a * k := by
    obtain ⟨h1, h2⟩ | ⟨h1, h2⟩ := Int.eq_one_or_neg_one_of_mul_eq_one' (by linarith : γ 0 0 * γ 1 1 = 1)
    · refine ⟨γ 0 1, ?_⟩
      rw [← h, slZSmul_b, hγ10, h1, h2]
      push_cast; ring
    · refine ⟨-γ 0 1, ?_⟩
      rw [← h, slZSmul_b, hγ10, h1, h2]
      push_cast; ring
  obtain ⟨k, hk⟩ := hk
  have hfb : -f.a < f.b ∧ f.b ≤ f.a := by
    rcases hfr with ⟨h1, h2, _⟩ | ⟨_, _, h3⟩
    · exact ⟨h1, h2⟩
    · exact absurd h3 hlt.ne
  have hgb : -g.a < g.b ∧ g.b ≤ g.a := by
    rcases hgr with ⟨h1, h2, _⟩ | ⟨h1, h2, _⟩
    · exact ⟨h1, h2⟩
    · exact ⟨by linarith [hg.1], h2⟩
  have fa := hf.1
  have k1 : (k : ℝ) < 1 := by
    by_contra hc
    replace hc := not_lt.1 hc
    nlinarith [mul_le_mul_of_nonneg_left hc fa.le]
  have k2 : (-1 : ℝ) < k := by
    by_contra hc
    replace hc := not_lt.1 hc
    nlinarith [mul_le_mul_of_nonneg_left hc fa.le]
  have k0 : k = 0 := by
    have : k < 1 := by exact_mod_cast k1
    have : -1 < k := by exact_mod_cast k2
    omega
  subst k0
  have hb : g.b = f.b := by simpa using hk
  have hdisc := slZSmul_discrim γ f
  rw [h, ha, hb] at hdisc
  have hc : g.c = f.c := by nlinarith
  exact BinaryQuadraticForm.ext ha.symm hb.symm hc.symm

lemma b_nonneg_of_not_lt {h : BinaryQuadraticForm ℝ} (hr : IsReducedForm h) (h1 : ¬ h.a < h.c) :
    0 ≤ h.b ∧ h.a = h.c := by
  rcases hr with ⟨_, _, h3⟩ | ⟨h1, _, h3⟩
  · exact absurd h3 h1
  · exact ⟨h1, h3⟩

end Aux2

/-- **Milne, Aside 2.15.** Two reduced positive definite forms are equivalent if and only if they are equal. -/
@[kb "milne2017mf" "Aside 2.15: two reduced forms are equivalent iff equal, pdf p. 34"]
theorem eq_of_slZSmul_eq {f g : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) (hfr : IsReducedForm f)
    (hgr : IsReducedForm g) {γ : SL(2, ℤ)} (h : slZSmul γ f = g) : f = g := by
  have hg : IsPosDefForm g := h ▸ posDef_slZSmul hf γ
  have ha : g.a = f.a := a_eq_of_reduced hf hfr hgr h
  by_cases h1 : f.a < f.c
  · exact eq_of_lt_aux hf hfr hgr h1 h
  by_cases h2 : g.a < g.c
  · exact (eq_of_lt_aux hg hgr hfr h2 (γ := γ⁻¹) (by rw [← h, slZSmul_inv_slZSmul])).symm
  obtain ⟨hfb, hfc⟩ := b_nonneg_of_not_lt hfr h1
  obtain ⟨hgb, hgc⟩ := b_nonneg_of_not_lt hgr h2
  have hdisc := slZSmul_discrim γ f
  rw [h] at hdisc
  have hb : g.b = f.b := by
    have : g.b ^ 2 = f.b ^ 2 := by
      rw [← hgc, ha, ← hfc] at hdisc
      nlinarith
    nlinarith [sq_nonneg (g.b - f.b), sq_nonneg (g.b + f.b)]
  have hc : g.c = f.c := by rw [← hgc, ← hfc, ha]
  exact BinaryQuadraticForm.ext ha.symm hb.symm hc.symm

/-- **Milne, Aside 2.15** (finiteness): for a nonzero discriminant there are only finitely many equivalence classes
of integral binary quadratic forms of that discriminant. Tau Ceti:
`TauCeti.BinaryQuadraticForm.finite_orbitRel_quotient_of_forall_discrim_eq`. -/
@[kb "milne2017mf" "Aside 2.15: finitely many classes of integral forms of given discriminant, pdf p. 34"]
theorem finite_classes_of_discrim {D : ℤ} (hD : D ≠ 0) :
    {Q : MulAction.orbitRel.Quotient SL(2, ℤ) (BinaryQuadraticForm ℤ) |
      ∃ f : BinaryQuadraticForm ℤ, f.discrim = D ∧ (Quotient.mk _ f : MulAction.orbitRel.Quotient _ _) = Q}.Finite := by
  obtain ⟨S, hS⟩ := BinaryQuadraticForm.exists_finset_forall_exists_smul_mem hD
  refine ((S.finite_toSet).image
    (fun f : BinaryQuadraticForm ℤ =>
      (Quotient.mk _ f : MulAction.orbitRel.Quotient SL(2, ℤ) (BinaryQuadraticForm ℤ)))).subset ?_
  rintro Q ⟨f, hf, rfl⟩
  obtain ⟨γ, hγ⟩ := hS f hf
  refine ⟨γ • f, hγ, ?_⟩
  exact Quotient.sound' ⟨γ, rfl⟩

/-- **Milne, Aside 2.15** (lattice packings): a positive definite real form `q` takes a value
`q(x, y) ≤ √((4ac - b²)/3)` at some nonzero integral vector, i.e. `γ(q) = min q / √disc ≤ 1/√3`; equality
(the densest lattice packing of the plane) holds exactly for the forms equivalent to a multiple of `x² + xy + y²`, the
hexagonal lattice. -/
@[kb "milne2017mf" "Aside 2.15: the hexagonal lattice gives the densest lattice packing, pdf p. 34"]
theorem exists_eval_le_sqrt_disc {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) :
    ∃ x y : ℤ, (x, y) ≠ (0, 0) ∧ f.eval x y ≤ Real.sqrt ((4 * f.a * f.c - f.b ^ 2) / 3) := by
  obtain ⟨γ, hγ⟩ := exists_slZSmul_isReducedForm hf
  have hg := posDef_slZSmul hf γ
  obtain ⟨hb1, hb2, hc⟩ := reduced_bounds hγ
  refine ⟨γ 1 1, -γ 1 0, vec_ne_zero γ, ?_⟩
  rw [← slZSmul_a_eq γ f]
  have hd := slZSmul_discrim γ f
  have e : 4 * f.a * f.c - f.b ^ 2 = 4 * (slZSmul γ f).a * (slZSmul γ f).c - (slZSmul γ f).b ^ 2 := by
    linarith
  rw [e]
  refine (Real.le_sqrt' hg.1).2 ?_
  nlinarith [mul_nonneg (show 0 ≤ (slZSmul γ f).b + (slZSmul γ f).a by linarith)
    (show 0 ≤ (slZSmul γ f).a - (slZSmul γ f).b by linarith), mul_nonneg hg.1.le (sub_nonneg.2 hc)]

/-- **Milne, Aside 2.15** (equality case): the minimum of `q` over nonzero integral vectors equals
`√((4ac - b²)/3)` if and only if `q` is `SL₂(ℤ)`-equivalent to `t (x² + xy + y²)` for some `t > 0`. -/
@[kb "milne2017mf" "Aside 2.15: the extremal form 4(x^2 + xy + y^2), pdf p. 34"]
theorem min_eq_sqrt_disc_iff {f : BinaryQuadraticForm ℝ} (hf : IsPosDefForm f) :
    ((∀ x y : ℤ, (x, y) ≠ (0, 0) → Real.sqrt ((4 * f.a * f.c - f.b ^ 2) / 3) ≤ f.eval x y)) ↔
      ∃ (t : ℝ) (γ : SL(2, ℤ)), 0 < t ∧ slZSmul γ f = ⟨t, t, t⟩ := by
  constructor
  · intro hmin
    obtain ⟨γ, hγ⟩ := exists_slZSmul_isReducedForm hf
    have hg := posDef_slZSmul hf γ
    obtain ⟨hb1, hb2, hc⟩ := reduced_bounds hγ
    have h1 := hmin _ _ (vec_ne_zero γ)
    rw [← slZSmul_a_eq γ f] at h1
    have hd := slZSmul_discrim γ f
    have e : 4 * f.a * f.c - f.b ^ 2 =
        4 * (slZSmul γ f).a * (slZSmul γ f).c - (slZSmul γ f).b ^ 2 := by linarith
    rw [e] at h1
    have h2 := (Real.sqrt_le_iff.1 h1).2
    set g := slZSmul γ f with hgdef
    have ha := hg.1
    have hca : g.c = g.a := by
      nlinarith [mul_nonneg (show 0 ≤ g.b + g.a by linarith) (show 0 ≤ g.a - g.b by linarith),
        mul_nonneg ha.le (sub_nonneg.2 hc)]
    have hb : g.b = g.a := by
      have hb0 : 0 ≤ g.b := (b_nonneg_of_not_lt hγ (by rw [hca]; exact lt_irrefl _)).1
      nlinarith [mul_nonneg (show 0 ≤ g.b + g.a by linarith) (show 0 ≤ g.a - g.b by linarith),
        mul_nonneg ha.le (sub_nonneg.2 hc)]
    refine ⟨g.a, γ, ha, ?_⟩
    exact BinaryQuadraticForm.ext rfl hb hca
  · rintro ⟨t, γ, ht, h⟩ x y hxy
    have e : f = slZSmul γ⁻¹ (⟨t, t, t⟩ : BinaryQuadraticForm ℝ) := by
      rw [← h, slZSmul_inv_slZSmul]
    have hdisc := slZSmul_discrim γ f
    rw [h] at hdisc
    have hs : Real.sqrt ((4 * f.a * f.c - f.b ^ 2) / 3) = t := by
      have : (4 * f.a * f.c - f.b ^ 2) / 3 = t ^ 2 := by simp only at hdisc; nlinarith
      rw [this, Real.sqrt_sq ht.le]
    rw [hs]
    have hr : IsReducedForm (⟨t, t, t⟩ : BinaryQuadraticForm ℝ) :=
      Or.inr ⟨ht.le, le_rfl, rfl⟩
    have := reduced_a_le_eval hr ht (transform_ne_zero γ⁻¹ hxy)
    rw [e, slZSmul_eval]
    exact this

/-! ### Example 2.23 and Exercise 2.24 -/

/-- **Milne, Example 2.23.** `(Γ(1) : Γ(N)) = N³ ∏_{p ∣ N} (1 - p⁻²)`. From `ModularFormsKB.Miyake.index_Gamma` and
`ModularFormsKB.Miyake.card_SL2_ZMod`. -/
@[kb "milne2017mf" "Example 2.23: index of Gamma(N), pdf p. 38"]
theorem index_Gamma_eq (N : ℕ) [NeZero N] :
    ((Gamma N).index : ℚ) = N ^ 3 * ∏ p ∈ N.primeFactors, (1 - 1 / (p : ℚ) ^ 2) := by
  rw [Miyake.index_Gamma, Miyake.card_SL2_ZMod]

/-- **Milne, Example 2.23.** `μ_N = (Γ̄(1) : Γ̄(N)) = (Γ(1) : Γ(N))/2` for `N > 2`, where `Γ̄(N)` is the image of
`Γ(N)` in `Γ(1)/{±I}`, i.e. the index of `±Γ(N)`. Restates `ModularFormsKB.Miyake.index_adjoinNegOne_Gamma`. -/
@[kb "milne2017mf" "Example 2.23: index of the image of Gamma(N) in Gamma(1)/{±I}, pdf p. 38"]
theorem index_adjoinNegOne_Gamma_eq {N : ℕ} (hN : 2 < N) :
    ((Miyake.adjoinNegOne (Gamma N)).index : ℚ) = ((Gamma N).index : ℚ) / 2 := by
  have : NeZero N := ⟨by omega⟩
  rw [Miyake.index_adjoinNegOne_Gamma hN, index_Gamma_eq]
  ring

/-- **Milne, Example 2.23** (`N = 2`): `(Γ̄(1) : Γ̄(2)) = 6`. Restates
`ModularFormsKB.Miyake.index_adjoinNegOne_Gamma_two`. -/
@[kb "milne2017mf" "Example 2.23: the case N = 2, pdf p. 38"]
theorem index_adjoinNegOne_Gamma_two_eq : (Miyake.adjoinNegOne (Gamma 2)).index = 6 :=
  Miyake.index_adjoinNegOne_Gamma_two

/-- **Milne, Exercise 2.24** (consequence): for `N ≥ 2` the number of inequivalent cusps of `Γ(N)` is `μ_N / N`, with
`μ_N = (Γ̄(1) : Γ̄(N))`. From `ModularFormsKB.Miyake.card_cuspOrbits_Gamma` and `card_cuspOrbits_Gamma_two`. -/
@[kb "milne2017mf" "Exercise 2.24: Gamma(N) has mu_N / N cusps, pdf p. 39"]
theorem card_cuspOrbits_Gamma_eq {N : ℕ} (hN : 2 ≤ N) :
    (Nat.card (CuspOrbits (Gamma N : Subgroup (GL (Fin 2) ℝ))) : ℚ) =
      ((Miyake.adjoinNegOne (Gamma N)).index : ℚ) / N := by
  rcases Nat.lt_or_ge N 3 with h | h
  · have : N = 2 := by omega
    subst this
    rw [Miyake.card_cuspOrbits_Gamma_two, Miyake.index_adjoinNegOne_Gamma_two]
    norm_num
  · have hN : (N : ℚ) ≠ 0 := by positivity
    rw [Miyake.card_cuspOrbits_Gamma h, Miyake.index_adjoinNegOne_Gamma (by omega)]
    field_simp

end ModularFormsKB.Milne
