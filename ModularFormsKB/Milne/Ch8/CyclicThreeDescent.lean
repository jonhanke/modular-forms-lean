import ModularFormsKB.Milne.Ch8.CyclicThreeIndependence

/-!
# The invariant map of an elliptic curve with a cyclic subgroup of order three (towards Theorem 8.6, $N = 3$)

Let $E$ be an elliptic curve over a scheme $S$ over $\operatorname{Spec} k$, $3 \ne 0$ in $k$, and $I$ a cyclic
subgroup of order three (Tau Ceti's `IsCyclicSubgroup I 3`). Fppf-locally $I$ is generated by a point of exact order
three, and the invariant map `tMap` of `CyclicThreeChart` does not depend on the generator
(`tMap_eq_of_multiplesDivisor_eq`), so the invariant maps of the local generators agree on overlaps and descend along
the fppf cover (`CyclicTwo.exists_desc_fppf`) to the **invariant map** `cycMap hI : S ⟶ Spec k[t, (t - 27)⁻¹]`,
characterized by its values on all generator data (`cycMap_spec`). This is the argument of `CyclicTwoDescent` for
$N = 2$, with the generator now unique only up to sign.
-/

universe u

open AlgebraicGeometry CategoryTheory Limits TauCeti.AlgebraicGeometry MonoidalCategory MonObj
  ModularFormsKB.Milne.LevelTwoChart

noncomputable section

namespace ModularFormsKB.Milne.CyclicThree

open CyclicTwo

variable {k : Type u} [Field k] (h3 : ((3 : ℕ) : k) ≠ 0)
  {S : Scheme.{u}} (p : S ⟶ Spec (CommRingCat.of k)) {E : EllipticCurveGeom S}
  {I : E.carrier.IdealSheafData}

variable (I) in
/-- **Generator data** for $I$ over $b : S' \to S$: a cartesian morphism $E' \to E$ over $b$ preserving the zero
sections and a point of exact order three of $E'$ generating the inverse image of $I$. -/
structure Gen {S' : Scheme.{u}} (b : S' ⟶ S) where
  /-- The curve over `S'`. -/
  E' : EllipticCurveGeom S'
  /-- The morphism to `E`. -/
  g : E'.carrier ⟶ E.carrier
  hg : IsPullback g E'.structureMap E.structureMap b
  h0 : E'.zero ≫ g = b ≫ E.zero
  /-- The generator. -/
  P : 𝟙_ (Over S') ⟶ Over.mk E'.structureMap
  hP : E'.IsOfExactOrder P 3
  hI : I.comap g = E'.multiplesDivisor P 3

namespace Gen

variable {S' : Scheme.{u}} {b : S' ⟶ S}

/-- Pulling generator data back along $c : S'' \to S'$. -/
def pull (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : Gen I (c ≫ b) where
  E' := G.E'.baseChange c
  g := CyclicTwo.Gen.bcg G.E' c ≫ G.g
  hg := (G.E'.isPullback_baseChange c).paste_horiz G.hg
  h0 := by rw [← Category.assoc, CyclicTwo.Gen.bcg_zero, Category.assoc, G.h0, Category.assoc]
  P := EllipticCurveGeom.pointsPullback (G.E'.isPullback_baseChange c) (CyclicTwo.Gen.bcg_zero G.E' c) G.P
  hP := G.hP.pointsPullback _ _
  hI := by
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G.hI, ← Scheme.IdealSheafData.comap_comp]

theorem pull_P_left (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') :
    (G.pull c).P.left ≫ CyclicTwo.Gen.bcg G.E' c = c ≫ G.P.left :=
  EllipticCurveGeom.pointsPullback_left_comp _ _ _

theorem P3 (G : Gen I b) : G.P ^ 3 = 1 := G.hP.pow_eq_one

include h3 in
theorem P0 (G : Gen I b) (q : S' ⟶ Spec (CommRingCat.of k)) : ∀ s, G.P.left s ≠ G.E'.zero s :=
  ne_zero_one (natCast_ne_zero_residue h3 q) G.hP

/-- The invariant map of generator data. -/
def t (G : Gen I b) : S' ⟶ Spec (CommRingCat.of (TRing k)) :=
  tMap (b ≫ p) G.P3 (G.P0 h3 (b ≫ p))

theorem t_pull (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : (G.pull c).t h3 p = c ≫ G.t h3 p :=
  tMap_comp (b ≫ p) ((c ≫ b) ≫ p) G.P3 (G.P0 h3 (b ≫ p)) (G.pull c).P3 ((G.pull c).P0 h3 ((c ≫ b) ≫ p))
    (G.E'.isPullback_baseChange c) (CyclicTwo.Gen.bcg_zero G.E' c) (G.pull_P_left c)
    (Category.assoc _ _ _).symm

/-- **The invariant map does not depend on the generator data.** -/
theorem t_eq {b' : S' ⟶ S} (G : Gen I b) (G' : Gen I b') (hb : b = b') : G.t h3 p = G'.t h3 p := by
  subst hb
  have hk := EllipticCurveGeom.isPullback_baseChangeLift G'.hg G.hg (Category.id_comp b)
  have h0k := EllipticCurveGeom.zero_baseChangeLift G'.hg G.hg.toCommSq (Category.id_comp b) G'.h0 G.h0
  set Q := EllipticCurveGeom.pointsPullback hk h0k G'.P
  have hQ : G.E'.IsOfExactOrder Q 3 := G'.hP.pointsPullback hk h0k
  have hdiv : G.E'.multiplesDivisor G.P 3 = G.E'.multiplesDivisor Q 3 := by
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G'.hI, ← Scheme.IdealSheafData.comap_comp,
      EllipticCurveGeom.baseChangeLift_fst, G.hI]
  have hpt : Q.left ≫ EllipticCurveGeom.baseChangeLift G'.hg G.hg.toCommSq (Category.id_comp b) =
      𝟙 S' ≫ G'.P.left := EllipticCurveGeom.pointsPullback_left_comp _ _ _
  have e1 := tMap_comp (b ≫ p) (b ≫ p) G'.P3 (G'.P0 h3 (b ≫ p)) hQ.pow_eq_one
    (ne_zero_one (natCast_ne_zero_residue h3 (b ≫ p)) hQ) hk h0k hpt (Category.id_comp _)
  rw [Category.id_comp] at e1
  have e2 := tMap_eq_of_multiplesDivisor_eq (natCast_ne_zero_residue h3 (b ≫ p)) (b ≫ p) G.hP hQ hdiv
  change tMap _ _ _ = tMap _ _ _
  rw [← e1, e2]

/-- Transporting generator data along an equality of base maps. -/
def cast (G : Gen I b) {b' : S' ⟶ S} (h : b = b') : Gen I b' := h ▸ G

theorem cast_t (G : Gen I b) {b' : S' ⟶ S} (h : b = b') : (G.cast h).t h3 p = G.t h3 p := by
  subst h; rfl

end Gen

/-- Generator data for $I' = g^{-1} I$ over $c$, composed with a cartesian morphism $g : E' \to E$ over $b$, are
generator data for $I$ over $c \circ b$. -/
def Gen.push {S' : Scheme.{u}} {E' : EllipticCurveGeom S'} {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S}
    (hg : IsPullback g E'.structureMap E.structureMap b) (h0 : E'.zero ≫ g = b ≫ E.zero)
    {S'' : Scheme.{u}} {c : S'' ⟶ S'} (G : Gen (I.comap g) c) : Gen I (c ≫ b) where
  E' := G.E'
  g := G.g ≫ g
  hg := G.hg.paste_horiz hg
  h0 := by rw [reassoc_of% G.h0, h0, Category.assoc]
  P := G.P
  hP := G.hP
  hI := by rw [Scheme.IdealSheafData.comap_comp, G.hI]

/-! ### The invariant map of a cyclic subgroup of order three -/

include h3 in
theorem exists_cycMap (hI : E.IsCyclicSubgroup I 3) :
    ∃ φ : S ⟶ Spec (CommRingCat.of (TRing k)),
      ∀ {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen I b), b ≫ φ = G.t h3 p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have hG : ∀ i, Nonempty (Gen I (𝒰.f i)) := fun i ↦ by
    obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
    exact ⟨⟨E', g, hg, h0, P, hP, hIP⟩⟩
  let G : ∀ i, Gen I (𝒰.f i) := fun i ↦ (hG i).some
  obtain ⟨φ, hφ⟩ := exists_desc_fppf 𝒰 (fun i ↦ (G i).t h3 p) fun i j ↦ by
    rw [← Gen.t_pull, ← Gen.t_pull]
    exact Gen.t_eq h3 p _ _ pullback.condition
  refine ⟨φ, fun {S'} b G' ↦ ?_⟩
  refine hom_ext_fppf (𝒰.pullback₁ b) fun (i : 𝒰.I₀) ↦ ?_
  change pullback.fst b (𝒰.f i) ≫ b ≫ φ = pullback.fst b (𝒰.f i) ≫ G'.t h3 p
  rw [pullback.condition_assoc, hφ i, ← Gen.t_pull, ← Gen.t_pull]
  exact Gen.t_eq h3 p _ _ pullback.condition.symm

/-- **The invariant map** of an elliptic curve with a cyclic subgroup of order three. -/
def cycMap (hI : E.IsCyclicSubgroup I 3) : S ⟶ Spec (CommRingCat.of (TRing k)) :=
  (exists_cycMap h3 p hI).choose

theorem cycMap_spec (hI : E.IsCyclicSubgroup I 3) {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen I b) :
    b ≫ cycMap h3 p hI = G.t h3 p :=
  (exists_cycMap h3 p hI).choose_spec b G

theorem cycMap_specStructure (hI : E.IsCyclicSubgroup I 3) :
    cycMap h3 p hI ≫ specStructure k (TRing k) = p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  rw [reassoc_of% cycMap_spec h3 p hI _ G]
  exact tMap_specStructure _ G.P3 (G.P0 h3 (𝒰.f i ≫ p))

/-- **Naturality of the invariant map** along cartesian morphisms. -/
theorem cycMap_comp {S' : Scheme.{u}} (p' : S' ⟶ Spec (CommRingCat.of k)) {E' : EllipticCurveGeom S'}
    {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S} (hg : IsPullback g E'.structureMap E.structureMap b)
    (h0 : E'.zero ≫ g = b ≫ E.zero) (hp : b ≫ p = p') (hI : E.IsCyclicSubgroup I 3)
    (hI' : E'.IsCyclicSubgroup (I.comap g) 3) :
    cycMap h3 p' hI' = b ≫ cycMap h3 p hI := by
  subst hp
  obtain ⟨𝒰, h𝒰⟩ := hI'.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E'', g', hg', h0', P, hP, hIP⟩ := h𝒰 i
  let G : Gen (I.comap g) (𝒰.f i) := ⟨E'', g', hg', h0', P, hP, hIP⟩
  rw [cycMap_spec h3 _ hI' _ G, ← Category.assoc, cycMap_spec h3 p hI _ (G.push hg h0)]
  change tMap _ _ _ = tMap _ _ _
  congr 1

/-- Over an algebraically closed field, **a cyclic subgroup of order three has a generator**: generator data over the
identity. -/
theorem nonempty_gen_spec [IsAlgClosed k] {E : EllipticCurveGeom (Spec (CommRingCat.of k))}
    {I : E.carrier.IdealSheafData} (hI : E.IsCyclicSubgroup I 3) : Nonempty (Gen I (𝟙 _)) := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have : Scheme.JointlySurjective Scheme.fppfPrecoverage :=
    inferInstanceAs (Scheme.JointlySurjective (Scheme.precoverage _))
  obtain ⟨i, y0, -⟩ := 𝒰.exists_eq (IsLocalRing.closedPoint k)
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  have hprop : (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u}) (𝒰.f i) :=
    Scheme.Cover.map_prop (P := @Flat ⊓ @LocallyOfFinitePresentation) 𝒰 i
  have : LocallyOfFinitePresentation (𝒰.f i) := hprop.2
  have : JacobsonSpace (𝒰.X i) := LocallyOfFiniteType.jacobsonSpace (𝒰.f i)
  obtain ⟨y, -, hy⟩ := nonempty_inter_closedPoints (Z := Set.univ) ⟨y0, trivial⟩ isClosed_univ.isLocallyClosed
  let σ := pointOfClosedPoint (𝒰.f i) y (mem_closedPoints_iff.mp hy)
  exact ⟨(G.pull σ).cast (pointOfClosedPoint_comp _ _ _)⟩

end ModularFormsKB.Milne.CyclicThree
