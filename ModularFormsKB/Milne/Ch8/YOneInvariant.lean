import ModularFormsKB.Milne.Ch8.YOneQuotient

/-!
# The invariant of a point of exact order $N$ in $M = Y_1(N)/(\mathbb Z/N)^\times$

For a $[\Gamma_1(N)]$-structure $\alpha$ (a point $P$ of exact order $N$) on an object $X$ of `Ell/k`, the
**invariant** `tStr α : X.base ⟶ M` is the classifying map to $Y_1(N)$ followed by the quotient map
$q : Y_1(N) \to M$ (`qmap`). It is natural (`tStr_map`), unchanged by $P \mapsto gP$ (`tStr_powStr`, since
$\sigma_g \circ q = q$, `sigma_base_qmap`), and therefore depends only on the cyclic subgroup generated by $P$
(`tStr_eq_of_multiplesDivisor_eq`): another generator agrees with a unit multiple of $P$ on an open cover.
-/

universe u

open AlgebraicGeometry CategoryTheory Limits Opposite TauCeti.AlgebraicGeometry MonoidalCategory MonObj
  TauCeti.AffineInvariantQuotient

noncomputable section

namespace ModularFormsKB.Milne.YOneModuli

open CyclicN CyclicThree CyclicTwo

variable {k : Type u} [Field k] {N : ℕ} [NeZero N] [hNf : Fact (((N : ℕ) : k) ≠ 0)] [h4f : Fact (4 ≤ N)]

/-- The quotient map $q : Y_1(N) \to M$. -/
def qmap : (Y k N).base ⟶ Spec (CommRingCat.of (RG k N)) :=
  (Y k N).base.toSpecΓ ≫ projection (R k N) (ZMod N)ˣ

theorem specComap_eq (g : (ZMod N)ˣ) :
    specComap (R k N) (ZMod N)ˣ g = Spec.map (sigma hNf.out h4f.out g).base.appTop := by
  rw [specComap_def]
  rfl

/-- **The quotient map is invariant**: $\sigma_g \circ q = q$. -/
theorem sigma_base_qmap (g : (ZMod N)ˣ) : (sigma hNf.out h4f.out g).base ≫ qmap = (qmap : (Y k N).base ⟶ _) := by
  rw [qmap, ← Category.assoc, Scheme.toSpecΓ_naturality, Category.assoc, ← specComap_eq, specComap_projection]

/-- **The invariant** of a $[\Gamma_1(N)]$-structure. -/
def tStr {X : EllObj (B k)} (α : (ModuliProblem.gammaOne (B k) N).obj (op X)) :
    X.base ⟶ Spec (CommRingCat.of (RG k N)) :=
  (cls hNf.out h4f.out α).base ≫ qmap

theorem tStr_map {X X' : EllObj (B k)} (f : X' ⟶ X) (α : (ModuliProblem.gammaOne (B k) N).obj (op X)) :
    tStr ((ModuliProblem.gammaOne (B k) N).map f.op α) = f.base ≫ tStr α := by
  rw [tStr, tStr, cls_map, EllObj.comp_base, Category.assoc]

theorem tStr_powStr {X : EllObj (B k)} (g : (ZMod N)ˣ) (α : (ModuliProblem.gammaOne (B k) N).obj (op X)) :
    tStr (powStr hNf.out g α) = tStr α := by
  rw [tStr, tStr, cls_powStr, EllObj.comp_base, Category.assoc, sigma_base_qmap]

/-- The invariant is a morphism over $k$. -/
theorem tStr_specStructure {X : EllObj (B k)} (α : (ModuliProblem.gammaOne (B k) N).obj (op X)) :
    tStr α ≫ specStructure k (RG k N) = X.structureMap := by
  have h1 : projection (R k N) (ZMod N)ˣ ≫ specStructure k (RG k N) =
      Spec.map (CommRingCat.ofHom (gammaAlgHom (Y k N).structureMap)) := by
    rw [projection_def, specStructure, Spec.algebraMap, ← Spec.map_comp]
    rfl
  rw [tStr, qmap, Category.assoc, Category.assoc, h1, toSpecΓ_specMap_gammaAlgHom, EllObj.Hom.base_structureMap]

/-- The restriction of an object of `Ell/k` to an open subset of its base. -/
def restr (X : EllObj (B k)) (U : X.base.Opens) : EllObj (B k) :=
  X.baseChange (T := Over.mk (U.ι ≫ X.structureMap)) (Over.homMk U.ι)

/-- The arrow from the restriction. -/
def restrHom (X : EllObj (B k)) (U : X.base.Opens) : restr X U ⟶ X :=
  X.baseChangeHom (T := Over.mk (U.ι ≫ X.structureMap)) (Over.homMk U.ι)

theorem restrHom_base (X : EllObj (B k)) (U : X.base.Opens) : (restrHom X U).base = U.ι := rfl

/-- **The invariant depends only on the cyclic subgroup.** -/
theorem tStr_eq_of_multiplesDivisor_eq {X : EllObj (B k)} (α β : (ModuliProblem.gammaOne (B k) N).obj (op X))
    (h : X.curve.multiplesDivisor (ModuliProblem.gammaOneEquiv X α).1 N =
      X.curve.multiplesDivisor (ModuliProblem.gammaOneEquiv X β).1 N) :
    tStr β = tStr α := by
  set P := (ModuliProblem.gammaOneEquiv X α).1
  set Q := (ModuliProblem.gammaOneEquiv X β).1
  have hP : X.curve.IsOfExactOrder P N := (ModuliProblem.gammaOneEquiv X α).2
  have hQ : X.curve.IsOfExactOrder Q N := (ModuliProblem.gammaOneEquiv X β).2
  have hN' : ∀ s : X.base, (N : X.base.residueField s) ≠ 0 := fun s ↦
    X.structureMap.natCast_residueField_ne_zero (hNB hNf.out _)
  have hcl : ∀ R : 𝟙_ (Over X.base) ⟶ Over.mk X.curve.structureMap, IsClosed (Set.range R.left) := fun R ↦ by
    have := isClosedImmersion_section (EllipticCurveGeom.left_comp_structureMap R)
    exact R.left.isClosedEmbedding.isClosed_range
  refine Scheme.hom_ext_of_forall _ _ fun s ↦ ?_
  obtain ⟨a, ha, hcop, hs⟩ := exists_coprime_apply_eq hN' hP hQ h s
  let Z : Set X.base := ⋃ c ∈ (Finset.range N).erase a, Q.left ⁻¹' Set.range (P ^ (c + 1)).left
  have hZ : IsClosed Z :=
    (Finset.finite_toSet _).isClosed_biUnion fun c _ ↦ (hcl _).preimage Q.left.continuous
  let U : X.base.Opens := ⟨Zᶜ, hZ.isOpen_compl⟩
  refine ⟨U, ?_, ?_⟩
  · intro hz
    obtain ⟨c, hc, t, ht⟩ := Set.mem_iUnion₂.mp hz
    have hts := base_eq (EllipticCurveGeom.left_comp_structureMap _)
      (EllipticCurveGeom.left_comp_structureMap _) ht
    rw [hts] at ht
    obtain ⟨hca, hcN⟩ := Finset.mem_erase.mp hc
    exact pow_succ_apply_ne hN' hP (Finset.mem_range.mp hcN) ha hca s (ht.trans hs)
  · have hU : ∀ u : U, Q.left (U.ι u) = (P ^ (a + 1)).left (U.ι u) := by
      intro u
      obtain ⟨a', ha', -, hu⟩ := exists_coprime_apply_eq hN' hP hQ h (U.ι u)
      by_cases haa : a' = a
      · rw [← haa]; exact hu
      · have hmem : U.ι u ∈ Z := Set.mem_iUnion₂.mpr ⟨a', Finset.mem_erase.mpr ⟨haa, Finset.mem_range.mpr ha'⟩,
          show Q.left (U.ι u) ∈ Set.range (P ^ (a' + 1)).left from ⟨U.ι u, hu.symm⟩⟩
        exact absurd hmem u.2
    set f := restrHom X U
    have e1 := tStr_map f β
    have e2 := tStr_map f α
    set g : (ZMod N)ˣ := ZMod.unitOfCoprime (a + 1) hcop
    have hP' := hP.pointsPullback f.isPullback f.zero_total
    have hQ' := hQ.pointsPullback f.isPullback f.zero_total
    have hdiv' : (restr X U).curve.multiplesDivisor (EllipticCurveGeom.pointsPullback f.isPullback f.zero_total P) N =
        (restr X U).curve.multiplesDivisor (EllipticCurveGeom.pointsPullback f.isPullback f.zero_total Q) N := by
      rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, EllipticCurveGeom.multiplesDivisor_pointsPullback, h]
    have hN'' : ∀ u : (restr X U).base, (N : (restr X U).base.residueField u) ≠ 0 := fun u ↦
      (restr X U).structureMap.natCast_residueField_ne_zero (hNB hNf.out _)
    have : IsOpenImmersion f.total := by
      change IsOpenImmersion ((X.curve.baseChangeIso U.ι).hom ≫ pullback.fst _ U.ι)
      infer_instance
    have hginj : Function.Injective f.total := f.total.isOpenEmbedding.injective
    have hval : ∀ (R : 𝟙_ (Over X.base) ⟶ Over.mk X.curve.structureMap) (u : U),
        f.total ((EllipticCurveGeom.pointsPullback f.isPullback f.zero_total R).left u) = R.left (U.ι u) := by
      intro R u
      have e := congrArg (fun φ ↦ φ u) (EllipticCurveGeom.pointsPullback_left_comp f.isPullback f.zero_total R)
      exact e
    have hRU' : ∀ u, (EllipticCurveGeom.pointsPullback f.isPullback f.zero_total Q).left u =
        ((EllipticCurveGeom.pointsPullback f.isPullback f.zero_total P) ^ (a + 1)).left u := fun u ↦ by
      rw [← map_pow]
      exact hginj ((hval Q u).trans ((hU u).trans (hval _ u).symm))
    have hQP := eq_pow_of_forall_apply_eq hN'' hP' hQ' hdiv' ha hRU'
    have hβ : (ModuliProblem.gammaOne (B k) N).map f.op β =
        powStr hNf.out g ((ModuliProblem.gammaOne (B k) N).map f.op α) := by
      apply (ModuliProblem.gammaOneEquiv _).injective
      apply Subtype.ext
      rw [powStr_point, ModuliProblem.gammaOneEquiv_map, ModuliProblem.gammaOneEquiv_map]
      change EllipticCurveGeom.pointsPullback f.isPullback f.zero_total Q = _
      rw [hQP, ZMod.coe_unitOfCoprime, ZMod.val_natCast, ← pow_eq_pow_mod hP']
    exact e1.symm.trans ((congrArg tStr hβ).trans ((tStr_powStr _ _).trans e2))

end ModularFormsKB.Milne.YOneModuli
