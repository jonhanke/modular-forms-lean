import ModularFormsKB.Milne.Ch8.YOneInvariant

/-!
# The invariant map of a cyclic subgroup of order $N \ge 4$ (towards Theorem 8.6)

Let $E$ be an elliptic curve over a scheme $S$ over $k$ ($N \ge 4$ invertible in $k$) and $I$ a cyclic subgroup of
order $N$. Fppf-locally $I$ is generated by a point of exact order $N$, whose invariant in $M = Y_1(N)/G$ (`tStr`)
does not depend on the generator (`tStr_eq_of_multiplesDivisor_eq`); so the local invariants descend along the fppf
cover (`CyclicTwo.exists_desc_fppf`) to the **invariant map** `cycMap hI : S ⟶ M` (`cycMap_spec`), over $k$
(`cycMap_specStructure`) and natural (`cycMap_comp`). Over $k$ itself a cyclic subgroup has a generator
(`nonempty_gen_spec`). The argument is that of `CyclicThreeDescent`.
-/

universe u

open AlgebraicGeometry CategoryTheory Limits Opposite TauCeti.AlgebraicGeometry MonoidalCategory MonObj
  TauCeti.AffineInvariantQuotient ModularFormsKB.Milne.LevelTwoChart

noncomputable section

namespace ModularFormsKB.Milne.YOneModuli

open CyclicN CyclicThree CyclicTwo

variable {k : Type u} [Field k] {N : ℕ} [NeZero N] [hNf : Fact (((N : ℕ) : k) ≠ 0)] [h4f : Fact (4 ≤ N)]
  {S : Scheme.{u}} (p : S ⟶ B k) {E : EllipticCurveGeom S} {I : E.carrier.IdealSheafData}

variable (N I) in
/-- **Generator data** for $I$ over $b : S' \to S$. -/
structure Gen {S' : Scheme.{u}} (b : S' ⟶ S) where
  /-- The curve over `S'`. -/
  E' : EllipticCurveGeom S'
  /-- The morphism to `E`. -/
  g : E'.carrier ⟶ E.carrier
  hg : IsPullback g E'.structureMap E.structureMap b
  h0 : E'.zero ≫ g = b ≫ E.zero
  /-- The generator. -/
  P : 𝟙_ (Over S') ⟶ Over.mk E'.structureMap
  hP : E'.IsOfExactOrder P N
  hI : I.comap g = E'.multiplesDivisor P N

/-- The object of `Ell/k` of a curve over a $k$-scheme. -/
abbrev ellOf {T : Scheme.{u}} (q : T ⟶ B k) (E' : EllipticCurveGeom T) : EllObj (B k) := ⟨T, q, E'⟩

/-- The structure of a point of exact order $N$. -/
abbrev strOf {T : Scheme.{u}} (q : T ⟶ B k) {E' : EllipticCurveGeom T} (P : 𝟙_ (Over T) ⟶ Over.mk E'.structureMap)
    (hP : E'.IsOfExactOrder P N) : (ModuliProblem.gammaOne (B k) N).obj (op (ellOf q E')) :=
  (ModuliProblem.gammaOneEquiv (ellOf q E')).symm ⟨P, hP⟩

/-- The invariant of a point of exact order $N$ on a curve over a $k$-scheme. -/
abbrev tPt {T : Scheme.{u}} (q : T ⟶ B k) {E' : EllipticCurveGeom T} (P : 𝟙_ (Over T) ⟶ Over.mk E'.structureMap)
    (hP : E'.IsOfExactOrder P N) : T ⟶ Spec (CommRingCat.of (RG k N)) :=
  tStr (strOf q P hP)

/-- **Naturality of `tPt`** along a cartesian morphism carrying the points to each other. -/
theorem tPt_comp {T T' : Scheme.{u}} (q : T ⟶ B k) (q' : T' ⟶ B k) {E₁ : EllipticCurveGeom T}
    {E₂ : EllipticCurveGeom T'} {g : E₂.carrier ⟶ E₁.carrier} {b : T' ⟶ T}
    (hg : IsPullback g E₂.structureMap E₁.structureMap b) (h0 : E₂.zero ≫ g = b ≫ E₁.zero) (hq : b ≫ q = q')
    (P : 𝟙_ (Over T) ⟶ Over.mk E₁.structureMap) (hP : E₁.IsOfExactOrder P N) :
    tPt q' (EllipticCurveGeom.pointsPullback hg h0 P) (hP.pointsPullback hg h0) = b ≫ tPt q P hP := by
  let F : ellOf q' E₂ ⟶ ellOf q E₁ :=
    { base := b
      base_structureMap := hq
      total := g
      isPullback := hg
      zero_total := h0 }
  have := tStr_map F (strOf q P hP)
  exact this

namespace Gen

variable {S' : Scheme.{u}} {b : S' ⟶ S}

/-- Pulling generator data back along $c : S'' \to S'$. -/
def pull (G : Gen N I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : Gen N I (c ≫ b) where
  E' := G.E'.baseChange c
  g := CyclicTwo.Gen.bcg G.E' c ≫ G.g
  hg := (G.E'.isPullback_baseChange c).paste_horiz G.hg
  h0 := by rw [← Category.assoc, CyclicTwo.Gen.bcg_zero, Category.assoc, G.h0, Category.assoc]
  P := EllipticCurveGeom.pointsPullback (G.E'.isPullback_baseChange c) (CyclicTwo.Gen.bcg_zero G.E' c) G.P
  hP := G.hP.pointsPullback _ _
  hI := by
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G.hI, ← Scheme.IdealSheafData.comap_comp]

/-- The invariant map of generator data. -/
def t (G : Gen N I b) : S' ⟶ Spec (CommRingCat.of (RG k N)) := tPt (b ≫ p) G.P G.hP

theorem t_pull (G : Gen N I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : (G.pull c).t p = c ≫ G.t p :=
  tPt_comp (b ≫ p) ((c ≫ b) ≫ p) (G.E'.isPullback_baseChange c) (CyclicTwo.Gen.bcg_zero G.E' c)
    (Category.assoc _ _ _).symm G.P G.hP

/-- **The invariant map does not depend on the generator data.** -/
theorem t_eq {b' : S' ⟶ S} (G : Gen N I b) (G' : Gen N I b') (hb : b = b') : G.t p = G'.t p := by
  subst hb
  have hk := EllipticCurveGeom.isPullback_baseChangeLift G'.hg G.hg (Category.id_comp b)
  have h0k := EllipticCurveGeom.zero_baseChangeLift G'.hg G.hg.toCommSq (Category.id_comp b) G'.h0 G.h0
  have hQ := G'.hP.pointsPullback hk h0k
  have hdiv : G.E'.multiplesDivisor G.P N =
      G.E'.multiplesDivisor (EllipticCurveGeom.pointsPullback hk h0k G'.P) N := by
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G'.hI, ← Scheme.IdealSheafData.comap_comp,
      EllipticCurveGeom.baseChangeLift_fst, G.hI]
  have e1 := tPt_comp (b ≫ p) (b ≫ p) hk h0k (Category.id_comp _) G'.P G'.hP
  rw [Category.id_comp] at e1
  have e2 := tStr_eq_of_multiplesDivisor_eq (strOf (b ≫ p) G.P G.hP) (strOf (b ≫ p) _ hQ)
    (by simpa using hdiv)
  change tPt _ _ _ = tPt _ _ _
  rw [← e1]
  exact e2.symm

/-- Transporting generator data along an equality of base maps. -/
def cast (G : Gen N I b) {b' : S' ⟶ S} (h : b = b') : Gen N I b' := h ▸ G

end Gen

/-- Generator data for $g^{-1} I$ over $c$, composed with a cartesian morphism $g$ over $b$. -/
def Gen.push {S' : Scheme.{u}} {E' : EllipticCurveGeom S'} {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S}
    (hg : IsPullback g E'.structureMap E.structureMap b) (h0 : E'.zero ≫ g = b ≫ E.zero)
    {S'' : Scheme.{u}} {c : S'' ⟶ S'} (G : Gen N (I.comap g) c) : Gen N I (c ≫ b) where
  E' := G.E'
  g := G.g ≫ g
  hg := G.hg.paste_horiz hg
  h0 := by rw [reassoc_of% G.h0, h0, Category.assoc]
  P := G.P
  hP := G.hP
  hI := by rw [Scheme.IdealSheafData.comap_comp, G.hI]

/-! ### The invariant map of a cyclic subgroup -/

theorem exists_cycMap (hI : E.IsCyclicSubgroup I N) :
    ∃ φ : S ⟶ Spec (CommRingCat.of (RG k N)),
      ∀ {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen N I b), b ≫ φ = G.t p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have hG : ∀ i, Nonempty (Gen N I (𝒰.f i)) := fun i ↦ by
    obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
    exact ⟨⟨E', g, hg, h0, P, hP, hIP⟩⟩
  let G : ∀ i, Gen N I (𝒰.f i) := fun i ↦ (hG i).some
  obtain ⟨φ, hφ⟩ := exists_desc_fppf 𝒰 (fun i ↦ (G i).t p) fun i j ↦ by
    rw [← Gen.t_pull, ← Gen.t_pull]
    exact Gen.t_eq p _ _ pullback.condition
  refine ⟨φ, fun {S'} b G' ↦ ?_⟩
  refine hom_ext_fppf (𝒰.pullback₁ b) fun (i : 𝒰.I₀) ↦ ?_
  change pullback.fst b (𝒰.f i) ≫ b ≫ φ = pullback.fst b (𝒰.f i) ≫ G'.t p
  rw [pullback.condition_assoc, hφ i, ← Gen.t_pull, ← Gen.t_pull]
  exact Gen.t_eq p _ _ pullback.condition.symm

/-- **The invariant map** of an elliptic curve with a cyclic subgroup of order $N$. -/
def cycMap (hI : E.IsCyclicSubgroup I N) : S ⟶ Spec (CommRingCat.of (RG k N)) :=
  (exists_cycMap p hI).choose

theorem cycMap_spec (hI : E.IsCyclicSubgroup I N) {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen N I b) :
    b ≫ cycMap p hI = G.t p :=
  (exists_cycMap p hI).choose_spec b G

theorem cycMap_specStructure (hI : E.IsCyclicSubgroup I N) :
    cycMap p hI ≫ specStructure k (RG k N) = p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen N I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  rw [reassoc_of% cycMap_spec p hI _ G]
  exact tStr_specStructure _

/-- **Naturality of the invariant map** along cartesian morphisms. -/
theorem cycMap_comp {S' : Scheme.{u}} (p' : S' ⟶ B k) {E' : EllipticCurveGeom S'}
    {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S} (hg : IsPullback g E'.structureMap E.structureMap b)
    (h0 : E'.zero ≫ g = b ≫ E.zero) (hp : b ≫ p = p') (hI : E.IsCyclicSubgroup I N)
    (hI' : E'.IsCyclicSubgroup (I.comap g) N) :
    cycMap p' hI' = b ≫ cycMap p hI := by
  subst hp
  obtain ⟨𝒰, h𝒰⟩ := hI'.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E'', g', hg', h0', P, hP, hIP⟩ := h𝒰 i
  let G : Gen N (I.comap g) (𝒰.f i) := ⟨E'', g', hg', h0', P, hP, hIP⟩
  rw [cycMap_spec _ hI' _ G, ← Category.assoc, cycMap_spec p hI _ (G.push hg h0)]
  change tPt _ _ _ = tPt _ _ _
  congr 1

/-- Over an algebraically closed field, **a cyclic subgroup of order $N$ has a generator**. -/
theorem nonempty_gen_spec [IsAlgClosed k] {E : EllipticCurveGeom (Spec (CommRingCat.of k))}
    {I : E.carrier.IdealSheafData} (hI : E.IsCyclicSubgroup I N) : Nonempty (Gen N I (𝟙 _)) := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have : Scheme.JointlySurjective Scheme.fppfPrecoverage :=
    inferInstanceAs (Scheme.JointlySurjective (Scheme.precoverage _))
  obtain ⟨i, y0, -⟩ := 𝒰.exists_eq (IsLocalRing.closedPoint k)
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen N I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  have hprop : (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u}) (𝒰.f i) :=
    Scheme.Cover.map_prop (P := @Flat ⊓ @LocallyOfFinitePresentation) 𝒰 i
  have : LocallyOfFinitePresentation (𝒰.f i) := hprop.2
  have : JacobsonSpace (𝒰.X i) := LocallyOfFiniteType.jacobsonSpace (𝒰.f i)
  obtain ⟨y, -, hy⟩ := nonempty_inter_closedPoints (Z := Set.univ) ⟨y0, trivial⟩ isClosed_univ.isLocallyClosed
  let σ := pointOfClosedPoint (𝒰.f i) y (mem_closedPoints_iff.mp hy)
  exact ⟨(G.pull σ).cast (pointOfClosedPoint_comp _ _ _)⟩

end ModularFormsKB.Milne.YOneModuli
