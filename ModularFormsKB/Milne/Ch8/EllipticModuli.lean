import ModularFormsKB.Milne.Ch8.Moduli
import TauCeti.AlgebraicGeometry.ModularCurve.ModuliProblem
import TauCeti.AlgebraicGeometry.ModularCurve.Gamma.Zero
import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.Geom.JInvariant
import TauCeti.AlgebraicGeometry.ModularCurve.FullLevel
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import TauCeti.AlgebraicGeometry.EllipticCurve.Scheme.FieldPoints
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.MulByInt.WeilPairing.Basic

/-!
# Milne, Chapter 8: modular curves as moduli varieties (Theorems 8.4, 8.6, 8.8, Example 8.9)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 8, pdf pp. 98–100.

## Elliptic curves over a variety

Milne's family of elliptic curves over a variety $V$ (a subvariety of $V \times \mathbb P^2$ cut out by a Weierstrass
equation with regular coefficients and nowhere vanishing discriminant) is read as Tau Ceti's elliptic curve over the
scheme $V$ (`TauCeti.AlgebraicGeometry.EllipticCurveGeom`: proper smooth of relative dimension one with a zero section,
Zariski-locally a Weierstrass model). Milne's global Weierstrass equation is a special case; over an affine base, or
Zariski-locally in general, every elliptic curve has one, so the two notions agree locally and the isomorphism classes
below are those of the scheme-theoretic notion (this is the standard reading of Milne's "can be extended in a natural
way to families").

Additional structures ("level structures") are those of a moduli problem over Katz and Mazur's category `Ell/B`
(Tau Ceti's `ModuliProblem`), with $B = \operatorname{Spec} k$. For such a problem $\mathcal P$ the moduli problem in
Milne's sense is `levelFunctor P`: a variety $V$ goes to the set of isomorphism classes of pairs $(E, s)$, $E$ an
elliptic curve over $V$ and $s \in \mathcal P(E/V)$, an isomorphism being an isomorphism of elliptic curves over the
identity of $V$ that carries the structures to each other; a regular map $W \to V$ acts by base change.

- $\mathcal E$ (elliptic curves, no structure): `ellipticFunctor`, from the trivial problem $[\Gamma(1)]$.
- $\mathcal E_{0,N}$ (pairs $(E, S)$, $S$ a cyclic subgroup of order $N$): `cyclicFunctor`, from Tau Ceti's
  $[\Gamma_0(N)]$ (`ModuliProblem.gammaZero`: finite locally free subgroup schemes of rank $N$, locally generated by a
  point of exact order $N$; for $N$ invertible on $V$ this is Milne's notion).
- $\mathcal E_N$ (pairs $(E, t)$, $t = (t_1, t_2)$ a level-$N$ structure with $e_N(t_1, t_2) = \zeta$): `levelNFunctor`.
  Level-$N$ structures are Tau Ceti's $[\Gamma(N)]$ (`ModuliProblem.gamma`: Drinfeld bases
  $(\mathbb Z/N\mathbb Z)^2 \to E(V)$ of $E[N]$; for $N$ invertible these are Milne's bases of $E[N]$). The Weil pairing
  is Tau Ceti's `TauCeti.Isogeny.weilPairing`, defined for Weierstrass curves over separably closed fields, so the
  condition $e_N(t_1, t_2) = \zeta$ is imposed fibrewise (`HasWeilPairing`): at every point $v \in V(k)$ the fibre
  $E_v$ is the curve of an elliptic Weierstrass curve $W$ over $k$ (through an arrow of `Ell/k` over $v$), and the
  images of $t_1, t_2$ in $W(k)$ (Tau Ceti's `toEllipticCurveGeomPointsMulEquiv`) have Weil pairing $\zeta$. The
  condition is invariant under isomorphism and base change (`hasWeilPairing_of_rel`, `hasWeilPairing_pull`).

## Items

- The $j$-invariant of a class (`jClass`, invariant under isomorphism, from Tau Ceti's `EllipticCurveGeom.j`) and the
  affine line $\mathbb A^1$ with its coordinate (`affineLine`, `affineLineCoordinate`).
- **Theorem 8.4** (named statement): `EllipticModuliSolution`.
- **Theorem 8.6** (named statement, over an algebraically closed field with $N$ invertible): `CyclicModuliSolution`.
  The description of the solution over $\mathbb Q$ as the canonical model $Y_0(N)_{\mathbb Q}$ with the map
  $(E, S) \mapsto (j(E), j(E/S))$ is not formalized: it needs the variant of Definition 8.1 for non-algebraically closed
  fields (Remark 8.3 (b)), the canonical model of Theorem 6.1, and quotients $E/S$ of elliptic curves over a base by
  finite subgroups, none of which is in Mathlib or Tau Ceti.
- **Theorem 8.8** (named statement, over an algebraically closed field with $N$ invertible): `LevelModuliSolution`.
  The identification with $Y(N)_{\mathbb C}$ (an analytic statement) and the good reduction of the model over
  $\mathbb Q[\zeta]$ are not formalized (no analytification of varieties, no models over rings of integers).
- **Example 8.9** (named statement, corrected): `LegendreFineModuli`. Milne says the fine moduli variety for $N = 2$ is
  $\mathbb A^1$ with the Legendre family; the Legendre cubic is singular at $\lambda = 0, 1$, and the fine moduli
  variety is $\mathbb A^1 \smallsetminus \{0, 1\}$ (see `docs/updates-and-errata.md`). The universal curve
  $Y^2Z = X(X - Z)(X - \lambda Z)$ with the points $(0 : 0 : 1)$, $(1 : 0 : 1)$ is not part of the formal statement.
-/

universe u

open AlgebraicGeometry CategoryTheory Opposite TauCeti.AlgebraicGeometry MonoidalCategory

noncomputable section

namespace ModularFormsKB.Milne

variable {k : Type u} [Field k]

/-- The object $(V, E)$ of `Ell/k` of an elliptic curve $E$ over a variety $V$. -/
abbrev Variety.ellObj (V : Variety k) (E : EllipticCurveGeom V.obj.left) : EllObj (Spec (CommRingCat.of k)) :=
  ⟨V.obj.left, V.obj.hom, E⟩

/-- A pair $(E, s)$: an elliptic curve $E$ over the variety $V$ with a $\mathcal P$-structure $s$. -/
abbrev LevelPair (P : ModuliProblem (Spec (CommRingCat.of k))) (V : Variety k) : Type (u + 1) :=
  Σ E : EllipticCurveGeom V.obj.left, P.obj (op (V.ellObj E))

namespace LevelPair

variable {P : ModuliProblem (Spec (CommRingCat.of k))} {V : Variety k}

/-- Two pairs are **isomorphic** when an isomorphism of elliptic curves over the identity of $V$ (an arrow of `Ell/k`
with identity morphism of bases; it is invertible by `EllObj.isIso_iff_isIso_base`) carries one structure to the
other. -/
def Rel (x y : LevelPair P V) : Prop :=
  ∃ f : V.ellObj x.1 ⟶ V.ellObj y.1, f.base = 𝟙 _ ∧ P.map f.op y.2 = x.2

theorem rel_refl (x : LevelPair P V) : Rel x x :=
  ⟨𝟙 _, EllObj.id_base _, by simp⟩

theorem rel_symm {x y : LevelPair P V} (h : Rel x y) : Rel y x := by
  obtain ⟨f, hf, hfy⟩ := h
  have : IsIso f := (EllObj.isIso_iff_isIso_base (f := f)).mpr (by rw [hf]; infer_instance)
  refine ⟨inv f, by rw [EllObj.inv_base]; exact IsIso.inv_eq_of_hom_inv_id (by rw [hf, Category.comp_id]), ?_⟩
  rw [← hfy, ← Functor.map_comp_apply, ← op_comp, IsIso.inv_hom_id, op_id, Functor.map_id_apply]

theorem rel_trans {x y z : LevelPair P V} (h : Rel x y) (h' : Rel y z) : Rel x z := by
  obtain ⟨f, hf, hfy⟩ := h
  obtain ⟨g, hg, hgz⟩ := h'
  refine ⟨f ≫ g, by rw [EllObj.comp_base, hf, hg, Category.comp_id], ?_⟩
  rw [op_comp, Functor.map_comp_apply, hgz, hfy]

/-- Isomorphism of pairs, as a setoid. -/
instance setoid (P : ModuliProblem (Spec (CommRingCat.of k))) (V : Variety k) : Setoid (LevelPair P V) where
  r := Rel
  iseqv := ⟨rel_refl, rel_symm, rel_trans⟩

/-- Two pairs obtained by pulling back one structure $s$ on $X$ along two arrows of `Ell/k` with the same morphism of
bases are isomorphic (both arrows are cartesian). -/
theorem rel_of_arrows {X : EllObj (Spec (CommRingCat.of k))} (s : P.obj (op X)) {E E' : EllipticCurveGeom V.obj.left}
    (a : V.ellObj E ⟶ X) (b : V.ellObj E' ⟶ X) (hab : a.base = b.base) :
    Rel (P := P) ⟨E, P.map a.op s⟩ ⟨E', P.map b.op s⟩ := by
  refine ⟨EllObj.Hom.lift b a (𝟙 _) (by rw [Category.id_comp, hab]), EllObj.Hom.lift_base _ _ _ _, ?_⟩
  change P.map _ (P.map b.op s) = P.map a.op s
  rw [← Functor.map_comp_apply, ← op_comp, EllObj.Hom.lift_comp]

/-- The arrow of `Ell/k` from the base change of $(V, E)$ along a regular map $\varphi : W \to V$. -/
def pullHom {W : Variety k} (φ : W ⟶ V) (E : EllipticCurveGeom V.obj.left) :
    W.ellObj (E.baseChange φ.hom.left) ⟶ V.ellObj E :=
  (V.ellObj E).baseChangeHom (T := W.obj) φ.hom

theorem pullHom_base {W : Variety k} (φ : W ⟶ V) (E : EllipticCurveGeom V.obj.left) :
    (pullHom φ E).base = φ.hom.left :=
  rfl

/-- **Base change** of a pair along a regular map $\varphi : W \to V$. -/
def pull {W : Variety k} (φ : W ⟶ V) (x : LevelPair P V) : LevelPair P W :=
  ⟨x.1.baseChange φ.hom.left, P.map (pullHom φ x.1).op x.2⟩

theorem pull_rel {W : Variety k} (φ : W ⟶ V) {x y : LevelPair P V} (h : Rel x y) :
    Rel (pull φ x) (pull φ y) := by
  obtain ⟨f, hf, hfy⟩ := h
  have := rel_of_arrows (P := P) y.2 (pullHom φ x.1 ≫ f) (pullHom φ y.1)
    (by rw [EllObj.comp_base, hf, Category.comp_id, pullHom_base, pullHom_base])
  simpa only [pull, op_comp, Functor.map_comp_apply, hfy] using this

end LevelPair

/-- **The moduli problem defined by a moduli problem $\mathcal P$ over `Ell/k`** (Milne, Section 8, pdf pp. 98–100):
a variety $V$ goes to the set of isomorphism classes of pairs $(E, s)$, $E$ an elliptic curve over $V$ and $s$ a
$\mathcal P$-structure on $E$; a regular map acts by base change. -/
def levelFunctor (P : ModuliProblem (Spec (CommRingCat.of k))) : (Variety k)ᵒᵖ ⥤ Type (u + 1) where
  obj V := Quotient (LevelPair.setoid P V.unop)
  map φ := TypeCat.ofHom (Quotient.map (LevelPair.pull φ.unop) fun _ _ ↦ LevelPair.pull_rel φ.unop)
  map_id V := by
    ext x
    induction x using Quotient.inductionOn with
    | h x =>
    exact Quotient.sound ⟨LevelPair.pullHom (𝟙 V.unop) x.1, rfl, rfl⟩
  map_comp {U V W} φ ψ := by
    ext x
    induction x using Quotient.inductionOn with
    | h x =>
    refine Quotient.sound ?_
    have := LevelPair.rel_of_arrows (V := W.unop) (P := P) x.2
      (LevelPair.pullHom (ψ.unop ≫ φ.unop) x.1)
      (LevelPair.pullHom ψ.unop _ ≫ LevelPair.pullHom φ.unop x.1) (by simp [LevelPair.pullHom_base])
    rw [op_comp, Functor.map_comp] at this
    exact this

variable (k) in
/-- **The moduli problem $\mathcal E$ of elliptic curves** (Milne, Section 8, pdf p. 98): $\mathcal E(V)$ is the set of
isomorphism classes of elliptic curves over $V$ (the trivial structure $[\Gamma(1)]$). -/
@[kb "milne2017mf" "Section 8, the moduli problem E of elliptic curves (pdf p. 98)"]
abbrev ellipticFunctor : (Variety k)ᵒᵖ ⥤ Type (u + 1) :=
  levelFunctor (𝟙_ (ModuliProblem (Spec (CommRingCat.of k))))

variable (k) in
/-- **The moduli problem $\mathcal E_{0,N}$** (Milne, Section 8, pdf p. 99): isomorphism classes of pairs $(E, S)$,
$E$ an elliptic curve over $V$ and $S$ a cyclic subgroup of $E$ of order $N$ (Tau Ceti's $[\Gamma_0(N)]$). -/
@[kb "milne2017mf" "Section 8, the moduli problem E_{0,N} (pdf p. 99)"]
abbrev cyclicFunctor (N : ℕ) : (Variety k)ᵒᵖ ⥤ Type (u + 1) :=
  levelFunctor (ModuliProblem.gammaZero (Spec (CommRingCat.of k)) N)

/-- **The $j$-invariant of an isomorphism class** of pairs over $V$, a regular function on $V$ (Tau Ceti's
`EllipticCurveGeom.j`, invariant under isomorphism over the identity). -/
def jClass {P : ModuliProblem (Spec (CommRingCat.of k))} {V : Variety k} :
    (levelFunctor P).obj (op V) → Γ(V.obj.left, ⊤) :=
  Quotient.lift (fun x : LevelPair P V ↦ x.1.j) fun x y ⟨f, hf, _⟩ ↦ by
    have h := EllipticCurveGeom.appTop_j_of_isPullback f.isPullback f.zero_total
    change f.base.appTop y.1.j = x.1.j at h
    rw [hf, Scheme.Hom.id_appTop] at h
    exact h.symm

variable (k) in
/-- **The affine line** $\mathbb A^1 = \operatorname{Spec} k[X]$ as a variety over $k$. -/
def affineLine : Variety k :=
  ⟨Over.mk (specStructure k (Polynomial k)),
    (isAffineVariety_spec k (isAffineAlgebra_polynomial k)).isVariety⟩

variable (k) in
/-- The coordinate $X$ of $\mathbb A^1$, a regular function on $\mathbb A^1$. -/
def affineLineCoordinate : Γ((affineLine k).obj.left, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv Polynomial.X

variable (k) in
/-- **Milne, Theorem 8.4** (named statement): over an algebraically closed field $k$, the pair $(\mathbb A^1, j)$ is a
solution to the moduli problem $\mathcal E$ of elliptic curves: there is a bijection
$\alpha : \mathcal E(k) \to \mathbb A^1(k)$ sending the class of $E$ to the point with coordinate $j(E)$, and
$(\mathbb A^1, \alpha)$ satisfies (a) and (b) of Definition 8.1. Milne states it over a perfect field $k_0$ through
Remark 8.3 (b); his proof reduces to the algebraic closure, which is the case stated here. -/
@[kb "milne2017mf" "Section 8, Theorem 8.4 (pdf p. 98)"]
structure EllipticModuliSolution [IsAlgClosed k] : Prop where
  solution : ∃ α : (ellipticFunctor k).obj (op (Variety.point k)) ≃ (Variety.point k ⟶ affineLine k),
    (∀ x, (α x).hom.left.appTop (affineLineCoordinate k) = jClass x) ∧
      IsModuliSolution (ellipticFunctor k) (affineLine k) α

variable (k) in
/-- **Milne, Theorem 8.6** (named statement; first assertion, over an algebraically closed field): if $N$ is not
divisible by the characteristic of $k$, the moduli problem $\mathcal E_{0,N}$ has a solution $(M, \alpha)$. (The
description over $\mathbb Q$ is not formalized; see the module docstring.) -/
@[kb "milne2017mf" "Section 8, Theorem 8.6 (pdf p. 100), over an algebraically closed field"]
structure CyclicModuliSolution [IsAlgClosed k] (N : ℕ) : Prop where
  solution : (N : k) ≠ 0 → ∃ (M : Variety k)
    (α : (cyclicFunctor k N).obj (op (Variety.point k)) ≃ (Variety.point k ⟶ M)),
    IsModuliSolution (cyclicFunctor k N) M α

/-! ### Level-$N$ structures with given Weil pairing -/

section LevelN

variable (N : ℕ) [NeZero N]

open Classical in
/-- The Weil pairing condition on a level-$N$ structure $s$ on the curve of an elliptic Weierstrass curve $W$ over $k$:
the points $S = s(1, 0)$, $T = s(0, 1)$ of $W(k)[N]$ satisfy $e_N(S, T) = \zeta$ (Tau Ceti's Weil pairing). -/
def WeilPairingEq [IsSepClosed k] (hN : (N : k) ≠ 0) (ζ : k) (W : WeierstrassCurve k) [W.IsElliptic]
    (s : (ModuliProblem.gamma (Spec (CommRingCat.of k)) N).obj
      (op ((Variety.point k).ellObj W.toEllipticCurveGeom))) : Prop :=
  ∀ S T : Submodule.torsionBy ℤ W.toAffine.Point (N : ℤ),
    (S : W.toAffine.Point) = (W.toEllipticCurveGeomPointsMulEquiv
      ((ModuliProblem.gammaEquiv _ s).1 (Multiplicative.ofAdd ((1 : ZMod N), (0 : ZMod N))))).toAdd →
    (T : W.toAffine.Point) = (W.toEllipticCurveGeomPointsMulEquiv
      ((ModuliProblem.gammaEquiv _ s).1 (Multiplicative.ofAdd ((0 : ZMod N), (1 : ZMod N))))).toAdd →
    (((TauCeti.Isogeny.weilPairing W N hN S T).toMul : kˣ) : k) = ζ

/-- **The Weil pairing condition** $e_N(t_1, t_2) = \zeta$ on a pair $(E, t)$ over $V$, $t$ a Drinfeld basis
$(\mathbb Z/N\mathbb Z)^2 \to E(V)$ with $t_1 = t(1, 0)$, $t_2 = t(0, 1)$ (see the module docstring): for every point
$v \in V(k)$ there are an elliptic Weierstrass curve $W$ over $k$ and an arrow of `Ell/k` from $W$ to $E$ over $v$
such that the pulled back structure satisfies `WeilPairingEq`. -/
def HasWeilPairing [IsSepClosed k] (hN : (N : k) ≠ 0) (ζ : k) {V : Variety k}
    (x : LevelPair (ModuliProblem.gamma (Spec (CommRingCat.of k)) N) V) : Prop :=
  ∀ v : Variety.point k ⟶ V, ∃ (W : WeierstrassCurve k) (_ : W.IsElliptic)
    (e : (Variety.point k).ellObj W.toEllipticCurveGeom ⟶ V.ellObj x.1), e.base = v.hom.left ∧
    WeilPairingEq N hN ζ W ((ModuliProblem.gamma _ N).map e.op x.2)

variable {N}

/-- The Weil pairing condition is invariant under isomorphism of pairs. -/
theorem hasWeilPairing_of_rel [IsSepClosed k] {hN : (N : k) ≠ 0} {ζ : k} {V : Variety k}
    {x y : LevelPair (ModuliProblem.gamma (Spec (CommRingCat.of k)) N) V} (h : LevelPair.Rel y x)
    (hx : HasWeilPairing N hN ζ x) : HasWeilPairing N hN ζ y := by
  obtain ⟨f, hf, hfx⟩ := h
  intro v
  obtain ⟨W, hW, e, he, hS⟩ := hx v
  refine ⟨W, hW, EllObj.Hom.lift f e v.hom.left (by rw [hf, Category.comp_id, he]),
    EllObj.Hom.lift_base _ _ _ _, ?_⟩
  rwa [← hfx, ← Functor.map_comp_apply, ← op_comp, EllObj.Hom.lift_comp]

/-- The Weil pairing condition is stable under base change along a regular map. -/
theorem hasWeilPairing_pull [IsSepClosed k] {hN : (N : k) ≠ 0} {ζ : k} {V W : Variety k} (φ : W ⟶ V)
    {x : LevelPair (ModuliProblem.gamma (Spec (CommRingCat.of k)) N) V} (hx : HasWeilPairing N hN ζ x) :
    HasWeilPairing N hN ζ (LevelPair.pull φ x) := by
  intro v
  obtain ⟨W', hW', e, he, hS⟩ := hx (v ≫ φ)
  have h : v.hom.left ≫ (LevelPair.pullHom φ x.1).base = e.base := by
    rw [LevelPair.pullHom_base, he]; rfl
  refine ⟨W', hW', EllObj.Hom.lift (LevelPair.pullHom φ x.1) e v.hom.left h, EllObj.Hom.lift_base _ _ _ _, ?_⟩
  have key : (ModuliProblem.gamma _ N).map (EllObj.Hom.lift (LevelPair.pullHom φ x.1) e v.hom.left h).op
      ((ModuliProblem.gamma _ N).map (LevelPair.pullHom φ x.1).op x.2) = (ModuliProblem.gamma _ N).map e.op x.2 := by
    rw [← Functor.map_comp_apply, ← op_comp, EllObj.Hom.lift_comp]
  exact key.symm ▸ hS

/-- Pairs with Weil pairing $\zeta$, a sub-setoid of the pairs with a level-$N$ structure. -/
def LevelNPair [IsSepClosed k] (hN : (N : k) ≠ 0) (ζ : k) (V : Variety k) : Type (u + 1) :=
  {x : LevelPair (ModuliProblem.gamma (Spec (CommRingCat.of k)) N) V // HasWeilPairing N hN ζ x}

instance LevelNPair.setoid [IsSepClosed k] (hN : (N : k) ≠ 0) (ζ : k) (V : Variety k) :
    Setoid (LevelNPair hN ζ V) :=
  Setoid.comap Subtype.val (LevelPair.setoid _ V)

/-- **The moduli problem $\mathcal E_N$** (Milne, Section 8, pdf p. 100): isomorphism classes of pairs $(E, t)$, $E$
an elliptic curve over $V$ and $t = (t_1, t_2)$ a level-$N$ structure on $E$ with $e_N(t_1, t_2) = \zeta$. -/
@[kb "milne2017mf" "Section 8, the moduli problem E_N (pdf p. 100)"]
def levelNFunctor [IsSepClosed k] (hN : (N : k) ≠ 0) (ζ : k) : (Variety k)ᵒᵖ ⥤ Type (u + 1) where
  obj V := Quotient (LevelNPair.setoid hN ζ V.unop)
  map φ := TypeCat.ofHom (Quotient.map (fun x ↦ ⟨LevelPair.pull φ.unop x.1, hasWeilPairing_pull φ.unop x.2⟩)
    fun _ _ h ↦ LevelPair.pull_rel φ.unop h)
  map_id V := by
    ext x
    induction x using Quotient.inductionOn with
    | h x =>
    exact Quotient.sound ⟨LevelPair.pullHom (𝟙 V.unop) x.1.1, rfl, rfl⟩
  map_comp {U V W} φ ψ := by
    ext x
    induction x using Quotient.inductionOn with
    | h x =>
    refine Quotient.sound ?_
    have := LevelPair.rel_of_arrows (V := W.unop) (P := ModuliProblem.gamma _ N) x.1.2
      (LevelPair.pullHom (ψ.unop ≫ φ.unop) x.1.1)
      (LevelPair.pullHom ψ.unop _ ≫ LevelPair.pullHom φ.unop x.1.1) (by simp [LevelPair.pullHom_base])
    rw [op_comp, Functor.map_comp] at this
    exact this

variable (k N) in
/-- **Milne, Theorem 8.8** (named statement; first assertion, over an algebraically closed field): if $N$ is invertible
in $k$ and $\zeta \in k$ is a primitive $N$-th root of $1$, the moduli problem $\mathcal E_N$ has a solution
$(M, \alpha)$. (The identification with $Y(N)_{\mathbb C}$ and the good reduction are not formalized; see the module
docstring.) -/
@[kb "milne2017mf" "Section 8, Theorem 8.8 (pdf p. 100), over an algebraically closed field"]
structure LevelModuliSolution [IsAlgClosed k] : Prop where
  solution : ∀ (hN : (N : k) ≠ 0) (ζ : k), IsPrimitiveRoot ζ N → ∃ (M : Variety k)
    (α : (levelNFunctor hN ζ).obj (op (Variety.point k)) ≃ (Variety.point k ⟶ M)),
    IsModuliSolution (levelNFunctor hN ζ) M α

end LevelN

variable (k) in
/-- The coordinate ring $k[\lambda, (\lambda(\lambda - 1))^{-1}]$ of the Legendre line
$\mathbb A^1 \smallsetminus \{0, 1\}$. -/
abbrev LegendreRing : Type u :=
  Localization.Away (Polynomial.X * (Polynomial.X - 1) : Polynomial k)

variable (k) in
/-- **Milne, Example 8.9** (named statement, corrected; see the module docstring and `docs/updates-and-errata.md`):
over an algebraically closed field of characteristic $0$, the moduli problem $\mathcal E_2$ ($\zeta = -1$) has a fine
moduli variety, isomorphic over $k$ to the Legendre line $\mathbb A^1 \smallsetminus \{0, 1\} =
\operatorname{Spec} k[\lambda, (\lambda(\lambda - 1))^{-1}]$ (Milne: $\mathbb A^1$). -/
@[kb "milne2017mf" "Section 8, Example 8.9 (pdf p. 100), corrected"]
structure LegendreFineModuli [IsAlgClosed k] [CharZero k] : Prop where
  fine : ∃ (V : Variety k) (e : V.obj.left ≅ Spec (CommRingCat.of (LegendreRing k))),
    e.hom ≫ specStructure k (LegendreRing k) = V.obj.hom ∧ ∃
    (α : (levelNFunctor (N := 2) (by norm_num) (-1 : k)).obj (op (Variety.point k)) ≃ (Variety.point k ⟶ V)),
    IsFineModuliSolution.{u, u + 1} (levelNFunctor (N := 2) (by norm_num) (-1 : k)) V α

end ModularFormsKB.Milne
