import ModularFormsKB.Milne.Ch8.CyclicTwoChart

/-!
# The invariant map of an elliptic curve with a cyclic subgroup of order two (towards Theorem 8.6, $N = 2$)

Let $E$ be an elliptic curve over a scheme $S$ over $\operatorname{Spec} k$, $2 \ne 0$ in $k$, and $I$ a cyclic
subgroup of order two (Tau Ceti's `IsCyclicSubgroup I 2`). Fppf-locally $I$ is generated by a point of exact order two,
and the generator is unique (`eq_of_multiplesDivisor_two_eq`), so the invariant maps `tMap` of the local generators
agree on overlaps and descend along the fppf cover (Mathlib: the fppf topology is subcanonical) to the **invariant map**
`cycMap hI : S ⟶ Spec k[t, (t - 4)⁻¹]`. It is characterized by its values on all generator data
(`cycMap_spec`): for every cartesian morphism $E' \to E$ over $b : S' \to S$ and every point $P'$ of exact order two of
$E'$ generating the pulled back subgroup, $b \circ \mathrm{cycMap} = \mathrm{tMap}(E', P')$.
-/

universe u

open AlgebraicGeometry CategoryTheory Limits TauCeti.AlgebraicGeometry MonoidalCategory MonObj
  ModularFormsKB.Milne.LevelTwoChart

noncomputable section

namespace ModularFormsKB.Milne.CyclicTwo

/-! ### Fppf descent of morphisms -/

section Descent

variable {S Y : Scheme.{u}} (𝒰 : Scheme.Cover.{u} Scheme.fppfPrecoverage S)

theorem isSheafFor_fppf :
    (Presieve.ofArrows 𝒰.X 𝒰.f).IsSheafFor (yoneda.obj Y) := by
  have hS := GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (J := Scheme.fppfTopology)
    (yoneda.obj Y)
  exact hS.isSheafFor _ (Precoverage.generate_mem_toGrothendieck 𝒰.mem₀)

/-- **Fppf descent of morphisms**: morphisms on the members of an fppf cover that agree on the overlaps descend. -/
theorem exists_desc_fppf (f : ∀ i, 𝒰.X i ⟶ Y)
    (hf : ∀ i j, pullback.fst (𝒰.f i) (𝒰.f j) ≫ f i = pullback.snd (𝒰.f i) (𝒰.f j) ≫ f j) :
    ∃ g : S ⟶ Y, ∀ i, 𝒰.f i ≫ g = f i := by
  obtain ⟨g, hg, -⟩ := ((Presieve.isSheafFor_arrows_iff_pullbacks _ _).mp (isSheafFor_fppf (Y := Y) 𝒰)) f
    (fun i j ↦ hf i j)
  exact ⟨g, hg⟩

/-- **Morphisms out of the base of an fppf cover are determined on the cover.** -/
theorem hom_ext_fppf {g g' : S ⟶ Y} (h : ∀ i, 𝒰.f i ≫ g = 𝒰.f i ≫ g') : g = g' := by
  obtain ⟨t, -, ht⟩ := ((Presieve.isSheafFor_arrows_iff_pullbacks _ _).mp (isSheafFor_fppf (Y := Y) 𝒰))
    (fun i ↦ 𝒰.f i ≫ g) (fun i j ↦ by
      change pullback.fst _ _ ≫ 𝒰.f i ≫ g = pullback.snd _ _ ≫ 𝒰.f j ≫ g
      rw [pullback.condition_assoc])
  exact (ht g fun _ ↦ rfl).trans (ht g' fun i ↦ (h i).symm).symm

end Descent

/-! ### Generator data -/

variable {k : Type u} [Field k] (h2 : (2 : k) ≠ 0)
  {S : Scheme.{u}} (p : S ⟶ Spec (CommRingCat.of k)) {E : EllipticCurveGeom S}
  {I : E.carrier.IdealSheafData}

include h2 in
theorem two_ne_zero_residue {X : Scheme.{u}} (q : X ⟶ Spec (CommRingCat.of k)) (s : X) :
    ((2 : ℕ) : X.residueField s) ≠ 0 := by
  intro h
  apply Ch8Counterexample.two_ne_zero_residueField (k := k) (by exact_mod_cast h2) (q s)
  apply (q.residueFieldMap s).hom.injective
  rw [map_natCast, h, map_zero]

variable (I) in
/-- **Generator data** for $I$ over $b : S' \to S$: a cartesian morphism $E' \to E$ over $b$ preserving the zero
sections and a point of exact order two of $E'$ generating the inverse image of $I$. -/
structure Gen {S' : Scheme.{u}} (b : S' ⟶ S) where
  /-- The curve over `S'`. -/
  E' : EllipticCurveGeom S'
  /-- The morphism to `E`. -/
  g : E'.carrier ⟶ E.carrier
  hg : IsPullback g E'.structureMap E.structureMap b
  h0 : E'.zero ≫ g = b ≫ E.zero
  /-- The generator. -/
  P : 𝟙_ (Over S') ⟶ Over.mk E'.structureMap
  hP : E'.IsOfExactOrder P 2
  hI : I.comap g = E'.multiplesDivisor P 2

namespace Gen

variable {S' : Scheme.{u}} {b : S' ⟶ S}

/-- The projection of a base change to the curve. -/
abbrev bcg (E' : EllipticCurveGeom S') {S'' : Scheme.{u}} (c : S'' ⟶ S') :
    (E'.baseChange c).carrier ⟶ E'.carrier :=
  (E'.baseChangeIso c).hom ≫ pullback.fst _ _

theorem bcg_zero (E' : EllipticCurveGeom S') {S'' : Scheme.{u}} (c : S'' ⟶ S') :
    (E'.baseChange c).zero ≫ bcg E' c = c ≫ E'.zero := by
  simp [bcg, E'.zero_baseChangeIso_hom_assoc]

/-- Pulling generator data back along $c : S'' \to S'$. -/
def pull (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : Gen I (c ≫ b) where
  E' := G.E'.baseChange c
  g := bcg G.E' c ≫ G.g
  hg := (G.E'.isPullback_baseChange c).paste_horiz G.hg
  h0 := by rw [← Category.assoc, bcg_zero, Category.assoc, G.h0, Category.assoc]
  P := EllipticCurveGeom.pointsPullback (G.E'.isPullback_baseChange c) (bcg_zero G.E' c) G.P
  hP := G.hP.pointsPullback _ _
  hI := by
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G.hI, ← Scheme.IdealSheafData.comap_comp]

theorem pull_P_left (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') :
    (G.pull c).P.left ≫ bcg G.E' c = c ≫ G.P.left :=
  EllipticCurveGeom.pointsPullback_left_comp _ _ _

theorem P2 (G : Gen I b) : G.P ^ 2 = 1 := G.hP.pow_eq_one

include h2 in
theorem P0 (G : Gen I b) (q : S' ⟶ Spec (CommRingCat.of k)) : ∀ s, G.P.left s ≠ G.E'.zero s := fun s ↦ by
  simpa using G.hP.pow_left_apply_ne_zero (two_ne_zero_residue h2 q s) (k := 1) one_pos one_lt_two

/-- The invariant map of generator data. -/
def t (G : Gen I b) : S' ⟶ Spec (CommRingCat.of (TRing k)) :=
  tMap h2 (b ≫ p) G.P2 (G.P0 h2 (b ≫ p))

theorem t_pull (G : Gen I b) {S'' : Scheme.{u}} (c : S'' ⟶ S') : (G.pull c).t h2 p = c ≫ G.t h2 p :=
  tMap_comp h2 (b ≫ p) ((c ≫ b) ≫ p) G.P2 (G.P0 h2 (b ≫ p)) (G.pull c).P2 ((G.pull c).P0 h2 ((c ≫ b) ≫ p))
    (G.E'.isPullback_baseChange c) (bcg_zero G.E' c) (G.pull_P_left c)
    (Category.assoc _ _ _).symm

/-- **The invariant map does not depend on the generator data.** -/
theorem t_eq {b' : S' ⟶ S} (G : Gen I b) (G' : Gen I b') (hb : b = b') : G.t h2 p = G'.t h2 p := by
  subst hb
  have hk := EllipticCurveGeom.isPullback_baseChangeLift G'.hg G.hg (Category.id_comp b)
  have h0k := EllipticCurveGeom.zero_baseChangeLift G'.hg G.hg.toCommSq (Category.id_comp b) G'.h0 G.h0
  have hQ : EllipticCurveGeom.pointsPullback hk h0k G'.P = G.P := by
    refine eq_of_multiplesDivisor_two_eq (two_ne_zero_residue h2 (b ≫ p)) (G'.hP.pointsPullback hk h0k) G.hP ?_
    rw [EllipticCurveGeom.multiplesDivisor_pointsPullback, ← G'.hI, ← Scheme.IdealSheafData.comap_comp,
      EllipticCurveGeom.baseChangeLift_fst, G.hI]
  have hpt : G.P.left ≫ EllipticCurveGeom.baseChangeLift G'.hg G.hg.toCommSq (Category.id_comp b) =
      𝟙 S' ≫ G'.P.left := by
    rw [← hQ]
    exact EllipticCurveGeom.pointsPullback_left_comp _ _ _
  have := tMap_comp h2 (b ≫ p) (b ≫ p) G'.P2 (G'.P0 h2 (b ≫ p)) G.P2 (G.P0 h2 (b ≫ p)) hk h0k hpt (Category.id_comp _)
  rw [Category.id_comp] at this
  exact this

/-- Transporting generator data along an equality of base maps. -/
def cast (G : Gen I b) {b' : S' ⟶ S} (h : b = b') : Gen I b' := h ▸ G

theorem cast_t (G : Gen I b) {b' : S' ⟶ S} (h : b = b') : (G.cast h).t h2 p = G.t h2 p := by
  subst h; rfl

end Gen

/-- Generator data for $I' = g^{-1} I$ over $c$, composed with a cartesian morphism $g : E' \to E$ over $b$, are
generator data for $I$ over $c \circ b$. -/
def Gen.push {S' : Scheme.{u}} {E' : EllipticCurveGeom S'} {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S}
    (hg : IsPullback g E'.structureMap E.structureMap b) (h0 : E'.zero ≫ g = b ≫ E.zero)
    {S'' : Scheme.{u}} {c : S'' ⟶ S'} (G : Gen (I.comap g) c) : Gen I (c ≫ b) where
  E' := G.E'
  g := G.g ≫ g
  hg := G.hg.paste_horiz hg
  h0 := by rw [reassoc_of% G.h0, h0, Category.assoc]
  P := G.P
  hP := G.hP
  hI := by rw [Scheme.IdealSheafData.comap_comp, G.hI]

/-! ### The invariant map of a cyclic subgroup of order two -/

include h2 in
theorem exists_cycMap (hI : E.IsCyclicSubgroup I 2) :
    ∃ φ : S ⟶ Spec (CommRingCat.of (TRing k)),
      ∀ {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen I b), b ≫ φ = G.t h2 p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have hG : ∀ i, Nonempty (Gen I (𝒰.f i)) := fun i ↦ by
    obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
    exact ⟨⟨E', g, hg, h0, P, hP, hIP⟩⟩
  let G : ∀ i, Gen I (𝒰.f i) := fun i ↦ (hG i).some
  obtain ⟨φ, hφ⟩ := exists_desc_fppf 𝒰 (fun i ↦ (G i).t h2 p) fun i j ↦ by
    rw [← Gen.t_pull, ← Gen.t_pull]
    exact Gen.t_eq h2 p _ _ pullback.condition
  refine ⟨φ, fun {S'} b G' ↦ ?_⟩
  refine hom_ext_fppf (𝒰.pullback₁ b) fun (i : 𝒰.I₀) ↦ ?_
  change pullback.fst b (𝒰.f i) ≫ b ≫ φ = pullback.fst b (𝒰.f i) ≫ G'.t h2 p
  rw [pullback.condition_assoc, hφ i, ← Gen.t_pull, ← Gen.t_pull]
  exact Gen.t_eq h2 p _ _ pullback.condition.symm

/-- **The invariant map** of an elliptic curve with a cyclic subgroup of order two. -/
def cycMap (hI : E.IsCyclicSubgroup I 2) : S ⟶ Spec (CommRingCat.of (TRing k)) :=
  (exists_cycMap h2 p hI).choose

theorem cycMap_spec (hI : E.IsCyclicSubgroup I 2) {S' : Scheme.{u}} (b : S' ⟶ S) (G : Gen I b) :
    b ≫ cycMap h2 p hI = G.t h2 p :=
  (exists_cycMap h2 p hI).choose_spec b G

end ModularFormsKB.Milne.CyclicTwo

namespace ModularFormsKB.Milne.CyclicTwo

variable {k : Type u} [Field k] (h2 : (2 : k) ≠ 0)
  {S : Scheme.{u}} (p : S ⟶ Spec (CommRingCat.of k)) {E : EllipticCurveGeom S}
  {I : E.carrier.IdealSheafData}

theorem cycMap_specStructure (hI : E.IsCyclicSubgroup I 2) :
    cycMap h2 p hI ≫ specStructure k (TRing k) = p := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  rw [reassoc_of% cycMap_spec h2 p hI _ G]
  exact tMap_specStructure h2 _ G.P2 (G.P0 h2 (𝒰.f i ≫ p))

/-- **Naturality of the invariant map** along cartesian morphisms. -/
theorem cycMap_comp {S' : Scheme.{u}} (p' : S' ⟶ Spec (CommRingCat.of k)) {E' : EllipticCurveGeom S'}
    {g : E'.carrier ⟶ E.carrier} {b : S' ⟶ S} (hg : IsPullback g E'.structureMap E.structureMap b)
    (h0 : E'.zero ≫ g = b ≫ E.zero) (hp : b ≫ p = p') (hI : E.IsCyclicSubgroup I 2)
    (hI' : E'.IsCyclicSubgroup (I.comap g) 2) :
    cycMap h2 p' hI' = b ≫ cycMap h2 p hI := by
  subst hp
  obtain ⟨𝒰, h𝒰⟩ := hI'.exists_cover
  refine hom_ext_fppf 𝒰 fun i ↦ ?_
  obtain ⟨E'', g', hg', h0', P, hP, hIP⟩ := h𝒰 i
  let G : Gen (I.comap g) (𝒰.f i) := ⟨E'', g', hg', h0', P, hP, hIP⟩
  rw [cycMap_spec h2 _ hI' _ G, ← Category.assoc, cycMap_spec h2 p hI _ (G.push hg h0)]
  change tMap h2 _ _ _ = tMap h2 _ _ _
  congr 1

/-- Over an algebraically closed field, **a cyclic subgroup of order two has a generator**: generator data over the
identity. -/
theorem nonempty_gen_spec [IsAlgClosed k] {E : EllipticCurveGeom (Spec (CommRingCat.of k))}
    {I : E.carrier.IdealSheafData} (hI : E.IsCyclicSubgroup I 2) : Nonempty (Gen I (𝟙 _)) := by
  obtain ⟨𝒰, h𝒰⟩ := hI.exists_cover
  have : Scheme.JointlySurjective Scheme.fppfPrecoverage :=
    inferInstanceAs (Scheme.JointlySurjective (Scheme.precoverage _))
  obtain ⟨i, y0, -⟩ := 𝒰.exists_eq (IsLocalRing.closedPoint k)
  obtain ⟨E', g, hg, h0, P, hP, hIP⟩ := h𝒰 i
  let G : Gen I (𝒰.f i) := ⟨E', g, hg, h0, P, hP, hIP⟩
  have hprop : (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u}) (𝒰.f i) :=
    Scheme.Cover.map_prop (P := @Flat ⊓ @LocallyOfFinitePresentation) 𝒰 i
  have : LocallyOfFinitePresentation (𝒰.f i) := hprop.2
  have : JacobsonSpace (𝒰.X i) := LocallyOfFiniteType.jacobsonSpace (𝒰.f i)
  obtain ⟨y, -, hy⟩ := nonempty_inter_closedPoints (Z := Set.univ) ⟨y0, trivial⟩ isClosed_univ.isLocallyClosed
  let σ := pointOfClosedPoint (𝒰.f i) y (mem_closedPoints_iff.mp hy)
  exact ⟨(G.pull σ).cast (pointOfClosedPoint_comp _ _ _)⟩

end ModularFormsKB.Milne.CyclicTwo
