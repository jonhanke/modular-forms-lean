import TauCeti.FieldTheory.FunctionField.Place.Extension.Inertia
import TauCeti.FieldTheory.FunctionField.Place.Degree
import Mathlib.FieldTheory.Finite.GaloisField

/-!
# The Frobenius in a decomposition group over a rational place

Let $F'/F_0$ be a finite Galois extension of function fields over a finite field $k$ with $q$ elements, $Q$ a place
of $F'$ over a rational place $P$ of $F_0$. The decomposition group of $Q$ maps onto the Galois group of the residue
extension (Tau Ceti, `TauCeti.Place.residueAut_surjective`), which is cyclic, generated by the Frobenius
$x \mapsto x^q$ since $\kappa(P) = k$. Hence:

- `exists_smul_eq_valuation_sub_pow_lt_one`: some $d$ with $dQ = Q$ satisfies $d x \equiv x^q \pmod Q$ for every
  $x$ regular at $Q$;
- `degree_dvd_of_forall_pow_eq_one`: if every element of $\mathrm{Gal}(F'/F_0)$ has order dividing $m$, then
  $\deg Q \mid m$ (the Frobenius has order $\deg Q = [\kappa(Q) : \kappa(P)]$).
-/

open TauCeti Module

set_option linter.unusedSectionVars false

namespace ModularFormsKB.Milne

variable {k F₀ F' : Type*} [Field k] [Field F₀] [Field F'] [Algebra k F₀] [Algebra k F'] [Algebra F₀ F']
  [IsScalarTower k F₀ F'] [Finite k] [FiniteDimensional F₀ F'] [IsGalois F₀ F']

theorem finite_residueField (hF' : IsFunctionField k F') (Q : Place k F') : Finite Q.ResidueField := by
  have := Q.finiteDimensional_residueField hF'
  exact Module.finite_of_finite k

theorem finite_residueField_restrict (hF' : IsFunctionField k F') (Q : Place k F') :
    Finite (Q.restrict k F₀).ResidueField := by
  have := finite_residueField hF' Q
  exact Finite.of_injective _ (algebraMap (Q.restrict k F₀).ResidueField Q.ResidueField).injective

theorem natCard_residueField_of_degree_eq_one {P : Place k F₀} (hP : P.degree = 1) :
    Nat.card P.ResidueField = Nat.card k :=
  (Nat.card_congr (P.residueFieldEquivOfDegreeEqOne hP).toEquiv).symm

/-- The decomposition group contains an element acting on the residue field as the Frobenius over the
residue field of the place below. -/
theorem exists_residueAut_eq_frobenius (hF' : IsFunctionField k F') (Q : Place k F') :
    letI := finite_residueField hF' Q
    haveI := finite_residueField_restrict (F₀ := F₀) hF' Q
    letI := Fintype.ofFinite (Q.restrict k F₀).ResidueField
    ∃ d : Q.integers.decompositionSubgroup F₀, Place.residueAut F₀ Q d =
      FiniteField.frobeniusAlgEquivOfAlgebraic (Q.restrict k F₀).ResidueField Q.ResidueField :=
  Place.residueAut_surjective F₀ Q _

/-- **A Frobenius element**: over a rational place, some $d$ fixing $Q$ acts on functions regular at $Q$ as
$x \mapsto x^q$ modulo $Q$. -/
theorem exists_smul_eq_valuation_sub_pow_lt_one (hF' : IsFunctionField k F') (Q : Place k F')
    (hP : (Q.restrict k F₀).degree = 1) :
    ∃ d : F' ≃ₐ[F₀] F', d • Q = Q ∧
      ∀ x ∈ Q.integers, Q.valuation (d x - x ^ Nat.card k) < 1 := by
  let := finite_residueField hF' Q
  have := finite_residueField_restrict (F₀ := F₀) hF' Q
  let := Fintype.ofFinite (Q.restrict k F₀).ResidueField
  obtain ⟨d, hd⟩ := exists_residueAut_eq_frobenius (F₀ := F₀) hF' Q
  refine ⟨d.1, ?_, fun x hx => ?_⟩
  · have hst : d.1 ∈ MulAction.stabilizer (F' ≃ₐ[F₀] F') Q := by
      rw [Place.stabilizer_eq_decompositionSubgroup]; exact d.2
    exact hst
  have hres := Place.residueAut_residue F₀ Q d ⟨x, hx⟩
  rw [hd, FiniteField.frobeniusAlgEquivOfAlgebraic_apply] at hres
  have hcard : Fintype.card (Q.restrict k F₀).ResidueField = Nat.card k := by
    rw [← Nat.card_eq_fintype_card, natCard_residueField_of_degree_eq_one hP]
  rw [hcard, ← map_pow] at hres
  have hmem : d.1 x - x ^ Nat.card k ∈ Q.integers :=
    Q.integers.sub_mem (by
      have this : d.1 ∈ MulAction.stabilizer (F' ≃ₐ[F₀] F') Q := by
        rw [Place.stabilizer_eq_decompositionSubgroup]; exact d.2
      rw [MulAction.mem_stabilizer_iff] at this
      have h2 : d.1 x ∈ (d.1 • Q).integers := by
        rw [Place.mem_integers_smul_iff]; simpa using hx
      rwa [this] at h2) (Q.integers.pow_mem hx _)
  have h0 : IsLocalRing.residue Q.integers ⟨_, hmem⟩ = 0 := by
    have : (⟨_, hmem⟩ : Q.integers) = d • (⟨x, hx⟩ : Q.integers) - ⟨x, hx⟩ ^ Nat.card k := by
      ext; rfl
    rw [this, map_sub, ← hres, sub_self]
  exact (Q.residue_eq_zero_iff_valuation_lt_one).mp h0

/-- **The degree of a place over a rational place divides the exponent of the Galois group.** -/
theorem degree_dvd_of_forall_pow_eq_one (hF' : IsFunctionField k F') {m : ℕ}
    (hm : ∀ d : F' ≃ₐ[F₀] F', d ^ m = 1) (Q : Place k F') (hP : (Q.restrict k F₀).degree = 1) :
    Q.degree ∣ m := by
  let := finite_residueField hF' Q
  have := finite_residueField_restrict (F₀ := F₀) hF' Q
  let := Fintype.ofFinite (Q.restrict k F₀).ResidueField
  obtain ⟨d, hd⟩ := exists_residueAut_eq_frobenius (F₀ := F₀) hF' Q
  have hord := FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic (Q.restrict k F₀).ResidueField
    Q.ResidueField
  have hpow : (FiniteField.frobeniusAlgEquivOfAlgebraic (Q.restrict k F₀).ResidueField
      Q.ResidueField) ^ m = 1 := by
    rw [← hd, ← map_pow]
    have : d ^ m = 1 := Subtype.ext (by simpa using hm d.1)
    rw [this, map_one]
  have hdvd := orderOf_dvd_of_pow_eq_one hpow
  rw [hord] at hdvd
  have hdeg := Place.finrank_mul_degree_eq_relativeDegree_mul_degree_restrict k F₀ Q
  rw [Module.finrank_self, one_mul, hP, mul_one] at hdeg
  rw [hdeg]
  exact hdvd

end ModularFormsKB.Milne
