import ModularFormsKB.Milne.Ch11.TateModule
import TauCeti.AlgebraicGeometry.EllipticCurve.TateModule.Galois
import TauCeti.AlgebraicGeometry.EllipticCurve.Isogeny.Hom.BaseChange
import TauCeti.NumberTheory.NumberField.Global.Orders.Basic
import Mathlib.LinearAlgebra.Center
import ModularFormsKB.Citation
/-!
# Milne, Section 12: the Tate module of an elliptic curve with complex multiplication (12.11–12.13)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 12, pdf pp. 124–125.

Let $E$ be an elliptic curve over a field $k$ with complex multiplication by an order $R$ of a quadratic imaginary
field $K$, defined over $k$: an isomorphism $i\colon R \to \mathrm{End}(E)$ (**D129**; here the explicit `i`).
Let $k^{\mathrm s}$ be a separably closed extension of $k$ and $\ell$ a prime invertible in it. Then $R$ acts on
$T_\ell E$ (through the base change of $i(a)$ to $k^{\mathrm s}$, `tateRep`) and $K\otimes\mathbb Q_\ell$ acts on
$V_\ell E = \mathbb Q_\ell \otimes_{\mathbb Z_\ell} T_\ell E$ (`cmActionV`).

*Encoding of "free of rank one".* For $\omega \in R \setminus \mathbb Z$, $\{1, \omega\}$ is a $\mathbb Q_\ell$-basis
of $K \otimes \mathbb Q_\ell$, so (as $\dim_{\mathbb Q_\ell} V_\ell E = 2$) $V_\ell E$ is free of rank one over $K\otimes
\mathbb Q_\ell$ exactly when some $v$ has $v, \omega v$ linearly independent over $\mathbb Q_\ell$; likewise $T_\ell E$
is free of rank one over $R\otimes\mathbb Z_\ell$, for $R = \mathbb Z + \mathbb Z\omega$, exactly when some $t$ makes
$t, \omega t$ a $\mathbb Z_\ell$-basis.

## Items

- **Corollary 12.11** `exists_linearIndependent_cmActionV`.
- **Remark 12.12** `SerreTateFreeTateModule` (named; Serre–Tate 1968, p. 502).
- **Proposition 12.13** `galoisRepresentation_mem_adjoin_cmActionV`: every $\sigma\in\mathrm{Gal}(k^{\mathrm s}/k)$ acts
  on $V_\ell E$ through the image of $K \otimes \mathbb Q_\ell$ (the $\mathbb Q_\ell$-algebra generated by $R$).
-/

open TauCeti TauCeti.Isogeny TauCeti.GlobalNumberFields TensorProduct
open scoped WeierstrassCurve Classical

namespace ModularFormsKB.Milne

variable {k : Type*} [Field k] (W : WeierstrassCurve k) [W.IsElliptic]
  (Ks : Type*) [Field Ks] [IsSepClosed Ks] [Algebra k Ks] (ℓ : ℕ) [Fact ℓ.Prime]
  {K : Type*} [Field K] [NumberField K] {O : NumberFieldOrder K}

/-- The action of $a \in R$ on $T_\ell E$ (over $k^{\mathrm s}$) for complex multiplication $i$ defined over $k$. -/
noncomputable def cmAction (i : O.toSubalgebra ≃+* Hom W.toAffine W.toAffine) (a : O.toSubalgebra) :
    Module.End ℤ_[ℓ] (TateModule ℓ (W⁄Ks).toAffine.Point) :=
  tateRep (W⁄Ks) ℓ ((i a).map (algebraMap k Ks))

/-- The action of $a \in R$ on $V_\ell E = \mathbb Q_\ell \otimes_{\mathbb Z_\ell} T_\ell E$ (**D126**). -/
noncomputable def cmActionV (i : O.toSubalgebra ≃+* Hom W.toAffine W.toAffine) (a : O.toSubalgebra) :
    Module.End ℚ_[ℓ] (ℚ_[ℓ] ⊗[ℤ_[ℓ]] TateModule ℓ (W⁄Ks).toAffine.Point) :=
  (cmAction W Ks ℓ i a).baseChange ℚ_[ℓ]

open Polynomial in
/-- A free rank-two endomorphism with prescribed characteristic polynomial has the prescribed trace and
determinant. -/
theorem trace_det_of_charpoly_eq {R M : Type*} [CommRing R] [Nontrivial R] [AddCommGroup M] [Module R M]
    [Module.Free R M] [Module.Finite R M] (hr : Module.finrank R M = 2) (g : Module.End R M) (a b : R)
    (h : g.charpoly = X ^ 2 - C a * X + C b) : LinearMap.trace R M g = a ∧ LinearMap.det g = b := by
  let bs := Module.finBasisOfFinrankEq R M hr
  have h1 := LinearMap.charpoly_toMatrix g bs
  rw [Matrix.charpoly_fin_two, h] at h1
  have e1 := congrArg (fun p => p.coeff 1) h1
  have e0 := congrArg (fun p => p.coeff 0) h1
  simp at e1 e0
  refine ⟨?_, ?_⟩
  · rw [LinearMap.trace_eq_matrix_trace R bs]; exact e1
  · exact e0

variable {W Ks ℓ}

/-- **Corollary 12.11** (Milne): if $E$ has complex multiplication by $R \subset K$, then $V_\ell E$ is a free $K
\otimes \mathbb Q_\ell$-module (of rank one): for every $\omega \in R \setminus \mathbb Z$ some $v \in V_\ell E$ has
$v, \omega v$ linearly independent over $\mathbb Q_\ell$ (see the module docstring for the encoding). -/
@[kb "milne2017mf" "Section 12, Cor. 12.11 (pdf p. 124)"]
theorem exists_linearIndependent_cmActionV (hℓ : (ℓ : Ks) ≠ 0)
    (i : O.toSubalgebra ≃+* Hom W.toAffine W.toAffine) (ω : O.toSubalgebra) (hω : ∀ n : ℤ, ω ≠ n) :
    ∃ v : ℚ_[ℓ] ⊗[ℤ_[ℓ]] TateModule ℓ (W⁄Ks).toAffine.Point,
      LinearIndependent ℚ_[ℓ] ![v, cmActionV W Ks ℓ i ω v] := by
  classical
  have := (W⁄Ks).free_tateModule hℓ
  have := (W⁄Ks).finite_tateModule hℓ
  by_contra hcon
  push Not at hcon
  obtain ⟨c, hc⟩ := LinearMap.exists_eq_smul_id_of_forall_notLinearIndependent hcon
  set f := (i ω).map (algebraMap k Ks) with hf
  have hT : Module.finrank ℤ_[ℓ] (TateModule ℓ (W⁄Ks).toAffine.Point) = 2 :=
    (W⁄Ks).finrank_tateModule hℓ
  have hV : Module.finrank ℚ_[ℓ] (ℚ_[ℓ] ⊗[ℤ_[ℓ]] TateModule ℓ (W⁄Ks).toAffine.Point) = 2 := by
    rw [Module.finrank_baseChange]; exact hT
  have hch := charpoly_tateRep hℓ f
  obtain ⟨ht, hd⟩ := trace_det_of_charpoly_eq hT (cmAction W Ks ℓ i ω) _ _ hch
  have h1 : (milneTrace f : ℚ_[ℓ]) = c * 2 := by
    have := LinearMap.trace_baseChange (cmAction W Ks ℓ i ω) ℚ_[ℓ]
    change LinearMap.trace ℚ_[ℓ] _ (cmActionV W Ks ℓ i ω) = _ at this
    rw [hc, ht] at this
    simp [hV] at this
    simpa [mul_comm] using this.symm
  have h2 : (f.degree : ℚ_[ℓ]) = c ^ 2 := by
    have := LinearMap.det_baseChange (A := ℚ_[ℓ]) (cmAction W Ks ℓ i ω)
    change LinearMap.det (cmActionV W Ks ℓ i ω) = _ at this
    rw [hc, hd] at this
    simp [hV] at this
    simpa using this.symm
  have h3 : (milneTrace f) ^ 2 = 4 * (f.degree : ℤ) := by
    apply Int.cast_injective (α := ℚ_[ℓ])
    push_cast
    rw [h1, h2]; ring
  have key := mul_self_sub_milneTrace_add_degree f
  rw [zsmul_eq_mul, zsmul_eq_mul] at key
  have hsq : (2 * f - (milneTrace f : Hom _ _)) * (2 * f - (milneTrace f : Hom _ _)) = 0 := by
    have : (2 * f - (milneTrace f : Hom _ _)) * (2 * f - (milneTrace f : Hom _ _)) =
        4 * (f * f - (milneTrace f : Hom _ _) * f + ((f.degree : ℤ) : Hom _ _) * 1)
          + (((milneTrace f) ^ 2 - 4 * (f.degree : ℤ) : ℤ) : Hom _ _) := by
      have hcm := (Int.cast_commute (milneTrace f) f).eq
      push_cast
      noncomm_ring
      rw [← hcm]
      abel
    rw [this, key, h3]; simp
  have hz := mul_self_eq_zero.mp hsq
  have hz' : f + f - milneTrace f • (1 : Hom _ _) = 0 := by
    rw [zsmul_one, ← two_mul]; exact hz
  have hmap1 : (1 : Hom W.toAffine W.toAffine).map (algebraMap k Ks) = 1 := by
    simp [Hom.one_def]
  have h4 : (i ω + i ω - milneTrace f • (1 : Hom W.toAffine W.toAffine)).map (algebraMap k Ks) = 0 := by
    rw [Hom.map_sub, Hom.map_add, Hom.map_zsmul, hmap1]; exact hz'
  have h5 : i ω + i ω = milneTrace f • (1 : Hom W.toAffine W.toAffine) :=
    sub_eq_zero.mp ((Hom.map_eq_zero_iff _ _).mp h4)
  have h6 : ω + ω = ((milneTrace f : ℤ) : O.toSubalgebra) :=
    i.injective (by rw [map_add, map_intCast, h5, zsmul_one])
  have h7 : (ω : K) + ω = milneTrace f := by
    exact_mod_cast congrArg Subtype.val h6
  have hq : (ω : K) = algebraMap ℚ K ((milneTrace f : ℚ) / 2) := by
    have : (ω : K) = (milneTrace f : K) / 2 := by
      rw [eq_div_iff two_ne_zero]; linear_combination h7
    rw [this]; simp
  have hint : IsIntegral ℤ ((milneTrace f : ℚ) / 2) := by
    have h8 := O.isIntegral ω
    rw [hq] at h8
    exact isIntegral_algebraMap_iff.mp h8
  obtain ⟨n, hn⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
  apply hω n
  apply Subtype.ext
  rw [hq, ← hn]
  simp

/-- **Remark 12.12** (Milne; Serre–Tate, *Good reduction of abelian varieties*, Ann. of Math. 88 (1968), p. 502
[unverified]): $T_\ell E$ is a free $R \otimes \mathbb Z_\ell$-module (of rank one): if $R = \mathbb Z + \mathbb
Z\omega$, some $t \in T_\ell E$ makes $t, \omega t$ a $\mathbb Z_\ell$-basis. Named statement. -/
@[kb "milne2017mf" "Section 12, Rem. 12.12 (pdf p. 125)"]
structure SerreTateFreeTateModule : Prop where
  free : ∀ (k : Type) [Field k] (W : WeierstrassCurve k) [W.IsElliptic] (Ks : Type) [Field Ks] [IsSepClosed Ks]
    [Algebra k Ks] (ℓ : ℕ) [Fact ℓ.Prime], (ℓ : Ks) ≠ 0 →
    ∀ (K : Type) [Field K] [NumberField K] (O : NumberFieldOrder K)
      (i : O.toSubalgebra ≃+* Hom W.toAffine W.toAffine) (ω : O.toSubalgebra),
      (∀ x : O.toSubalgebra, ∃ a b : ℤ, x = a + b * ω) →
      ∃ t : TateModule ℓ (W⁄Ks).toAffine.Point,
        LinearIndependent ℤ_[ℓ] ![t, cmAction W Ks ℓ i ω t] ∧
          Submodule.span ℤ_[ℓ] {t, cmAction W Ks ℓ i ω t} = ⊤

omit [IsSepClosed Ks] in
/-- Galois equivariance of the action of an endomorphism defined over `k` on the Tate module. -/
theorem galoisRep_comm_tateRep (σ : Ks ≃ₐ[k] Ks) (f : Hom W.toAffine W.toAffine) :
    W.tateModuleGaloisRepresentation ℓ σ * tateRep (W⁄Ks) ℓ (f.map (algebraMap k Ks)) =
      tateRep (W⁄Ks) ℓ (f.map (algebraMap k Ks)) * W.tateModuleGaloisRepresentation ℓ σ := by
  refine LinearMap.ext fun x => TateModule.ext fun n => Subtype.ext ?_
  rw [Module.End.mul_apply, Module.End.mul_apply]
  have e1 : ∀ y : TateModule ℓ (W⁄Ks).toAffine.Point, ∀ m : ℕ,
      ((TateModule.proj m (tateRep (W⁄Ks) ℓ (f.map (algebraMap k Ks)) y) :
        TateModuleLevel ℓ (W⁄Ks).toAffine.Point m) : (W⁄Ks).toAffine.Point) =
        (f.map (algebraMap k Ks)).pointMap (TateModule.proj m y : (W⁄Ks).toAffine.Point) :=
    fun _ _ => rfl
  rw [WeierstrassCurve.coe_proj_tateModuleGaloisRepresentation, e1, e1,
    WeierstrassCurve.coe_proj_tateModuleGaloisRepresentation]
  exact (Hom.pointMap_map_algebraMap_map f σ.toAlgHom _).symm

/-- **Proposition 12.13** (Milne): for $K$ quadratic, the action of $\mathrm{Gal}(k^{\mathrm s}/k)$ on $V_\ell E$
factors through $K \otimes \mathbb Q_\ell$: each $\sigma$ acts as an element of the $\mathbb Q_\ell$-algebra generated by the action of $R$ (the
image of $K \otimes \mathbb Q_\ell$), so $\rho_\ell(\sigma) \in (K \otimes \mathbb Q_\ell)^\times$. -/
@[kb "milne2017mf" "Section 12, Prop. 12.13 (pdf p. 125)"]
theorem galoisRepresentation_mem_adjoin_cmActionV (hK : Module.finrank ℚ K = 2) (hℓ : (ℓ : Ks) ≠ 0)
    (i : O.toSubalgebra ≃+* Hom W.toAffine W.toAffine) (σ : Ks ≃ₐ[k] Ks) :
    (W.tateModuleGaloisRepresentation ℓ σ).baseChange ℚ_[ℓ] ∈
      Algebra.adjoin ℚ_[ℓ] (Set.range (cmActionV W Ks ℓ i)) := by
  classical
  have := (W⁄Ks).free_tateModule hℓ
  have := (W⁄Ks).finite_tateModule hℓ
  -- Step 1: a non-integer element of the order
  obtain ⟨ω, hω⟩ : ∃ ω : O.toSubalgebra, ∀ n : ℤ, ω ≠ n := by
    by_contra hcon
    push Not at hcon
    have hle : (⊤ : Submodule ℚ K) ≤ Submodule.span ℚ {(1 : K)} := by
      rw [← O.spans]
      refine Submodule.span_le.mpr fun x hx => ?_
      obtain ⟨n, hn⟩ := hcon ⟨x, hx⟩
      have : x = (n : K) := congrArg Subtype.val hn
      rw [this, ← zsmul_one, ← Int.cast_smul_eq_zsmul ℚ]
      exact Submodule.smul_mem _ _ (Submodule.subset_span rfl)
    have h1 := Submodule.finrank_mono hle
    rw [finrank_top, finrank_span_singleton one_ne_zero, hK] at h1
    omega
  -- Step 2: equivariance
  have hT : Module.finrank ℤ_[ℓ] (TateModule ℓ (W⁄Ks).toAffine.Point) = 2 :=
    (W⁄Ks).finrank_tateModule hℓ
  have hV : Module.finrank ℚ_[ℓ] (ℚ_[ℓ] ⊗[ℤ_[ℓ]] TateModule ℓ (W⁄Ks).toAffine.Point) = 2 := by
    rw [Module.finrank_baseChange]; exact hT
  set g := (W.tateModuleGaloisRepresentation ℓ σ).baseChange ℚ_[ℓ] with hg
  have hcomm : g * cmActionV W Ks ℓ i ω = cmActionV W Ks ℓ i ω * g := by
    have := congrArg (LinearMap.baseChange ℚ_[ℓ]) (galoisRep_comm_tateRep (W := W) (Ks := Ks) (ℓ := ℓ) σ (i ω))
    simpa [hg, cmActionV, cmAction, Module.End.mul_eq_comp, LinearMap.baseChange_comp] using this
  -- Step 3: commutant
  obtain ⟨v, hv⟩ := exists_linearIndependent_cmActionV hℓ i ω hω
  set ωV := cmActionV W Ks ℓ i ω with hωV
  let b := basisOfLinearIndependentOfCardEqFinrank hv (by simp [hV])
  have hb : ∀ j, b j = ![v, ωV v] j := fun j => by simp [b]
  set c0 := b.repr (g v) 0
  set c1 := b.repr (g v) 1
  have hgv : g v = c0 • v + c1 • ωV v := by
    conv_lhs => rw [← b.sum_repr (g v)]
    rw [Fin.sum_univ_two, hb, hb]
    rfl
  set h : Module.End ℚ_[ℓ] (ℚ_[ℓ] ⊗[ℤ_[ℓ]] TateModule ℓ (W⁄Ks).toAffine.Point) :=
    c0 • (1 : Module.End _ _) + c1 • ωV with hh
  have hhv : h v = g v := by
    rw [hgv, hh]; simp
  have hhc : h * ωV = ωV * h := by
    rw [hh, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, smul_mul_assoc,
      mul_smul_comm]
  have : g = h := by
    refine b.ext fun j => ?_
    fin_cases j
    · simpa [hb] using hhv.symm
    · have e1 : g (ωV v) = ωV (g v) := congrArg (fun F => F v) hcomm
      have e2 : h (ωV v) = ωV (h v) := congrArg (fun F => F v) hhc
      simpa [hb] using e1.trans (by rw [← hhv, ← e2])
  rw [this, hh]
  refine Subalgebra.add_mem _ (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
    (Subalgebra.smul_mem _ (Algebra.subset_adjoin (Set.mem_range_self ω)) _)

end ModularFormsKB.Milne
