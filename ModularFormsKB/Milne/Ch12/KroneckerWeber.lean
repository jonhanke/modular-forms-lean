import Mathlib.Order.CompletePartialOrder
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import ModularFormsKB.Citation
import TauCeti.NumberTheory.ClassFieldTheory.ClassFields.KroneckerWeber

/-!
# Milne, Section 12: the Kronecker–Weber theorem (Theorem 12.1)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 12, pdf p. 121.

**Theorem 12.1** (Kronecker–Weber). $\mathbb Q^{\mathrm{cyc}} = \mathbb Q^{\mathrm{ab}}$: the union of the cyclotomic
fields $\mathbb Q[\zeta_n]$ is the maximal abelian extension of $\mathbb Q$.

## Items

- `KroneckerWeber`: the **named statement** in its finite form: every finite abelian Galois extension of $\mathbb Q$
  embeds in a cyclotomic field.
- `kroneckerWeber` (proved): from Tau Ceti's `TauCeti.ClassFieldTheory.kroneckerWeber` (global class field theory:
  conductors and ray class fields of $\mathbb Q$), moved from `Type` to any universe by an embedding into
  $\overline{\mathbb Q}$.
- `ratCyc`, `ratAb`: $\mathbb Q^{\mathrm{cyc}}$ and $\mathbb Q^{\mathrm{ab}}$ inside an algebraic closure
  $\overline{\mathbb Q}$ (`AlgebraicClosure ℚ`): the subfield generated by all roots of unity, and the compositum of
  all finite Galois subextensions with abelian Galois group.
- `ratCyc_le_ratAb` (proved): every cyclotomic field is abelian (the elementary half, Mathlib's
  `IsCyclotomicExtension.Rat.galEquivZMod`: $\mathrm{Gal}(\mathbb Q[\zeta_n]/\mathbb Q) \cong (\mathbb Z/n\mathbb Z)^\times$,
  which rests on the irreducibility of cyclotomic polynomials, `Polynomial.cyclotomic.irreducible_rat`).
- `ratCyc_eq_ratAb` (Theorem 12.1, from `KroneckerWeber`); `ratCyc_eq_ratAb_unconditional` (Theorem 12.1, proved).
-/

namespace ModularFormsKB.Milne

universe u

/-- **The Kronecker–Weber theorem**, finite form (Kronecker 1853, Weber 1886, Hilbert 1896 [unverified]; Milne,
Section 12, Theorem 12.1): every finite Galois extension $K$ of $\mathbb Q$ with abelian Galois group embeds in a
cyclotomic field $\mathbb Q[\zeta_n]$. Named statement. -/
@[kb "milne2017mf" "Section 12, Thm. 12.1 (pdf p. 121), finite form"]
structure KroneckerWeber : Prop where
  embeds : ∀ (K : Type u) [Field K] [NumberField K] [IsGalois ℚ K],
    (∀ σ τ : K ≃ₐ[ℚ] K, σ * τ = τ * σ) →
      ∃ n : ℕ, 0 < n ∧ Nonempty (K →ₐ[ℚ] CyclotomicField n ℚ)

/-- $\mathbb Q^{\mathrm{cyc}} \subseteq \overline{\mathbb Q}$: the field generated by all roots of unity. -/
noncomputable def ratCyc : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  IntermediateField.adjoin ℚ {x | ∃ n : ℕ, 0 < n ∧ x ^ n = 1}

/-- $\mathbb Q^{\mathrm{ab}} \subseteq \overline{\mathbb Q}$: the compositum of the finite Galois subextensions with
abelian Galois group. -/
noncomputable def ratAb : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  ⨆ L : {L : IntermediateField ℚ (AlgebraicClosure ℚ) //
      FiniteDimensional ℚ L ∧ IsGalois ℚ L ∧ ∀ σ τ : L ≃ₐ[ℚ] L, σ * τ = τ * σ}, L.1

/-- For a primitive `n`-th root of unity `ζ` in `Q̄`, `ℚ⟮ζ⟯` is finite, Galois and abelian over `ℚ`, so it is one
of the fields in the compositum defining `ratAb`. -/
theorem adjoin_primitiveRoot_mem_index {n : ℕ} [NeZero n] {ζ : AlgebraicClosure ℚ}
    (hζ : IsPrimitiveRoot ζ n) :
    FiniteDimensional ℚ (IntermediateField.adjoin ℚ {ζ}) ∧ IsGalois ℚ (IntermediateField.adjoin ℚ {ζ}) ∧
      ∀ σ τ : (IntermediateField.adjoin ℚ {ζ}) ≃ₐ[ℚ] (IntermediateField.adjoin ℚ {ζ}), σ * τ = τ * σ := by
  have := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  refine ⟨IsCyclotomicExtension.finiteDimensional {n} ℚ _, IsCyclotomicExtension.isGalois {n} ℚ _, ?_⟩
  have := IsCyclotomicExtension.isMulCommutative {n} ℚ (IntermediateField.adjoin ℚ {ζ})
  intro σ τ
  exact IsMulCommutative.is_comm.comm σ τ

/-- The elementary half of Theorem 12.1: $\mathbb Q^{\mathrm{cyc}} \subseteq \mathbb Q^{\mathrm{ab}}$, since
$\mathbb Q[\zeta_n]$ is Galois over $\mathbb Q$ with group $(\mathbb Z/n\mathbb Z)^\times$. -/
@[kb "milne2017mf" "Section 12, Thm. 12.1, elementary part (pdf p. 121)"]
theorem ratCyc_le_ratAb : ratCyc ≤ ratAb := by
  rw [ratCyc, IntermediateField.adjoin_le_iff]
  rintro x ⟨n, hn, hx⟩
  have hfin : IsOfFinOrder x := isOfFinOrder_iff_pow_eq_one.2 ⟨n, hn, hx⟩
  have : NeZero (orderOf x) := ⟨hfin.orderOf_pos.ne'⟩
  have hζ : IsPrimitiveRoot x (orderOf x) := IsPrimitiveRoot.orderOf x
  have hmem : x ∈ IntermediateField.adjoin ℚ {x} := IntermediateField.subset_adjoin ℚ _ rfl
  have hle : IntermediateField.adjoin ℚ {x} ≤ ratAb :=
    le_iSup (fun L : {L : IntermediateField ℚ (AlgebraicClosure ℚ) //
      FiniteDimensional ℚ L ∧ IsGalois ℚ L ∧ ∀ σ τ : L ≃ₐ[ℚ] L, σ * τ = τ * σ} => L.1)
      ⟨IntermediateField.adjoin ℚ {x}, adjoin_primitiveRoot_mem_index hζ⟩
  exact hle hmem

/-- **Theorem 12.1** (Milne; Kronecker–Weber): $\mathbb Q^{\mathrm{cyc}} = \mathbb Q^{\mathrm{ab}}$, from the finite
form `KroneckerWeber`. -/
@[kb "milne2017mf" "Section 12, Thm. 12.1 (pdf p. 121)"]
theorem ratCyc_eq_ratAb (h : KroneckerWeber.{0}) : ratCyc = ratAb := by
  refine le_antisymm ratCyc_le_ratAb (iSup_le ?_)
  rintro ⟨L, hfin, hgal, hcomm⟩
  have := hfin
  have := hgal
  have : NumberField L := ⟨⟩
  obtain ⟨n, hn, ⟨φ⟩⟩ := h.embeds L hcomm
  have : NeZero n := ⟨hn.ne'⟩
  have : NeZero (n : ℚ) := ⟨by exact_mod_cast hn.ne'⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_isPrimitiveRoot (AlgebraicClosure ℚ) n
  have := hζ.intermediateField_adjoin_isCyclotomicExtension ℚ
  have : IsCyclotomicExtension {n} ℚ (CyclotomicField n ℚ) :=
    CyclotomicField.isCyclotomicExtension n ℚ
  let e : CyclotomicField n ℚ ≃ₐ[ℚ] IntermediateField.adjoin ℚ {ζ} :=
    IsCyclotomicExtension.algEquiv {n} ℚ (CyclotomicField n ℚ) (IntermediateField.adjoin ℚ {ζ})
  let ψ : L →ₐ[ℚ] AlgebraicClosure ℚ :=
    ((IntermediateField.adjoin ℚ {ζ}).val.comp (e.toAlgHom.comp φ))
  have h1 : ψ.fieldRange = L := AlgHom.fieldRange_of_normal ψ
  have h2 : ψ.fieldRange ≤ IntermediateField.adjoin ℚ {ζ} := by
    rintro _ ⟨y, rfl⟩
    exact (e (φ y)).2
  have h3 : IntermediateField.adjoin ℚ {ζ} ≤ ratCyc :=
    IntermediateField.adjoin.mono _ _ _ (by
      rintro _ rfl
      exact ⟨n, hn, hζ.pow_eq_one⟩)
  calc L = ψ.fieldRange := h1.symm
    _ ≤ ratCyc := h2.trans h3

/-- **The Kronecker–Weber theorem** (Milne, Theorem 12.1, finite form), proved: Tau Ceti's
`TauCeti.ClassFieldTheory.kroneckerWeber` (from global class field theory: the conductor of an abelian extension of
$\mathbb Q$ and the ray class field of $\mathbb Q$ of conductor $n$ is $\mathbb Q[\zeta_n]$) gives it for fields in
`Type`; a number field in any universe is moved there by an embedding into $\overline{\mathbb Q}$. -/
@[kb "milne2017mf" "Section 12, Thm. 12.1 (pdf p. 121), finite form"]
theorem kroneckerWeber : KroneckerWeber.{u} := by
  refine ⟨fun K _ _ _ hcomm => ?_⟩
  have : IsAbelianGalois ℚ K := { is_comm := ⟨hcomm⟩ }
  let f : K →ₐ[ℚ] AlgebraicClosure ℚ := IsAlgClosed.lift
  let e : K ≃ₐ[ℚ] f.fieldRange := AlgEquiv.ofInjectiveField f
  have : IsAbelianGalois ℚ f.fieldRange := .of_algHom e.symm.toAlgHom
  have : FiniteDimensional ℚ f.fieldRange := e.toLinearEquiv.finiteDimensional
  have : NumberField f.fieldRange := ⟨⟩
  obtain ⟨n, hn, ⟨φ⟩⟩ := TauCeti.ClassFieldTheory.kroneckerWeber f.fieldRange
  exact ⟨n, Nat.pos_of_ne_zero hn, ⟨φ.comp e.toAlgHom⟩⟩

/-- **Theorem 12.1** (Milne; Kronecker–Weber), unconditional: $\mathbb Q^{\mathrm{cyc}} = \mathbb Q^{\mathrm{ab}}$. -/
@[kb "milne2017mf" "Section 12, Thm. 12.1 (pdf p. 121)"]
theorem ratCyc_eq_ratAb_unconditional : ratCyc = ratAb :=
  ratCyc_eq_ratAb kroneckerWeber

end ModularFormsKB.Milne
