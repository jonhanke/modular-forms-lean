import ModularFormsKB.Milne.Ch2.UncondConnectedFD
import ModularFormsKB.Milne.Ch2.ModularGroup
import Mathlib.NumberTheory.Modular

/-!
# Milne, Proposition 2.17 for the standard fundamental domain of `SL₂(ℤ)`

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Proposition 2.17, pdf p. 35 (proof
omitted in the book).

Proposition 2.17 is stated (as `ConnectedFundamentalDomainStatement`) for an arbitrary fundamental domain `D` of
`Γ`, a generality in which it is doubtful (see `Ch2/UncondConnectedFD.lean`). The book applies it (Section 2,
Theorem 2.22 and after) to `Γ = SL₂(ℤ)` and the standard domain `D = {|z| > 1, |Re z| < 1/2}` (Mathlib's
`ModularGroup.fdo`). This file proves it in that case, for every subgroup `Γ'` of finite index
(`proposition_2_17_SL2Z`).

Proof: `SL₂(ℤ)` is generated by `S` and `T` (Theorem 2.12), so the cosets of `Γ'` can be represented by words built
one letter at a time (a Schreier transversal, `exists_schreier_transversal`): each representative other than the
first is an earlier one times `S^{±1}` or `T^{±1}`. The closed tiles `γ D̄` and `γ s D̄` (`s = S^{±1}, T^{±1}`) share
an edge containing a point interior to their union (`exists_common_interior_point`), so the pieces
`U ∩ γᵢ D̄` of `U = interior (closure D')` are connected along the transversal, and `U` is connected; Proposition 2.17
for every choice of representatives (`isFundamentalDomain_interior_closure`) concludes.
-/

open UpperHalfPlane Pointwise Topology Set
open scoped MatrixGroups Modular

noncomputable section

namespace ModularFormsKB.Milne.Wave6

/-- The embedding `SL₂(ℤ) → SL₂(ℝ)`. -/
abbrev toSL2R : SL(2, ℤ) →* SL(2, ℝ) := Matrix.SpecialLinearGroup.map (Int.castRingHom ℝ)

/-- The four generators `S^{±1}`, `T^{±1}`. -/
def generators : Set SL(2, ℤ) := {ModularGroup.S, ModularGroup.S⁻¹, ModularGroup.T, ModularGroup.T⁻¹}

/-- `SL₂(ℤ)` is discrete in `SL₂(ℝ)`. -/
theorem discreteTopology_SL2ZinSL2R : DiscreteTopology SL2ZinSL2R := by
  apply discreteTopology_of_isOpen_singleton_one
  have hopen : IsOpen {x : SL2ZinSL2R | ∀ i j : Fin 2,
      |((x : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) i j - (1 : Matrix (Fin 2) (Fin 2) ℝ) i j| < 1 / 2} := by
    simp only [Set.setOf_forall]
    refine isOpen_iInter_of_finite fun i ↦ isOpen_iInter_of_finite fun j ↦ ?_
    refine isOpen_lt ?_ continuous_const
    fun_prop
  convert hopen using 1
  ext x
  obtain ⟨_, g, rfl⟩ := x
  simp only [Set.mem_singleton_iff, Set.mem_setOf_eq]
  constructor
  · intro h
    have h1 := congrArg (fun y : SL2ZinSL2R => y.1) h
    intro i j
    simp only at h1
    rw [h1]; simp
  · intro h
    have hg : g = 1 := by
      ext i j
      have := h i j
      have e : ((toSL2R g : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) i j = ((g i j : ℤ) : ℝ) := by
        simp [toSL2R]
      rw [e] at this
      have e2 : ((1 : Matrix (Fin 2) (Fin 2) ℝ) i j) = (((1 : Matrix (Fin 2) (Fin 2) ℤ) i j : ℤ) : ℝ) := by
        by_cases hij : i = j <;> simp [Matrix.one_apply, hij]
      rw [e2, ← Int.cast_sub, ← Int.cast_abs] at this
      have h3 : |g i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j| < 1 := by
        exact_mod_cast (by linarith : ((|g i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j| : ℤ) : ℝ) < 1)
      have : |g i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j| = 0 := by
        have := abs_nonneg (g i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j)
        omega
      have := abs_eq_zero.1 this
      simpa [sub_eq_zero] using this
    subst hg
    apply Subtype.ext
    simp

attribute [local instance] discreteTopology_SL2ZinSL2R

/-- The image of `𝒟ᵒ` in `ℂ` is preconnected. -/
theorem isPreconnected_coe_fdo :
    IsPreconnected {z : ℂ | 0 < z.im ∧ 1 < ‖z‖ ∧ |z.re| < 1 / 2} := by
  refine isPreconnected_of_forall (2 * Complex.I) fun y hy => ?_
  obtain ⟨hy0, hy1, hy2⟩ := hy
  have hy1' : 1 < Complex.normSq y := Complex.one_lt_normSq_iff.2 hy1
  rw [Complex.normSq_apply] at hy1'
  set h : ℝ := max y.im 2 with hh
  have hh1 : y.im ≤ h := le_max_left _ _
  have hh2 : 2 ≤ h := le_max_right _ _
  have hre : 0 ≤ |y.re| := abs_nonneg _
  have key : ∀ z : ℂ, 0 < z.im → 1 < z.re * z.re + z.im * z.im → |z.re| < 1 / 2 →
      z ∈ {z : ℂ | 0 < z.im ∧ 1 < ‖z‖ ∧ |z.re| < 1 / 2} := by
    intro z h1 h2 h3
    refine ⟨h1, ?_, h3⟩
    rw [← Complex.one_lt_normSq_iff, Complex.normSq_apply]; exact h2
  set A : Set ℂ := (fun s : ℝ => (y.re : ℂ) + s * Complex.I) '' Set.Icc y.im h
  set B : Set ℂ := (fun x : ℝ => (x : ℂ) + h * Complex.I) '' Set.uIcc y.re 0
  set C : Set ℂ := (fun s : ℝ => (s : ℂ) * Complex.I) '' Set.Icc 2 h
  have hA : A ⊆ {z : ℂ | 0 < z.im ∧ 1 < ‖z‖ ∧ |z.re| < 1 / 2} := by
    rintro _ ⟨s, ⟨hs1, hs2⟩, rfl⟩
    apply key <;> simp
    · linarith
    · nlinarith
    · simpa using hy2
  have hB : B ⊆ {z : ℂ | 0 < z.im ∧ 1 < ‖z‖ ∧ |z.re| < 1 / 2} := by
    rintro _ ⟨x, hx, rfl⟩
    have hx' : |x| ≤ |y.re| := by
      rcases Set.mem_uIcc.1 hx with ⟨a, b⟩ | ⟨a, b⟩
      · rw [abs_le]; constructor <;> cases abs_cases y.re <;> linarith
      · rw [abs_le]; constructor <;> cases abs_cases y.re <;> linarith
    apply key <;> simp
    · linarith
    · nlinarith [mul_self_nonneg x]
    · linarith
  have hC : C ⊆ {z : ℂ | 0 < z.im ∧ 1 < ‖z‖ ∧ |z.re| < 1 / 2} := by
    rintro _ ⟨s, ⟨hs1, hs2⟩, rfl⟩
    apply key <;> simp
    · linarith
    · nlinarith
  have hAc : IsPreconnected A := isPreconnected_Icc.image _ (by fun_prop)
  have hBc : IsPreconnected B := isPreconnected_uIcc.image _ (by fun_prop)
  have hCc : IsPreconnected C := isPreconnected_Icc.image _ (by fun_prop)
  have hAB : (y.re : ℂ) + h * Complex.I ∈ A ∩ B := by
    refine ⟨⟨h, ⟨hh1, le_rfl⟩, rfl⟩, ⟨y.re, Set.left_mem_uIcc, rfl⟩⟩
  have hBC : ((0 : ℝ) : ℂ) + h * Complex.I ∈ B ∩ C := by
    refine ⟨⟨0, Set.right_mem_uIcc, rfl⟩, ⟨h, ⟨hh2, le_rfl⟩, by simp⟩⟩
  refine ⟨(A ∪ B) ∪ C, Set.union_subset (Set.union_subset hA hB) hC, ?_, ?_, ?_⟩
  · exact Or.inr ⟨2, ⟨le_rfl, hh2⟩, rfl⟩
  · exact Or.inl (Or.inl ⟨y.im, ⟨le_rfl, hh1⟩, by apply Complex.ext <;> simp⟩)
  · exact (hAc.union _ hAB.1 hAB.2 hBc).union _ (Or.inr hBC.1) hBC.2 hCc

/-- **Milne, Theorem 2.12**, in the form of a fundamental domain (p. 32): the standard domain
`{|z| > 1, |Re z| < 1/2}` is a fundamental domain for `SL₂(ℤ)` in `SL₂(ℝ)`. -/
theorem isFundamentalDomain_fdo : IsFundamentalDomain SL2ZinSL2R 𝒟ᵒ := by
  refine ⟨⟨?_, ?_⟩, ModularGroup.isOpen_fdo, ?_, ?_⟩
  · have : ((↑) '' 𝒟ᵒ : Set ℂ).Nonempty := by
      rw [ModularGroup.coe_fdo]
      refine ⟨2 * Complex.I, ?_⟩
      simp only [Set.mem_ofPred_eq, Complex.mul_im, Complex.re_ofNat, Complex.I_im, mul_one,
        Complex.im_ofNat, Complex.I_re, mul_zero, add_zero, norm_mul, Complex.mul_re, sub_zero, abs_zero]
      norm_num
    exact this.of_image
  · have := isPreconnected_coe_fdo
    rw [← ModularGroup.coe_fdo] at this
    exact UpperHalfPlane.isEmbedding_coe.isInducing.isPreconnected_image.1 this
  · rintro z hz w hw γ ⟨g, rfl⟩ h
    have h' : g • z = w := by rw [← h]; exact (Remark211.map_smul' g z).symm
    rcases ModularGroup.eq_one_or_neg_one_of_mem_fdo_mem_fdo hz (h' ▸ hw) with rfl | rfl
    · simpa using h'
    · simpa using h'
  · intro z
    obtain ⟨g, hg⟩ := ModularGroup.exists_smul_mem_fd z
    refine ⟨toSL2R g, ⟨g, rfl⟩, ?_⟩
    rw [Remark211.map_smul', ← ModularGroup.fd_eq_closure_fdo]
    exact hg

/-- The subgroup `±Γ'` of `SL₂(ℝ)`. -/
def pmSub (Γ' : Subgroup SL(2, ℝ)) : Subgroup SL(2, ℝ) where
  carrier := {x | ∃ γ ∈ Γ', x = γ ∨ x = -γ}
  mul_mem' := by
    intro x y hx hy
    obtain ⟨a, ha, h1⟩ := hx
    obtain ⟨b, hb, h2⟩ := hy
    rcases h1 with h1 | h1 <;> rcases h2 with h2 | h2 <;> rw [h1, h2]
    · exact ⟨a * b, mul_mem ha hb, Or.inl rfl⟩
    · exact ⟨a * b, mul_mem ha hb, Or.inr (mul_neg _ _)⟩
    · exact ⟨a * b, mul_mem ha hb, Or.inr (neg_mul _ _)⟩
    · exact ⟨a * b, mul_mem ha hb, Or.inl (neg_mul_neg _ _)⟩
  one_mem' := ⟨1, one_mem _, Or.inl rfl⟩
  inv_mem' := by
    intro x hx
    obtain ⟨a, ha, h1⟩ := hx
    rcases h1 with h1 | h1 <;> rw [h1]
    · exact ⟨a⁻¹, inv_mem ha, Or.inl rfl⟩
    · refine ⟨a⁻¹, inv_mem ha, Or.inr ?_⟩
      exact inv_eq_of_mul_eq_one_right (by rw [neg_mul_neg, mul_inv_cancel])

/-- Membership in `±Γ'` of a quotient, in the form of the coset condition. -/
theorem mem_pmSub_mul_inv_iff (Γ' : Subgroup SL(2, ℝ)) (x y : SL(2, ℝ)) :
    x * y⁻¹ ∈ pmSub Γ' ↔ ∃ γ' ∈ Γ', x = γ' * y ∨ x = -(γ' * y) := by
  constructor
  · rintro ⟨γ, hγ, h | h⟩
    · exact ⟨γ, hγ, Or.inl (mul_inv_eq_iff_eq_mul.1 h)⟩
    · exact ⟨γ, hγ, Or.inr (by rw [← neg_mul]; exact mul_inv_eq_iff_eq_mul.1 h)⟩
  · rintro ⟨γ, hγ, h | h⟩
    · exact ⟨γ, hγ, Or.inl (by rw [h]; simp)⟩
    · exact ⟨γ, hγ, Or.inr (by rw [h]; simp [neg_mul])⟩

/-- **Schreier transversal**: the cosets of a subgroup `Γ'` of `SL₂(ℤ)` (inside `SL₂(ℝ)`, up to sign) with `m`
cosets have representatives `γ i ∈ SL₂(ℤ)` such that every representative is reached from one of them by successive
right multiplications by `S^{±1}`, `T^{±1}` within the family. -/
theorem exists_schreier_transversal {Γ' : Subgroup SL(2, ℝ)} (hΓ' : Γ' ≤ SL2ZinSL2R) {m : ℕ}
    (hex : ∃ γs : Fin m → SL(2, ℝ), (∀ i, γs i ∈ SL2ZinSL2R) ∧
      ∀ γ ∈ SL2ZinSL2R, ∃! i : Fin m, ∃ γ' ∈ Γ', γ = γ' * γs i ∨ γ = -(γ' * γs i)) :
    ∃ γs : Fin m → SL(2, ℤ),
      (∀ γ ∈ SL2ZinSL2R, ∃! i : Fin m, ∃ γ' ∈ Γ', γ = γ' * toSL2R (γs i) ∨ γ = -(γ' * toSL2R (γs i))) ∧
      ∃ i₀ : Fin m, ∀ i, Relation.ReflTransGen
        (fun i j ↦ ∃ s ∈ generators, γs j = γs i * s ∨ γs i = γs j * s) i₀ i := by
  classical
  obtain ⟨γs, hmem, hex⟩ := hex
  have hex' : ∀ g : SL(2, ℤ), ∃! i, toSL2R g * (γs i)⁻¹ ∈ pmSub Γ' := fun g => by
    obtain ⟨i, hi, hu⟩ := hex (toSL2R g) ⟨g, rfl⟩
    exact ⟨i, (mem_pmSub_mul_inv_iff _ _ _).2 hi, fun j hj => hu j ((mem_pmSub_mul_inv_iff _ _ _).1 hj)⟩
  choose cls hcls hu using hex'
  have cls_eq : ∀ g h, cls g = cls h ↔ toSL2R g * (toSL2R h)⁻¹ ∈ pmSub Γ' := by
    intro g h
    constructor
    · intro e
      have h1 := hcls g
      have h2 := hcls h
      rw [← e] at h2
      have := mul_mem h1 (inv_mem h2)
      simpa [mul_assoc] using this
    · intro e
      have h2 := hcls h
      have : toSL2R g * (γs (cls h))⁻¹ ∈ pmSub Γ' := by
        have := mul_mem e h2
        simpa [mul_assoc] using this
      exact (hu g _ this).symm
  have cls_mul : ∀ g h s, cls g = cls h → cls (g * s) = cls (h * s) := by
    intro g h s e
    rw [cls_eq] at e ⊢
    simpa [mul_assoc] using e
  have cls_surj : ∀ i, ∃ g, cls g = i := by
    intro i
    obtain ⟨g, hg⟩ := hmem i
    refine ⟨g, (hu g i ?_).symm⟩
    rw [hg]; simp [one_mem]
  have hm : 0 < m := by
    obtain ⟨i, _⟩ := hex 1 (one_mem _)
    exact Nat.pos_of_ne_zero (by rintro rfl; exact i.elim0)
  have build : ∀ k, 1 ≤ k → k ≤ m → ∃ f : ℕ → SL(2, ℤ), f 0 = 1 ∧
      (∀ a b, a < k → b < k → cls (f a) = cls (f b) → a = b) ∧
      ∀ a, 0 < a → a < k → ∃ b < a, ∃ s ∈ generators, f a = f b * s := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base =>
      intro _
      exact ⟨fun _ => 1, rfl, fun a b ha hb _ => by omega, fun a h1 h2 => by omega⟩
    | succ k hk ih =>
      intro hkm
      obtain ⟨f, hf0, hinj, hstep⟩ := ih (by omega)
      have hnew : ∃ b < k, ∃ s ∈ generators, ∀ a < k, cls (f a) ≠ cls (f b * s) := by
        by_contra hcon
        push_neg at hcon
        have hall : ∀ g : SL(2, ℤ), ∃ a < k, cls (f a) = cls g := by
          intro g
          have hg : g ∈ Subgroup.closure {ModularGroup.S, ModularGroup.T} := by
            rw [SpecialLinearGroup.SL2Z_generators]; exact Subgroup.mem_top _
          refine Subgroup.closure_induction_right (p := fun g _ => ∃ a < k, cls (f a) = cls g) ?_ ?_ ?_ hg
          · exact ⟨0, by omega, by rw [hf0]⟩
          · rintro x hx y hy ⟨a, ha, e⟩
            obtain ⟨a', ha', e'⟩ := hcon a ha y (by rcases hy with rfl | rfl <;> simp [generators])
            exact ⟨a', ha', e'.trans (cls_mul _ _ _ e)⟩
          · rintro x hx y hy ⟨a, ha, e⟩
            obtain ⟨a', ha', e'⟩ := hcon a ha y⁻¹ (by rcases hy with rfl | rfl <;> simp [generators])
            exact ⟨a', ha', e'.trans (cls_mul _ _ _ e)⟩
        have hsurj : Function.Surjective (fun a : Fin k => cls (f a)) := by
          intro i
          obtain ⟨g, rfl⟩ := cls_surj i
          obtain ⟨a, ha, e⟩ := hall g
          exact ⟨⟨a, ha⟩, e⟩
        have := Fintype.card_le_of_surjective _ hsurj
        simp at this
        omega
      obtain ⟨b, hb, s, hs, hne⟩ := hnew
      refine ⟨fun a => if a = k then f b * s else f a, ?_, ?_, ?_⟩
      · simp [show (0 : ℕ) ≠ k by omega, hf0]
      · intro a c ha hc e
        by_cases hak : a = k <;> by_cases hck : c = k
        · omega
        · simp [hak, hck] at e
          exact absurd e.symm (hne c (by omega))
        · simp [hak, hck] at e
          exact absurd e (hne a (by omega))
        · simp [hak, hck] at e
          exact hinj a c (by omega) (by omega) e
      · intro a h1 h2
        by_cases hak : a = k
        · refine ⟨b, by omega, s, hs, ?_⟩
          simp [hak, show b ≠ k by omega]
        · obtain ⟨c, hc, t, ht, e⟩ := hstep a h1 (by omega)
          refine ⟨c, hc, t, ht, ?_⟩
          simp [hak, show c ≠ k by omega, e]
  obtain ⟨f, hf0, hinj, hstep⟩ := build m hm le_rfl
  let σ : Fin m → Fin m := fun a => cls (f a)
  have hσinj : Function.Injective σ := fun a b e => Fin.ext (hinj a b a.2 b.2 e)
  let σe : Fin m ≃ Fin m := Equiv.ofBijective σ (Finite.injective_iff_bijective.1 hσinj)
  let g : Fin m → SL(2, ℤ) := fun i => f (σe.symm i)
  have hgcls : ∀ i, cls (g i) = i := fun i => by
    show σe (σe.symm i) = i
    exact σe.apply_symm_apply i
  refine ⟨g, ?_, ⟨σe ⟨0, hm⟩, ?_⟩⟩
  · rintro _ ⟨g0, rfl⟩
    refine ⟨cls g0, ?_, ?_⟩
    · apply (mem_pmSub_mul_inv_iff _ _ _).1
      exact (cls_eq g0 (g (cls g0))).1 (by rw [hgcls])
    · intro j hj
      have := (cls_eq g0 (g j)).2 ((mem_pmSub_mul_inv_iff _ _ _).2 hj)
      rw [hgcls] at this
      exact this.symm
  · have key : ∀ a : ℕ, ∀ ha : a < m, Relation.ReflTransGen
        (fun i j ↦ ∃ s ∈ generators, g j = g i * s ∨ g i = g j * s) (σe ⟨0, hm⟩) (σe ⟨a, ha⟩) := by
      intro a
      induction a using Nat.strong_induction_on with
      | _ a ih =>
        intro ha
        rcases Nat.eq_zero_or_pos a with rfl | hpos
        · exact .refl
        · obtain ⟨b, hb, s, hs, e⟩ := hstep a hpos ha
          refine (ih b hb (by omega)).tail ⟨s, hs, Or.inl ?_⟩
          simp only [g, Equiv.symm_apply_apply]
          exact e
    intro i
    have := key (σe.symm i) (σe.symm i).2
    simpa using this

/-- Membership in a translate of `𝒟` by an integer matrix. -/
theorem mem_smul_fd_iff (s : SL(2, ℤ)) (z : ℍ) : z ∈ toSL2R s • 𝒟 ↔ s⁻¹ • z ∈ 𝒟 := by
  rw [Set.mem_smul_set_iff_inv_smul_mem, ← map_inv, Remark211.map_smul']

/-- Reduction of the adjacent-tile statement to `𝒟` itself. -/
theorem common_interior_of (s : SL(2, ℤ)) (e : ℍ) (he1 : e ∈ 𝒟) (he2 : s⁻¹ • e ∈ 𝒟) (N : Set ℍ)
    (hNo : IsOpen N) (heN : e ∈ N) (hN : ∀ z ∈ N, z ∈ 𝒟 ∨ s⁻¹ • z ∈ 𝒟) :
    e ∈ closure 𝒟ᵒ ∧ e ∈ closure (toSL2R s • 𝒟ᵒ) ∧
      e ∈ interior (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) := by
  have hcl : closure (toSL2R s • 𝒟ᵒ) = toSL2R s • 𝒟 := by
    rw [closure_smul, ← ModularGroup.fd_eq_closure_fdo]
  rw [hcl, ← ModularGroup.fd_eq_closure_fdo]
  refine ⟨he1, (mem_smul_fd_iff s e).2 he2, mem_interior.2 ⟨N, ?_, hNo, heN⟩⟩
  intro z hz
  rcases hN z hz with h | h
  · exact Or.inl h
  · exact Or.inr ((mem_smul_fd_iff s z).2 h)

/-- Membership in `𝒟` in coordinates. -/
theorem mem_fd_of (z : ℍ) (h1 : 1 ≤ z.re * z.re + z.im * z.im) (h2 : |z.re| ≤ 1 / 2) : z ∈ 𝒟 := by
  refine ⟨?_, h2⟩
  rw [Complex.normSq_apply]; exact h1

/-- `normSq` of a point of `ℍ` in coordinates. -/
theorem normSq_coe_eq (z : ℍ) : Complex.normSq (z : ℂ) = z.re * z.re + z.im * z.im := by
  rw [Complex.normSq_apply]; rfl

/-- Real part of `S z`. -/
theorem re_S_smul (z : ℍ) : (ModularGroup.S • z).re = -z.re / Complex.normSq (z : ℂ) := by
  rw [← UpperHalfPlane.coe_re, UpperHalfPlane.modular_S_smul, UpperHalfPlane.coe_mk, Complex.inv_re,
    Complex.normSq_neg]
  simp [neg_div]

/-- `normSq` of `S z`. -/
theorem normSq_S_smul (z : ℍ) :
    Complex.normSq ((ModularGroup.S • z : ℍ) : ℂ) = (Complex.normSq (z : ℂ))⁻¹ := by
  rw [UpperHalfPlane.modular_S_smul, UpperHalfPlane.coe_mk, map_inv₀, Complex.normSq_neg]

/-- `S⁻¹` acts like `S`. -/
theorem S_inv_smul (z : ℍ) : ModularGroup.S⁻¹ • z = ModularGroup.S • z := by
  rw [ModularGroup.S_inv, ModularGroup.SL_neg_smul]

/-- Adjacent tiles across a vertical side. -/
theorem common_interior_translate (s : SL(2, ℤ)) (c : ℝ) (hc : c = 1 / 2 ∨ c = -1 / 2)
    (hre : ∀ z : ℍ, (s⁻¹ • z).re = z.re - 2 * c) (him : ∀ z : ℍ, (s⁻¹ • z).im = z.im) :
    ∃ e : ℍ, e ∈ closure 𝒟ᵒ ∧ e ∈ closure (toSL2R s • 𝒟ᵒ) ∧
      e ∈ interior (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) := by
  let e : ℍ := UpperHalfPlane.mk ((c : ℂ) + 2 * Complex.I) (by simp)
  have her : e.re = c := by simp [e, ← UpperHalfPlane.coe_re]
  have hei : e.im = 2 := by simp [e, ← UpperHalfPlane.coe_im]
  have hc2 : |c| = 1 / 2 := by rcases hc with rfl | rfl <;> norm_num
  refine ⟨e, common_interior_of s e ?_ ?_ {z : ℍ | |z.re - c| < 1 / 4 ∧ 1 < z.im} ?_ ?_ ?_⟩
  · apply mem_fd_of
    · rw [hei]; nlinarith [mul_self_nonneg e.re]
    · rw [her, hc2]
  · apply mem_fd_of
    · rw [him, hei]; nlinarith [mul_self_nonneg (s⁻¹ • e).re]
    · rw [hre, her]; rcases hc with rfl | rfl <;> norm_num [abs_of_nonneg, abs_of_nonpos]
  · have o1 : IsOpen {z : ℍ | |z.re - c| < 1 / 4} :=
      isOpen_lt (f := fun z : ℍ ↦ |z.re - c|) (by fun_prop) continuous_const
    have o2 : IsOpen {z : ℍ | 1 < z.im} :=
      isOpen_lt (g := fun z : ℍ ↦ z.im) continuous_const (by fun_prop)
    exact o1.inter o2
  · refine ⟨?_, ?_⟩
    · rw [her]; simp
    · rw [hei]; norm_num
  · rintro z ⟨h1, h2⟩
    rw [abs_lt] at h1
    rcases hc with rfl | rfl
    · by_cases h : z.re ≤ 1 / 2
      · left
        apply mem_fd_of
        · nlinarith [mul_self_nonneg z.re]
        · rw [abs_le]; constructor <;> linarith
      · right
        push_neg at h
        apply mem_fd_of
        · rw [him]; nlinarith [mul_self_nonneg (s⁻¹ • z).re]
        · rw [hre, abs_le]; constructor <;> linarith
    · by_cases h : -1 / 2 ≤ z.re
      · left
        apply mem_fd_of
        · nlinarith [mul_self_nonneg z.re]
        · rw [abs_le]; constructor <;> linarith
      · right
        push_neg at h
        apply mem_fd_of
        · rw [him]; nlinarith [mul_self_nonneg (s⁻¹ • z).re]
        · rw [hre, abs_le]; constructor <;> linarith

/-- **Adjacent tiles**: for a generator `s`, the closed tiles `D̄` and `s D̄` have a common point interior to their
union. -/
theorem exists_common_interior_point {s : SL(2, ℤ)} (hs : s ∈ generators) :
    ∃ e : ℍ, e ∈ closure 𝒟ᵒ ∧ e ∈ closure (toSL2R s • 𝒟ᵒ) ∧
      e ∈ interior (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) := by
  have hSz : ∀ s : SL(2, ℤ), (s = ModularGroup.S ∨ s = ModularGroup.S⁻¹) →
      ∃ e : ℍ, e ∈ closure 𝒟ᵒ ∧ e ∈ closure (toSL2R s • 𝒟ᵒ) ∧
        e ∈ interior (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) := by
    intro s hs
    have hsS : ∀ z : ℍ, s⁻¹ • z = ModularGroup.S • z := by
      rcases hs with rfl | rfl
      · exact S_inv_smul
      · intro z; rw [inv_inv]
    refine ⟨UpperHalfPlane.I, common_interior_of s _ ?_ ?_
      {z : ℍ | |z.re| < 1 / 4 ∧ 1 / 2 < Complex.normSq (z : ℂ)} ?_ ?_ ?_⟩
    · apply mem_fd_of <;> simp
    · rw [hsS]
      apply mem_fd_of
      · rw [← normSq_coe_eq, normSq_S_smul, normSq_coe_eq]; simp
      · rw [re_S_smul]; simp
    · have o1 : IsOpen {z : ℍ | |z.re| < 1 / 4} :=
        isOpen_lt (f := fun z : ℍ ↦ |z.re|) (by fun_prop) continuous_const
      have o2 : IsOpen {z : ℍ | 1 / 2 < Complex.normSq (z : ℂ)} :=
        isOpen_lt (g := fun z : ℍ ↦ Complex.normSq (z : ℂ)) continuous_const (by fun_prop)
      exact o1.inter o2
    · simp [normSq_coe_eq]; norm_num
    · rintro z ⟨h1, h2⟩
      by_cases hz : 1 ≤ Complex.normSq (z : ℂ)
      · left
        apply mem_fd_of
        · rwa [← normSq_coe_eq]
        · linarith [abs_lt.1 h1]
      · right
        rw [hsS]
        push_neg at hz
        have hpos : 0 < Complex.normSq (z : ℂ) := by linarith
        apply mem_fd_of
        · rw [← normSq_coe_eq, normSq_S_smul]
          exact (one_le_inv₀ hpos).2 hz.le
        · rw [re_S_smul, abs_div, abs_neg, abs_of_pos hpos, div_le_iff₀ hpos]
          linarith
  rcases hs with rfl | rfl | rfl | rfl
  · exact hSz _ (Or.inl rfl)
  · exact hSz _ (Or.inr rfl)
  · refine common_interior_translate _ (1 / 2) (Or.inl rfl) ?_ ?_
    · intro z; rw [ModularGroup.re_T_inv_smul]; ring
    · intro z; exact ModularGroup.im_T_inv_smul z
  · refine common_interior_translate _ (-1 / 2) (Or.inr rfl) ?_ ?_
    · intro z; rw [inv_inv, ModularGroup.re_T_smul]; ring
    · intro z; rw [inv_inv]; exact ModularGroup.im_T_smul z

/-- The tiles `γ D` are connected. -/
theorem isConnected_smul_fdo (g : SL(2, ℝ)) : IsConnected (g • 𝒟ᵒ) := by
  have h : IsConnected 𝒟ᵒ := isFundamentalDomain_fdo.1
  simpa [Set.image_smul] using h.image _ (continuous_const_smul g).continuousOn

/-- **Milne, Proposition 2.17**, for `Γ = SL₂(ℤ)` and its standard fundamental domain `D`: for a subgroup `Γ'` of
`SL₂(ℤ)` with `m` cosets (in the situation of Proposition 2.16), the representatives `γᵢ` can be chosen so that the
closure of `D' = ⋃ γᵢ D` is connected, and the interior of that closure is then a connected fundamental domain for
`Γ'`. -/
@[kb "milne2017mf" "Proposition 2.17 (for SL2(Z) and its standard fundamental domain), pdf p. 35"]
theorem proposition_2_17_SL2Z {Γ' : Subgroup SL(2, ℝ)} (hΓ' : Γ' ≤ SL2ZinSL2R) {m : ℕ}
    (hex : ∃ γs : Fin m → SL(2, ℝ), (∀ i, γs i ∈ SL2ZinSL2R) ∧
      ∀ γ ∈ SL2ZinSL2R, ∃! i : Fin m, ∃ γ' ∈ Γ', γ = γ' * γs i ∨ γ = -(γ' * γs i)) :
    ∃ γs : Fin m → SL(2, ℝ), (∀ i, γs i ∈ SL2ZinSL2R) ∧
      (∀ γ ∈ SL2ZinSL2R, ∃! i : Fin m, ∃ γ' ∈ Γ', γ = γ' * γs i ∨ γ = -(γ' * γs i)) ∧
      IsConnected (closure (⋃ i, γs i • 𝒟ᵒ)) ∧
      IsFundamentalDomain Γ' (interior (closure (⋃ i, γs i • 𝒟ᵒ))) := by
  obtain ⟨g, hcos, i₀, hreach⟩ := exists_schreier_transversal hΓ' hex
  set γs : Fin m → SL(2, ℝ) := fun i ↦ toSL2R (g i)
  have hmem : ∀ i, γs i ∈ SL2ZinSL2R := fun i ↦ ⟨g i, rfl⟩
  set D' := ⋃ i, γs i • 𝒟ᵒ
  set U := interior (closure D')
  have hD'open : IsOpen D' :=
    isOpen_iUnion fun i ↦ (isFundamentalDomain_fdo.2.1).smul (γs i)
  have hD'U : D' ⊆ U := interior_maximal subset_closure hD'open
  have hUcl : U ⊆ closure D' := interior_subset
  -- the pieces
  set C : Fin m → Set ℍ := fun i ↦ U ∩ closure (γs i • 𝒟ᵒ)
  have hCpre : ∀ i, IsPreconnected (C i) := fun i ↦
    (isConnected_smul_fdo (γs i)).isPreconnected.subset_closure
      (fun z hz ↦ ⟨hD'U (mem_iUnion.2 ⟨i, hz⟩), subset_closure hz⟩) inter_subset_right
  have hUC : U = ⋃ i, C i := by
    apply Subset.antisymm
    · intro z hz
      have : z ∈ ⋃ i, closure (γs i • 𝒟ᵒ) := by
        rw [← closure_iUnion_of_finite]; exact hUcl hz
      obtain ⟨i, hi⟩ := mem_iUnion.1 this
      exact mem_iUnion.2 ⟨i, hz, hi⟩
    · exact iUnion_subset fun i ↦ inter_subset_left
  -- adjacent pieces meet
  have hadj : ∀ i j, (∃ s ∈ generators, g j = g i * s) → (C i ∩ C j).Nonempty := by
    rintro i j ⟨s, hs, hij⟩
    obtain ⟨e, he1, he2, he3⟩ := exists_common_interior_point hs
    have hγj : γs j = γs i * toSL2R s := by simp [γs, hij]
    refine ⟨γs i • e, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · have hsub : γs i • (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) ⊆ closure D' := by
        rw [smul_set_union, ← closure_smul, ← closure_smul, ← mul_smul, ← hγj]
        exact union_subset (closure_mono (subset_iUnion (fun k ↦ γs k • 𝒟ᵒ) i))
          (closure_mono (subset_iUnion (fun k ↦ γs k • 𝒟ᵒ) j))
      have : γs i • e ∈ interior (γs i • (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ))) := by
        rw [interior_smul]; exact smul_mem_smul_set he3
      exact interior_mono hsub this
    · rw [closure_smul]; exact smul_mem_smul_set he1
    · have hsub : γs i • (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ)) ⊆ closure D' := by
        rw [smul_set_union, ← closure_smul, ← closure_smul, ← mul_smul, ← hγj]
        exact union_subset (closure_mono (subset_iUnion (fun k ↦ γs k • 𝒟ᵒ) i))
          (closure_mono (subset_iUnion (fun k ↦ γs k • 𝒟ᵒ) j))
      have : γs i • e ∈ interior (γs i • (closure 𝒟ᵒ ∪ closure (toSL2R s • 𝒟ᵒ))) := by
        rw [interior_smul]; exact smul_mem_smul_set he3
      exact interior_mono hsub this
    · rw [hγj, mul_smul, closure_smul]
      exact smul_mem_smul_set he2
  have hrel : ∀ i j, (fun i j ↦ ∃ s ∈ generators, g j = g i * s ∨ g i = g j * s) i j →
      (C i ∩ C j).Nonempty := by
    rintro i j ⟨s, hs, h | h⟩
    · exact hadj i j ⟨s, hs, h⟩
    · rw [inter_comm]; exact hadj j i ⟨s, hs, h⟩
  have hK : ∀ i j, Relation.ReflTransGen (fun i j ↦ (C i ∩ C j).Nonempty) i j := by
    intro i j
    have hlift : ∀ a b, Relation.ReflTransGen
        (fun i j ↦ ∃ s ∈ generators, g j = g i * s ∨ g i = g j * s) a b →
        Relation.ReflTransGen (fun i j ↦ (C i ∩ C j).Nonempty) a b := by
      intro a b h
      induction h with
      | refl => exact .refl
      | tail _ hbc ih => exact ih.tail (hrel _ _ hbc)
    have hi := hlift _ _ (hreach i)
    have hj := hlift _ _ (hreach j)
    have hsym : ∀ a b, Relation.ReflTransGen (fun i j ↦ (C i ∩ C j).Nonempty) a b →
        Relation.ReflTransGen (fun i j ↦ (C i ∩ C j).Nonempty) b a := by
      intro a b h
      induction h with
      | refl => exact .refl
      | tail _ hbc ih => exact Relation.ReflTransGen.head (by rwa [inter_comm]) ih
    exact (hsym _ _ hi).trans hj
  have hUpre : IsPreconnected U := by
    rw [hUC]; exact IsPreconnected.iUnion_of_reflTransGen hCpre hK
  have hUne : U.Nonempty := by
    obtain ⟨z, hz⟩ := (isConnected_smul_fdo (γs i₀)).nonempty
    exact ⟨z, hD'U (mem_iUnion.2 ⟨i₀, hz⟩)⟩
  have hUconn : IsConnected U := ⟨hUne, hUpre⟩
  have hclosure : closure U = closure D' :=
    Subset.antisymm (closure_minimal hUcl isClosed_closure) (closure_mono hD'U)
  refine ⟨γs, hmem, hcos, ?_, isFundamentalDomain_interior_closure hΓ' isFundamentalDomain_fdo γs hmem hcos hUconn⟩
  rw [← hclosure]
  exact hUconn.closure

end ModularFormsKB.Milne.Wave6
