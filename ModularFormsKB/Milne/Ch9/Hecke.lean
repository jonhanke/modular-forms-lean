import ModularFormsKB.Milne.Ch9.Mellin
import ModularFormsKB.Miyake.Sec4_3.Hecke

/-!
# Milne, Chapter 9: Hecke's theorem (Theorem 9.3)

J. S. Milne, *Modular Functions and Modular Forms*, version 1.31 (`milne2017mf`), Section 9, pdf pp. 102–103.

**Theorem 9.3** (`ModularFormsKB.Milne.hecke_theorem`) is deduced from the repository's proof of Miyake's
Theorem 4.3.5 (`Miyake.hecke`) with Miyake's level $N = \lambda^2$ and second sequence $b = C a$: Milne's
$f(z) = \sum a_n e^{2\pi i n z/\lambda}$ is Miyake's $q$-series at $z/\lambda$, and Milne's
$\Phi(s) = (2\pi/\lambda)^{-s}\Gamma(s)\varphi(s)$ is Miyake's $\Lambda_{\lambda^2}(s; f)$.

**Reading of condition (i).** Milne: "the function $\Phi(s) + \frac{a_0}{s} + \frac{Ca_0}{k-s}$ can be analytically
continued to a holomorphic function on the entire complex plane which is bounded on vertical strips, and it satisfies
the functional equation $\Phi(k-s) = C\Phi(s)$." Formally: there is an entire function $\Psi$, bounded on vertical
strips (`ModularFormsKB.Milne.BoundedOnVerticalStrips`), equal to $\Phi(s) + a_0/s + Ca_0/(k-s)$ on a right half-plane
(where the Dirichlet series converges), and the continuation $\tilde\Phi(s) = \Psi(s) - a_0/s - Ca_0/(k-s)$ of $\Phi$
satisfies $\tilde\Phi(k-s) = C\tilde\Phi(s)$ for $s \ne 0, k$. Since $C = \pm 1$, the functional equation of
$\tilde\Phi$ is equivalent to $\Psi(k-s) = C\Psi(s)$.

**Remark 9.4** (not a result) restates the theorem as a correspondence with modular forms of weight $k$ and
multiplier $C$ for the group generated by $z \mapsto z + \lambda$ and $z \mapsto -1/z$; that is the content of
`hecke_theorem`.
-/

open Complex Filter Asymptotics
open scoped Real Topology

noncomputable section

namespace ModularFormsKB.Milne

/-- Milne's $\Phi(s) = (2\pi/\lambda)^{-s}\Gamma(s)\varphi(s)$, $\varphi(s) = \sum_{n\ge1}a_nn^{-s}$
(Theorem 9.3 (b)). -/
def heckePhi (lam : ℝ) (a : ℕ → ℂ) (s : ℂ) : ℂ :=
  ((2 * π / lam : ℝ) : ℂ) ^ (-s) * Gamma s * LSeries a s

/-- Milne's $f(z) = \sum_{n \ge 0} a_n e^{2\pi i n z/\lambda}$ (Theorem 9.3 (c)). -/
def heckeF (lam : ℝ) (a : ℕ → ℂ) (z : ℂ) : ℂ :=
  ∑' n : ℕ, a n * cexp (2 * π * I * n * z / lam)

/-- Identity theorem: two entire functions that agree on a right half-plane are equal. -/
lemma eq_of_eq_on_halfplane {f g : ℂ → ℂ} (hf : Differentiable ℂ f) (hg : Differentiable ℂ g)
    (σ : ℝ) (h : ∀ s : ℂ, σ < s.re → f s = g s) : f = g := by
  have hU : IsOpen {s : ℂ | σ < s.re} := isOpen_lt continuous_const Complex.continuous_re
  have h0 : ((σ + 1 : ℝ) : ℂ) ∈ {s : ℂ | σ < s.re} := by simp
  have := AnalyticOnNhd.eqOn_of_preconnected_of_eventuallyEq (U := Set.univ)
    (fun z _ ↦ hf.analyticAt z) (fun z _ ↦ hg.analyticAt z) isPreconnected_univ
    (Set.mem_univ ((σ + 1 : ℝ) : ℂ))
    (Filter.eventuallyEq_of_mem (hU.mem_nhds h0) (fun s hs ↦ h s hs))
  exact funext fun s ↦ this (Set.mem_univ s)

/-- $f(z) = \sum a_n e^{2\pi i n z/\lambda}$ is the $q$-series at $z/\lambda$. -/
lemma heckeF_eq (lam : ℝ) (a : ℕ → ℂ) (z : ℂ) : heckeF lam a z = Miyake.qSeries a (z / lam) := by
  unfold heckeF Miyake.qSeries
  refine tsum_congr fun n => ?_
  refine congrArg (fun y => a n * y) (congrArg Complex.exp ?_)
  ring

/-- Milne's $\Phi$ is Miyake's $\Lambda_{\lambda^2}$. -/
lemma heckePhi_eq {lam : ℝ} (hlam : 0 < lam) (a : ℕ → ℂ) :
    heckePhi lam a = Miyake.completedL (lam ^ 2) a := by
  funext s
  simp only [heckePhi, Miyake.completedL, Real.sqrt_sq hlam.le]

lemma aux_cpow_iff (u : ℂ) (hu : u ≠ 0) (k C X Y : ℂ) :
    X = C * u ^ k * Y ↔ C * Y = u ^ (-k) * X := by
  have h : u ^ k ≠ 0 := by rw [Ne, cpow_eq_zero_iff]; tauto
  rw [cpow_neg]
  constructor
  · rintro rfl; field_simp
  · intro h2; field_simp at h2 ⊢; linear_combination -h2

/-- Pointwise form of the translation between Milne's (ii) and Miyake's (A), at $z = \lambda w$. -/
lemma cond_pointwise {lam : ℝ} (hlam : 0 < lam) {k : ℝ} (C : ℂ) (a : ℕ → ℂ) (w : ℂ) (hw : 0 < w.im) :
    heckeF lam a (-1 / (lam * w)) = C * ((lam * w : ℂ) / I) ^ (k : ℂ) * heckeF lam a (lam * w) ↔
      Miyake.qSeries (fun n ↦ C * a n) w =
        (-I * (lam : ℂ) * w) ^ (-(k : ℂ)) * Miyake.qSeries a (-1 / (((lam ^ 2 : ℝ) : ℂ) * w)) := by
  have hl : (lam : ℂ) ≠ 0 := by exact_mod_cast hlam.ne'
  have hw0 : w ≠ 0 := by rintro rfl; simp at hw
  rw [heckeF_eq, heckeF_eq, Miyake.qSeries_const_mul]
  have e1 : -1 / ((lam : ℂ) * w) / lam = -1 / (((lam ^ 2 : ℝ) : ℂ) * w) := by
    push_cast; field_simp
  have e2 : (lam : ℂ) * w / lam = w := by field_simp
  have e3 : ((lam : ℂ) * w) / I = -I * (lam : ℂ) * w := by
    rw [div_eq_mul_inv, inv_I]; ring
  rw [e1, e2, e3]
  exact aux_cpow_iff _ (by simp [hl, hw0]) _ _ _ _

/-- **Milne, Theorem 9.3** (Hecke 1936). Let $a_0, a_1, \dots$ be complex numbers with $a_n = O(n^M)$, let
$\lambda > 0$, $k > 0$ real and $C = \pm 1$, and write $\varphi(s) = \sum_{n\ge1} a_n n^{-s}$,
$\Phi(s) = (2\pi/\lambda)^{-s}\Gamma(s)\varphi(s)$, $f(z) = \sum_{n\ge0} a_n e^{2\pi i n z/\lambda}$. The following are
equivalent:

(i) $\Phi(s) + \frac{a_0}{s} + \frac{Ca_0}{k-s}$ continues to an entire function $\Psi$, bounded on vertical strips,
and the continuation of $\Phi$ satisfies $\Phi(k-s) = C\Phi(s)$ (see the module docstring for the reading);

(ii) $f(-1/z) = C(z/i)^k f(z)$ on the upper half plane (principal branch: $\operatorname{Re}(z/i) > 0$). -/
@[kb "milne2017mf" "Section 9, Theorem 9.3 (Hecke) (pdf p. 102)"]
theorem hecke_theorem {k lam : ℝ} (hk : 0 < k) (hlam : 0 < lam) {C : ℂ} (hC : C = 1 ∨ C = -1)
    {a : ℕ → ℂ} {M : ℝ} (ha : a =O[atTop] fun n : ℕ ↦ (n : ℝ) ^ M) :
    (∃ Ψ : ℂ → ℂ, Differentiable ℂ Ψ ∧ BoundedOnVerticalStrips Ψ ∧
      (∃ σ₀ : ℝ, ∀ s : ℂ, σ₀ < s.re → Ψ s = heckePhi lam a s + a 0 / s + C * a 0 / (k - s)) ∧
      ∀ s : ℂ, s ≠ 0 → s ≠ k →
        Ψ (k - s) - a 0 / (k - s) - C * a 0 / (k - (k - s)) =
          C * (Ψ s - a 0 / s - C * a 0 / (k - s))) ↔
    ∀ z : ℂ, 0 < z.im → heckeF lam a (-1 / z) = C * (z / I) ^ (k : ℂ) * heckeF lam a z := by
  have hCC : C * C = 1 := by rcases hC with rfl | rfl <;> norm_num
  have haG : Miyake.CoeffGrowth a := ⟨M, ha⟩
  have hbG : Miyake.CoeffGrowth (fun n ↦ C * a n) := haG.const_mul C
  have H := Miyake.hecke hk (N := lam ^ 2) (by positivity) haG hbG
  rw [Real.sqrt_sq hlam.le] at H
  have hii : (∀ z : ℂ, 0 < z.im → heckeF lam a (-1 / z) = C * (z / I) ^ (k : ℂ) * heckeF lam a z) ↔
      ∀ z : ℂ, 0 < z.im → Miyake.qSeries (fun n ↦ C * a n) z =
        (-I * (lam : ℂ) * z) ^ (-(k : ℂ)) * Miyake.qSeries a (-1 / (((lam ^ 2 : ℝ) : ℂ) * z)) := by
    constructor
    · intro h w hw
      have hl : (0 : ℝ) < lam := hlam
      exact (cond_pointwise hlam C a w hw).1 (h (lam * w) (by simpa [hlam] using hw))
    · intro h z hz
      have hl : (lam : ℂ) ≠ 0 := by exact_mod_cast hlam.ne'
      have hz' : 0 < (z / lam).im := by rw [Complex.div_ofReal_im]; positivity
      have := (cond_pointwise hlam C a (z / lam) hz').2 (h (z / lam) hz')
      rwa [mul_div_cancel₀ _ hl] at this
  rw [hii, H, iff_comm]
  unfold Miyake.HeckeCondition
  constructor
  · rintro ⟨Φ, hd, hb, σ₀, hR, hL⟩
    have key : ∀ s, Φ (k - s) = C * Φ s := by
      have := eq_of_eq_on_halfplane (f := fun s ↦ Φ (k - s)) (g := fun s ↦ C * Φ s)
        (hd.comp ((differentiable_const _).sub differentiable_id)) ((differentiable_const _).mul hd) σ₀
        (fun s hs ↦ by
          have h1 := hL (k - s) (by simpa using hs)
          have h2 := hR s hs
          simp only [sub_sub_cancel, Miyake.completedL_const_mul, one_mul] at h1 h2
          rw [h1, h2]
          linear_combination (-(a 0) / (k - s)) * hCC)
      exact fun s ↦ congrFun this s
    refine ⟨Φ, hd, (boundedOnVerticalStrips_iff hd.continuous).2 hb, ⟨σ₀, fun s hs ↦ ?_⟩, ?_⟩
    · rw [hR s hs, heckePhi_eq hlam]
      simp only [one_mul]
    · intro s _ _
      rw [key s]
      simp only [sub_sub_cancel]
      linear_combination (a 0 / (k - s)) * hCC
  · rintro ⟨Ψ, hd, hb, ⟨σ₀, hR⟩, hFE⟩
    refine ⟨Ψ, hd, (boundedOnVerticalStrips_iff hd.continuous).1 hb, max σ₀ k, ?_, ?_⟩
    · intro s hs
      rw [hR s (lt_of_le_of_lt (le_max_left _ _) hs), heckePhi_eq hlam]
      simp only [one_mul]
    · intro s hs
      have hk' : (k : ℝ) < k - s.re := lt_of_le_of_lt (le_max_right _ _) hs
      have hsre : s.re < 0 := by linarith
      have hs0 : s ≠ 0 := by rintro rfl; simp at hsre
      have hsk : s ≠ k := by rintro rfl; simp at hsre; linarith
      have h1 := hFE (k - s) (sub_ne_zero.2 hsk.symm) (by
        intro h; apply hs0; simpa using h)
      have h2 := hR (k - s) (by
        have := lt_of_le_of_lt (le_max_left _ _) hs
        simpa using this)
      simp only [sub_sub_cancel] at h1 h2
      rw [h2] at h1
      rw [heckePhi_eq hlam] at h1
      simp only [Miyake.completedL_const_mul, one_mul]
      linear_combination h1

end ModularFormsKB.Milne
