import ModularFormsKB.Andrianov.ModularGroup
import Mathlib.Analysis.Matrix.Order

/-!
# Andrianov–Zhuravlev, Chapter 1, §2–§3: generators and transitivity

A. N. Andrianov and V. G. Zhuravlev, *Modular Forms and Hecke Operators* (`andrianovzhuravlev1995`), Chapter 1.

* Theorem 2.2 (pdf p. 18): `Sp_n(ℝ)` is generated by `U(V)` (`V ∈ GL_n(ℝ)`), `T(S)` (`S` real symmetric) and `J_n`
  (named statement `SymplecticGeneration`).
* Proposition 2.4 (pdf p. 18): `Sp_n(ℝ)` acts transitively on `H_n`; more precisely
  `T(X) U(A⁻¹)⟨iE_n⟩ = X + i ᵗA A` (`moebius_Tmat_Umat_iE`), and every `Y > 0` is `ᵗA A` (`exists_transpose_mul_self`),
  so every `Z = X + iY` is in the orbit of `iE_n` (`exists_smul_iE`).
* Theorem 3.6 (pdf p. 26): `Γ_n` is generated by `U(V)` (`V ∈ GL_n(ℤ)`), `T(S)` (`S` integral symmetric) and `J_n`
  (named statement `SiegelModularGroupGeneration`).
-/

open Matrix

namespace ModularFormsKB.Andrianov

variable {n : ℕ}

/-- The set of generators (2.2)–(2.4) of `Sp_n(R)` over a commutative ring `R`: `U(V)` for invertible `V`, `T(S)`
for symmetric `S`, and `J_n`. -/
def symplecticGenerators (n : ℕ) (R : Type*) [CommRing R] : Set (symplecticGroup (Fin n) R) :=
  {M | (∃ V : (Matrix (Fin n) (Fin n) R)ˣ, (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) = Umat V) ∨
    (∃ S : Matrix (Fin n) (Fin n) R, Sᵀ = S ∧ (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) = Tmat S) ∨
    (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) = Jn n R}

/-- **Andrianov–Zhuravlev, Chapter 1, Theorem 2.2**, named statement: the real symplectic group of degree `n` is
generated by the matrices (2.2)–(2.4). -/
@[kb "andrianovzhuravlev1995" "Chapter 1, Theorem 2.2, p. 18"]
structure SymplecticGeneration (n : ℕ) : Prop where
  closure_eq : Subgroup.closure (symplecticGenerators n ℝ) = ⊤

/-- **Andrianov–Zhuravlev, Chapter 1, Theorem 3.6**, named statement: the Siegel modular group `Γ_n` is generated by
`U(V)` (`V ∈ GL_n(ℤ)`), `T(S)` (`S` integral symmetric) and `J_n`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, Theorem 3.6, p. 26"]
structure SiegelModularGroupGeneration (n : ℕ) : Prop where
  closure_eq : Subgroup.closure (symplecticGenerators n ℤ) = ⊤

section Transitive

open scoped MatrixOrder

/-- A real positive definite matrix is `ᵗA A` for an invertible real `A` (the book's "there exists `A ∈ GL_n(ℝ)` with
`ᵗA A = Y`" in the proof of Proposition 2.4); here `A` is the positive square root of `Y`. -/
theorem exists_transpose_mul_self {Y : Matrix (Fin n) (Fin n) ℝ} (hY : Y.PosDef) :
    ∃ A : (Matrix (Fin n) (Fin n) ℝ)ˣ, (A : Matrix (Fin n) (Fin n) ℝ)ᵀ * A = Y := by
  have h0 : 0 ≤ Y := Matrix.nonneg_iff_posSemidef.2 hY.posSemidef
  have hsq : CFC.sqrt Y * CFC.sqrt Y = Y := CFC.sqrt_mul_sqrt_self Y h0
  have hdet : IsUnit (CFC.sqrt Y).det := by
    have h := congrArg det hsq
    rw [det_mul] at h
    have hY' : IsUnit Y.det := isUnit_iff_ne_zero.2 hY.det_pos.ne'
    rw [← h] at hY'
    exact isUnit_of_mul_isUnit_left hY'
  have hT : (CFC.sqrt Y)ᵀ = CFC.sqrt Y := by
    have h := (CFC.sqrt_nonneg Y).isSelfAdjoint.star_eq
    rwa [star_eq_conjTranspose, conjTranspose_eq_transpose_of_trivial] at h
  obtain ⟨u, hu⟩ := (Matrix.isUnit_iff_isUnit_det _).2 hdet
  exact ⟨u, by rw [hu, hT, hsq]⟩

/-- `Z = X + iY` with `X = Re Z`, `Y = Im Z`. -/
theorem SiegelSpace.eq_re_add_im (Z : SiegelSpace n) :
    (Z : Matrix (Fin n) (Fin n) ℂ) = cx Z.re + Complex.I • cx Z.im := by
  ext i j
  apply Complex.ext <;> simp [cx, SiegelSpace.re, SiegelSpace.im]

/-- The proof of Proposition 2.4: `T(X) U(A⁻¹)⟨iE_n⟩ = X + i ᵗA A`. -/
theorem moebius_Tmat_Umat_iE (X : Matrix (Fin n) (Fin n) ℝ) (hX : Xᵀ = X) (A : (Matrix (Fin n) (Fin n) ℝ)ˣ) :
    moebius (Tmat X * Umat A⁻¹) (SiegelSpace.iE n : Matrix (Fin n) (Fin n) ℂ) =
      cx X + Complex.I • cx ((A : Matrix (Fin n) (Fin n) ℝ)ᵀ * (A : Matrix (Fin n) (Fin n) ℝ)) := by
  rw [moebius_mul _ (Umat_mem A⁻¹), moebius_Umat, moebius_Tmat, inv_inv]
  simp only [SiegelSpace.iE, Matrix.mul_smul, Matrix.mul_one, cx_mul]
  rw [add_comm, Matrix.smul_mul]

/-- **Andrianov–Zhuravlev, Chapter 1, Proposition 2.4.** The action of `Sp_n(ℝ)` on `H_n` is transitive: every
`Z ∈ H_n` is `M⟨iE_n⟩` for some `M ∈ Sp_n(ℝ)`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, Proposition 2.4, p. 18"]
theorem exists_smul_iE (Z : SiegelSpace n) : ∃ M : symplecticGroup (Fin n) ℝ, M • SiegelSpace.iE n = Z := by
  obtain ⟨A, hA⟩ := exists_transpose_mul_self Z.im_posDef
  have hX : Z.reᵀ = Z.re := by
    ext i j
    have := congrFun (congrFun Z.transpose_eq i) j
    simp only [SiegelSpace.re, transpose_apply, map_apply] at this ⊢
    rw [this]
  refine ⟨⟨Tmat Z.re * Umat A⁻¹, mul_mem (Tmat_mem hX) (Umat_mem A⁻¹)⟩, Subtype.ext ?_⟩
  rw [coe_smul]
  show moebius (Tmat Z.re * Umat A⁻¹) (SiegelSpace.iE n : Matrix (Fin n) (Fin n) ℂ) = Z
  rw [moebius_Tmat_Umat_iE _ hX, hA, ← SiegelSpace.eq_re_add_im]

end Transitive

end ModularFormsKB.Andrianov
