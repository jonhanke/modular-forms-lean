import ModularFormsKB.Andrianov.SiegelSpace
import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Group.Subgroup.Ker

/-!
# Andrianov–Zhuravlev: the Siegel modular group, congruence subgroups and the theta group

A. N. Andrianov and V. G. Zhuravlev, *Modular Forms and Hecke Operators* (`andrianovzhuravlev1995`):

* Chapter 1, (3.8): the Siegel modular group `Γ_n = Sp_n(ℤ)` (`SiegelModularGroup n`), acting on `H_n` through
  `Sp_n(ℝ)`.
* Chapter 1, (3.9): the vector `ζ(M) = (dc(B ᵗA), dc(C ᵗD)) ∈ ℤ^{2n}` (`zeta`), Lemma 3.3 (`zeta_mul_modEq`).
* Chapter 1, Theorem 3.10: the theta group `Θ_n = {M ∈ Γ_n ; ζ(M) ≡ 0 (mod 2)}` is a subgroup (`thetaGroup`).
  The functional equation for theta functions in the same theorem is stated in `ThetaSeries.lean`.
* Chapter 1, (3.28) and Chapter 2, (2.1)–(2.2): `Γ_0^n(q)` (`gammaZero`), the principal congruence subgroup
  `Γ^n(q)` (`principalCongruence`), and congruence subgroups.
* Chapter 1, Theorem 3.6: `Γ_n` is generated by `U(V)` (`V ∈ GL_n(ℤ)`), `T(S)` (`S` integral symmetric) and `J_n`
  (named statement `SiegelModularGroupGeneration`).

Here `dc(S)` is the column of diagonal entries of `S`. Indices `Fin n ⊕ Fin n` replace the book's `1, …, 2n`.
-/

open Matrix

namespace ModularFormsKB.Andrianov

variable (n : ℕ)

/-- **Andrianov–Zhuravlev (3.8).** The Siegel modular group of degree `n`: integral symplectic matrices. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, (3.8), p. 24"]
abbrev SiegelModularGroup : Type := symplecticGroup (Fin n) ℤ

variable {n}

/-- The inclusion `Γ_n → Sp_n(ℝ)`. -/
def SiegelModularGroup.toReal : SiegelModularGroup n →* symplecticGroup (Fin n) ℝ where
  toFun M := ⟨(M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).map (Int.castRingHom ℝ), SymplecticGroup.map_mem M.2 _⟩
  map_one' := by ext : 1; simp
  map_mul' M N := by ext : 1; exact Matrix.map_mul

theorem SiegelModularGroup.toReal_coe (M : SiegelModularGroup n) :
    (SiegelModularGroup.toReal M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℝ) =
      (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).map (Int.castRingHom ℝ) := rfl

/-- `Γ_n` acts on `H_n` through `Sp_n(ℝ)`. -/
noncomputable instance : MulAction (SiegelModularGroup n) (SiegelSpace n) :=
  MulAction.compHom _ SiegelModularGroup.toReal

/-- The inverse of a symplectic matrix, (2.9): `M⁻¹ = (ᵗD -ᵗB; -ᵗC ᵗA)`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, (2.9), p. 17"]
theorem SiegelModularGroup.coe_inv {R : Type*} [CommRing R] (M : symplecticGroup (Fin n) R) :
    ((M⁻¹ : symplecticGroup (Fin n) R) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R) =
      fromBlocks (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R).toBlocks₂₂ᵀ (-(M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R).toBlocks₁₂ᵀ)
        (-(M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R).toBlocks₂₁ᵀ) (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R).toBlocks₁₁ᵀ := by
  rw [SymplecticGroup.coe_inv]
  conv_lhs => rw [← fromBlocks_toBlocks (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) R)]
  simp [Matrix.J, fromBlocks_transpose, fromBlocks_multiply, fromBlocks_neg]

/-- **Andrianov–Zhuravlev (3.28) of Chapter 1.** `Γ_0^n(q) = {M ∈ Γ_n ; C ≡ 0 (mod q)}`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, (3.28), p. 32"]
def gammaZero (n q : ℕ) : Subgroup (SiegelModularGroup n) where
  carrier := {M | ∀ i j, (q : ℤ) ∣ (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).toBlocks₂₁ i j}
  one_mem' i j := by
    obtain ⟨-, -, h, -⟩ := toBlocks_one_eq (n := n) (R := ℤ)
    simp [h]
  mul_mem' {M N} hM hN i j := by
    obtain ⟨-, -, h, -⟩ := toBlocks_mul (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) (N : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ)
    show (q : ℤ) ∣ ((M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) * N).toBlocks₂₁ i j
    rw [h, Matrix.add_apply, Matrix.mul_apply, Matrix.mul_apply]
    exact dvd_add (Finset.dvd_sum fun k _ => dvd_mul_of_dvd_left (hM i k) _)
      (Finset.dvd_sum fun k _ => dvd_mul_of_dvd_right (hN k j) _)
  inv_mem' {M} hM i j := by
    show (q : ℤ) ∣ ((M⁻¹ : SiegelModularGroup n) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).toBlocks₂₁ i j
    rw [SiegelModularGroup.coe_inv, toBlocks_fromBlocks₂₁]
    simpa using hM j i

/-- **Andrianov–Zhuravlev, Chapter 2, (2.1).** The principal congruence subgroup
`Γ^n(q) = {M ∈ Γ_n ; M ≡ E_{2n} (mod q)}`. -/
@[kb "andrianovzhuravlev1995" "Chapter 2, (2.1), p. 69"]
def principalCongruence (n q : ℕ) : Subgroup (SiegelModularGroup n) where
  carrier := {M | (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).map (Int.castRingHom (ZMod q)) = 1}
  one_mem' := by simp
  mul_mem' {M N} hM hN := by
    simp only [Set.mem_ofPred_eq, Submonoid.coe_mul, Subgroup.coe_toSubmonoid, Matrix.map_mul] at *
    rw [hM, hN, Matrix.mul_one]
  inv_mem' {M} hM := by
    simp only [Set.mem_ofPred_eq] at *
    have h := congrArg (fun X => X.map (Int.castRingHom (ZMod q)))
      (congrArg Subtype.val (inv_mul_cancel M))
    simp only [Submonoid.coe_mul, Subgroup.coe_toSubmonoid, Matrix.map_mul, hM, Matrix.mul_one] at h
    simpa using h

/-- **Andrianov–Zhuravlev, Chapter 2, (2.2).** A congruence subgroup: `Γ^n(q) ⊆ K ⊆ Γ_n` for some `q ≥ 1`. -/
@[kb "andrianovzhuravlev1995" "Chapter 2, (2.2), p. 69"]
def IsCongruenceSubgroup (K : Subgroup (SiegelModularGroup n)) : Prop :=
  ∃ q : ℕ, 0 < q ∧ principalCongruence n q ≤ K

/-- **Andrianov–Zhuravlev (3.9).** `ζ(M) = (dc(B ᵗA), dc(C ᵗD)) ∈ ℤ^{2n}` for `M = (A B; C D)`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, (3.9), p. 24"]
def zeta (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) : Fin n ⊕ Fin n → ℤ :=
  Sum.elim (fun i => (M.toBlocks₁₂ * M.toBlocks₁₁ᵀ) i i) (fun i => (M.toBlocks₂₁ * M.toBlocks₂₂ᵀ) i i)

/-- `ζ(M)` reduced modulo `2`. -/
def zeta2 (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) : Fin n ⊕ Fin n → ZMod 2 :=
  fun i => (zeta M i : ZMod 2)

/-- Over `ZMod 2`, `diag(X P ᵗX)_i = ∑_j X_ij P_jj` for symmetric `P`. -/
theorem diag_sandwich (X P : Matrix (Fin n) (Fin n) (ZMod 2)) (hP : Pᵀ = P) (i : Fin n) :
    (X * P * Xᵀ) i i = ∑ j, X i j * P j j := by
  have h1 : (X * P * Xᵀ) i i = ∑ x : Fin n × Fin n, X i x.1 * P x.1 x.2 * X i x.2 := by
    simp only [Matrix.mul_apply, transpose_apply, Finset.sum_mul, Fintype.sum_prod_type]
    rw [Finset.sum_comm]
  rw [h1, ← Finset.sum_filter_add_sum_filter_not Finset.univ (fun x : Fin n × Fin n => x.1 = x.2)]
  have h2 : ∑ x ∈ Finset.univ.filter (fun x : Fin n × Fin n => ¬ x.1 = x.2),
      X i x.1 * P x.1 x.2 * X i x.2 = 0 := by
    refine Finset.sum_involution (fun x _ => (x.2, x.1)) ?_ ?_ ?_ ?_
    · intro x hx
      have hs : P x.2 x.1 = P x.1 x.2 := by simpa using congrFun (congrFun hP x.1) x.2
      simp only [hs]
      have : ∀ a : ZMod 2, a + a = 0 := by decide
      rw [show X i x.2 * P x.1 x.2 * X i x.1 = X i x.1 * P x.1 x.2 * X i x.2 by ring]
      exact this _
    · intro x hx _ h
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
      exact hx (by simpa [Prod.ext_iff, eq_comm] using h)
    · intro x hx
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
      exact fun h => hx h.symm
    · intro x _; rfl
  rw [h2, add_zero]
  have h3 : ∑ x ∈ Finset.univ.filter (fun x : Fin n × Fin n => x.1 = x.2),
      X i x.1 * P x.1 x.2 * X i x.2 = ∑ j, X i j * P j j * X i j := by
    refine Finset.sum_bij (fun x _ => x.1) ?_ ?_ ?_ ?_
    · intros; simp
    · intro a ha b hb h
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at ha hb
      exact Prod.ext h (by rw [← ha, ← hb]; exact h)
    · intro j _; exact ⟨(j, j), by simp, rfl⟩
    · intro x hx
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
      obtain ⟨a, b⟩ := x
      simp only at hx ⊢
      subst hx; rfl
  rw [h3]
  refine Finset.sum_congr rfl fun j _ => ?_
  have : ∀ a : ZMod 2, a * a = a := by decide
  rw [mul_assoc, mul_comm (P j j), ← mul_assoc, this]

/-- Diagonal of `(X u + Y v)(X u' + Y v')ᵀ` over `ZMod 2`. -/
theorem diag_expand (X Y u u' v v' : Matrix (Fin n) (Fin n) (ZMod 2))
    (hu : (u * u'ᵀ)ᵀ = u * u'ᵀ) (hv : (v * v'ᵀ)ᵀ = v * v'ᵀ) (i : Fin n) :
    ((X * u + Y * v) * (X * u' + Y * v')ᵀ) i i = ∑ j, X i j * (u * u'ᵀ) j j +
      ∑ j, Y i j * (v * v'ᵀ) j j + (X * (u * v'ᵀ + u' * vᵀ) * Yᵀ) i i := by
  have h : (X * u + Y * v) * (X * u' + Y * v')ᵀ = X * (u * u'ᵀ) * Xᵀ + Y * (v * v'ᵀ) * Yᵀ
      + (X * (u * v'ᵀ) * Yᵀ + (X * (u' * vᵀ) * Yᵀ)ᵀ) := by
    simp only [transpose_add, transpose_mul, transpose_transpose, Matrix.mul_add, Matrix.add_mul,
      Matrix.mul_assoc]
    abel
  have h' : (X * (u * v'ᵀ + u' * vᵀ) * Yᵀ) i i =
      (X * (u * v'ᵀ) * Yᵀ + (X * (u' * vᵀ) * Yᵀ)ᵀ) i i := by
    simp only [Matrix.mul_add, Matrix.add_mul, Matrix.add_apply, Matrix.transpose_apply]
  rw [h, h']
  simp only [Matrix.add_apply, diag_sandwich _ _ hu, diag_sandwich _ _ hv]

/-- The `ZMod 2` core of Lemma 3.3, in terms of the blocks of `M` and `M₁`. -/
theorem zeta_core (A B C D A₁ B₁ C₁ D₁ : Matrix (Fin n) (Fin n) (ZMod 2))
    (hs : A * Bᵀ = B * Aᵀ)
    (hs1 : A₁ * B₁ᵀ = B₁ * A₁ᵀ) (hs2 : C₁ * D₁ᵀ = D₁ * C₁ᵀ) (hd : A₁ * D₁ᵀ - B₁ * C₁ᵀ = 1) :
    (∀ i, ((A * B₁ + B * D₁) * (A * A₁ + B * C₁)ᵀ) i i =
      ∑ j, A i j * (B₁ * A₁ᵀ) j j + ∑ j, B i j * (C₁ * D₁ᵀ) j j + (B * Aᵀ) i i) ∧
    (∀ i, ((C * A₁ + D * C₁) * (C * B₁ + D * D₁)ᵀ) i i =
      ∑ j, C i j * (B₁ * A₁ᵀ) j j + ∑ j, D i j * (C₁ * D₁ᵀ) j j + (C * Dᵀ) i i) := by
  have h2 : ∀ M : Matrix (Fin n) (Fin n) (ZMod 2), M + M = 0 := by
    intro M; ext i j
    simp only [Matrix.add_apply, Matrix.zero_apply]
    exact (by decide : ∀ a : ZMod 2, a + a = 0) _
  have hc : B₁ * C₁ᵀ + A₁ * D₁ᵀ = 1 := by
    have : A₁ * D₁ᵀ = 1 + B₁ * C₁ᵀ := by rw [← hd]; abel
    rw [this, add_comm 1, ← add_assoc, h2, zero_add]
  have hc' : A₁ * D₁ᵀ + B₁ * C₁ᵀ = 1 := by rw [add_comm]; exact hc
  have e1 : (B₁ * A₁ᵀ)ᵀ = B₁ * A₁ᵀ := by rw [transpose_mul, transpose_transpose, ← hs1]
  have e2 : (A₁ * B₁ᵀ)ᵀ = A₁ * B₁ᵀ := by rw [transpose_mul, transpose_transpose, hs1]
  have e3 : (D₁ * C₁ᵀ)ᵀ = D₁ * C₁ᵀ := by rw [transpose_mul, transpose_transpose, ← hs2]
  have e4 : (C₁ * D₁ᵀ)ᵀ = C₁ * D₁ᵀ := by rw [transpose_mul, transpose_transpose, hs2]
  constructor
  · intro i
    rw [diag_expand A B B₁ A₁ D₁ C₁ e1 e3, hc, Matrix.mul_one, hs, ← hs2]
  · intro i
    rw [diag_expand C D A₁ B₁ C₁ D₁ e2 e4, hc', Matrix.mul_one, hs1]

/-- The cast of an integer matrix entry is the entry of the cast matrix. -/
theorem cast_diag (X : Matrix (Fin n) (Fin n) ℤ) (i : Fin n) :
    ((X i i : ℤ) : ZMod 2) = ((Int.castRingHom (ZMod 2)).mapMatrix X) i i := by simp

/-- Lemma 3.3 for symplectic integral matrices (no coercions). -/
theorem zeta2_mul_aux (P Q : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ)
    (hP : P ∈ symplecticGroup (Fin n) ℤ) (hQ : Q ∈ symplecticGroup (Fin n) ℤ) :
    zeta2 (P * Q) = P.map (Int.castRingHom (ZMod 2)) *ᵥ zeta2 Q + zeta2 P := by
  obtain ⟨h11, h12, h21, h22⟩ := toBlocks_mul P Q
  obtain ⟨s1, -, -⟩ := blocks_of_mem' hP
  obtain ⟨t1, t2, t3⟩ := blocks_of_mem' hQ
  have mp : ∀ X Y : Matrix (Fin n) (Fin n) ℤ, X = Y →
      (Int.castRingHom (ZMod 2)).mapMatrix X = (Int.castRingHom (ZMod 2)).mapMatrix Y :=
    fun X Y h => by rw [h]
  have s1' := mp _ _ s1
  have t1' := mp _ _ t1
  have t2' := mp _ _ t2
  have t3' := mp _ _ t3
  simp only [map_mul, map_sub, map_one, RingHom.mapMatrix_apply, transpose_map] at s1' t1' t2' t3'
  obtain ⟨c1, c2⟩ := zeta_core _ _ (P.toBlocks₂₁.map (Int.castRingHom (ZMod 2)))
    (P.toBlocks₂₂.map (Int.castRingHom (ZMod 2))) _ _ _ _ s1' t1' t2' t3'
  have hT : ∀ X : Matrix (Fin n) (Fin n) ℤ, (Int.castRingHom (ZMod 2)).mapMatrix Xᵀ =
      ((Int.castRingHom (ZMod 2)).mapMatrix X)ᵀ := fun X => by
    simp only [RingHom.mapMatrix_apply, transpose_map]
  have za : ∀ (R : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) (a : Fin n), zeta2 R (Sum.inl a) =
      (R.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) * (R.toBlocks₁₁.map (Int.castRingHom (ZMod 2)))ᵀ) a a := by
    intro R a
    simp only [zeta2, zeta, Sum.elim_inl, cast_diag, map_mul, hT, RingHom.mapMatrix_apply]
  have zb : ∀ (R : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) (a : Fin n), zeta2 R (Sum.inr a) =
      (R.toBlocks₂₁.map (Int.castRingHom (ZMod 2)) * (R.toBlocks₂₂.map (Int.castRingHom (ZMod 2)))ᵀ) a a := by
    intro R a
    simp only [zeta2, zeta, Sum.elim_inr, cast_diag, map_mul, hT, RingHom.mapMatrix_apply]
  funext i
  rcases i with i | i
  · have lhs : zeta2 (P * Q) (Sum.inl i) =
        (((P.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) +
        P.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₂₂.map (Int.castRingHom (ZMod 2))) *
        (P.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) +
        P.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₂₁.map (Int.castRingHom (ZMod 2)))ᵀ)) i i := by
      simp only [zeta2, zeta, Sum.elim_inl, cast_diag, h11, h12]
      simp only [map_mul, map_add, hT]
      simp only [RingHom.mapMatrix_apply]
    rw [Pi.add_apply, lhs, c1 i, Matrix.mulVec, dotProduct, Fintype.sum_sum_type, za P i]
    simp only [za Q, zb Q]
    rfl
  · have lhs : zeta2 (P * Q) (Sum.inr i) =
        (((P.toBlocks₂₁.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₁₁.map (Int.castRingHom (ZMod 2)) +
        P.toBlocks₂₂.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₂₁.map (Int.castRingHom (ZMod 2))) *
        (P.toBlocks₂₁.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₁₂.map (Int.castRingHom (ZMod 2)) +
        P.toBlocks₂₂.map (Int.castRingHom (ZMod 2)) * Q.toBlocks₂₂.map (Int.castRingHom (ZMod 2)))ᵀ)) i i := by
      simp only [zeta2, zeta, Sum.elim_inr, cast_diag, h21, h22]
      simp only [map_mul, map_add, hT]
      simp only [RingHom.mapMatrix_apply]
    rw [Pi.add_apply, lhs, c2 i, Matrix.mulVec, dotProduct, Fintype.sum_sum_type, zb P i]
    simp only [za Q, zb Q]
    rfl

/-- **Andrianov–Zhuravlev, Lemma 3.3.** `ζ(MM₁) ≡ M ζ(M₁) + ζ(M) (mod 2)` for `M, M₁ ∈ Γ_n`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, Lemma 3.3, p. 25"]
theorem zeta2_mul (M M₁ : SiegelModularGroup n) :
    zeta2 ((M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) * (M₁ : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ)) =
      (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ).map (Int.castRingHom (ZMod 2)) *ᵥ zeta2 M₁ + zeta2 M :=
  zeta2_mul_aux _ _ M.2 M₁.2


theorem zeta2_one : zeta2 (1 : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) = 0 := by
  obtain ⟨-, h12, h21, -⟩ := toBlocks_one_eq (n := n) (R := ℤ)
  funext i; cases i <;> simp [zeta2, zeta, h12, h21]

/-- **Andrianov–Zhuravlev, Theorem 3.10 (first part).** The theta group
`Θ_n = {M ∈ Γ_n ; dc(B ᵗA) ≡ dc(C ᵗD) ≡ 0 (mod 2)}` is a subgroup of `Γ_n`. -/
@[kb "andrianovzhuravlev1995" "Chapter 1, Theorem 3.10, p. 29"]
def thetaGroup (n : ℕ) : Subgroup (SiegelModularGroup n) where
  carrier := {M | zeta2 (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) = 0}
  one_mem' := zeta2_one
  mul_mem' {M N} hM hN := by
    simp only [Set.mem_ofPred_eq, Submonoid.coe_mul, Subgroup.coe_toSubmonoid] at *
    rw [zeta2_mul, hM, hN, mulVec_zero, add_zero]
  inv_mem' {M} hM := by
    simp only [Set.mem_ofPred_eq] at *
    have h := zeta2_mul M⁻¹ M
    rw [show ((M⁻¹ : SiegelModularGroup n) : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) * (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) = 1 from
      congrArg Subtype.val (inv_mul_cancel M), zeta2_one, hM, mulVec_zero, zero_add] at h
    exact h.symm

theorem mem_thetaGroup_iff (M : SiegelModularGroup n) :
    M ∈ thetaGroup n ↔ ∀ i, Even (zeta (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) i) := by
  show zeta2 (M : Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℤ) = 0 ↔ _
  rw [funext_iff]
  refine forall_congr' fun i => ?_
  rw [zeta2, Pi.zero_apply, ZMod.intCast_zmod_eq_zero_iff_dvd, even_iff_two_dvd]
  norm_num

end ModularFormsKB.Andrianov
