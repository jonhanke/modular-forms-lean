import ModularFormsKB.Miyake.Wave6.LevelChange
import ModularFormsKB.Miyake.Wave4.Newforms
import TauCeti.NumberTheory.ModularForms.Newforms.Nebentypus

/-!
# Miyake §4.6: the spaces `𝒮_k^1(N, χ)` and `𝒮_k^0(N, χ)`; Lemma 4.6.9

Miyake, *Modular Forms* (Springer 1989), p. 162.

Miyake defines `𝒮_k^1(N, χ)` as the subspace of `𝒮_k(N, χ)` generated by the forms `f(lz)` with
`f ∈ 𝒮_k(M, χ)`, where `M` runs over the positive integers with `m_χ ∣ M`, `M ∣ N`, `M ≠ N`
(`m_χ` the conductor of `χ`, so that `χ` can be read modulo `M`) and `l` over the positive
divisors of `N/M`; and `𝒮_k^0(N, χ)` as its orthogonal complement in `𝒮_k(N, χ)` for the
Petersson product.

* `oldSpace k χ` is `𝒮_k^1(N, χ)`, defined here in Miyake's terms. "`χ` read modulo `M`" is a
  character `χ'` modulo `M` with `changeLevel χ' = χ` (it exists exactly when `m_χ ∣ M`, and is
  then unique).
* Wave 4 took `𝒮_k^0(N, χ)` to be Tau Ceti's new subspace (`Wave4.newSpace`, the
  Petersson-orthogonal complement of the old forms of level `Γ₁(N)`, intersected with
  `𝒮_k(N, χ)`). `mem_newSpace_iff` proves that this is Miyake's definition: an element of
  `𝒮_k(N, χ)` lies in `newSpace k χ` if and only if it is Petersson-orthogonal to
  `oldSpace k χ`.
* **Lemma 4.6.9**: (1) `newSpace_eq_top_of_isPrimitive`; (2) `embed_mem_oldSpace`;
  (3) `span_raise_newSpace_eq_top`.

Proofs: through Tau Ceti's description of the old forms of a fixed nebentypus
(`TauCeti.cuspFormsOld_inf_cuspFormCharSpace_eq_iSup`,
`TauCeti.mem_cuspFormsNew_iff_of_mem_cuspFormCharSpace`).
-/

open UpperHalfPlane ModularForm CongruenceSubgroup Matrix.SpecialLinearGroup
open scoped MatrixGroups

noncomputable section

namespace ModularFormsKB.Miyake.Wave6

open Wave4

variable {N : ℕ} [NeZero N]

/-- The level-`N` cusp form `F` is `f(lz)` for some `f ∈ 𝒮_k(M, χ')`, `χ'` a character modulo
`M` inducing `χ` (with `l M ∣ N`). -/
def IsRaiseFrom (k : ℤ) (χ : DirichletCharacter ℂ N) (P : ∀ (M : ℕ) [NeZero M]
    (χ' : DirichletCharacter ℂ M), Submodule ℂ (cuspSpace k χ'))
    (F : CuspForm ((Gamma1 N).map (mapGL ℝ)) k) (M l : ℕ) : Prop :=
  ∃ (_ : NeZero M) (_ : NeZero l) (h : l * M ∣ N) (χ' : DirichletCharacter ℂ M),
    DirichletCharacter.changeLevel ((Dvd.intro_left l rfl).trans h) χ' = χ ∧
    ∃ f ∈ P M χ', F = TauCeti.CuspForm.levelRaise l
      (TauCeti.Gamma1_map_le_conjAct_scaleGL_of_dvd h) (f : CuspForm _ k)

/-- Miyake's `𝒮_k^1(N, χ)` (p. 162): the subspace of `𝒮_k(N, χ)` generated by the `f(lz)` with
`f ∈ 𝒮_k(M, χ)`, `m_χ ∣ M ∣ N`, `M ≠ N`, `l ∣ N/M`. -/
def oldSpace (k : ℤ) (χ : DirichletCharacter ℂ N) : Submodule ℂ (cuspSpace k χ) :=
  Submodule.span ℂ {F : cuspSpace k χ | ∃ M l : ℕ, M ≠ N ∧ χ.conductor ∣ M ∧
    IsRaiseFrom k χ (fun M _ χ' ↦ ⊤) (F : CuspForm _ k) M l}

/-- `MulChar.toUnitHom` is injective. -/
lemma toUnitHom_injective {M : ℕ} :
    Function.Injective (MulChar.toUnitHom : DirichletCharacter ℂ M → (ZMod M)ˣ →* ℂˣ) := by
  intro a b h
  rw [MulChar.toUnitHom_eq, MulChar.toUnitHom_eq] at h
  exact MulChar.equivToUnitHom.injective h

lemma toUnitHom_ofUnitHom {M : ℕ} (ψ : (ZMod M)ˣ →* ℂˣ) :
    (MulChar.ofUnitHom ψ : DirichletCharacter ℂ M).toUnitHom = ψ := by
  rw [MulChar.ofUnitHom_eq, MulChar.toUnitHom_eq, Equiv.apply_symm_apply]

/-- A character induced from level `M` has conductor dividing `M`. -/
lemma conductor_changeLevel_dvd {M N : ℕ} [NeZero N] (h : M ∣ N) (χ' : DirichletCharacter ℂ M) :
    (DirichletCharacter.changeLevel h χ').conductor ∣ M :=
  DirichletCharacter.conductor_dvd_of_mem_conductorSet _
    ((DirichletCharacter.mem_conductorSet_iff _).mpr
      (DirichletCharacter.changeLevel_factorsThrough χ' h))

/-- The image of Miyake's `𝒮_k^1(N, χ)` in `S_k(Γ₁(N))` is Tau Ceti's old forms of nebentypus
`χ`. -/
theorem map_oldSpace (k : ℤ) (χ : DirichletCharacter ℂ N) :
    (oldSpace k χ).map (cuspSpace k χ).subtype =
      TauCeti.cuspFormsOld N k ⊓ TauCeti.cuspFormCharSpace k χ.toUnitHom := by
  rw [oldSpace, Submodule.map_span]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨F, ⟨M, l, hM, -, hM0, hl0, h, χ', hχ', f, -, hF⟩, rfl⟩
    simp only [Submodule.coe_subtype, SetLike.mem_coe]
    rw [hF]
    exact TauCeti.levelRaise_mem_cuspFormsOld_inf_cuspFormCharSpace h hM
      (ψ := χ'.toUnitHom) (by rw [← hχ', toUnitHom_changeLevel]) f.2
  · refine TauCeti.cuspFormsOld_inf_cuspFormCharSpace_le fun M d _ h hM ψ hψ g hg ↦ ?_
    have hM0 : NeZero M := NeZero.of_dvd (dvd_of_mul_left_dvd h)
    have hMN : M ∣ N := (Dvd.intro_left d rfl).trans h
    set χ' : DirichletCharacter ℂ M := MulChar.ofUnitHom ψ
    have hχ' : DirichletCharacter.changeLevel hMN χ' = χ := by
      apply toUnitHom_injective
      rw [toUnitHom_changeLevel, toUnitHom_ofUnitHom, hψ]
    have hg' : g ∈ cuspSpace k χ' := by
      change g ∈ TauCeti.cuspFormCharSpace k χ'.toUnitHom
      rwa [toUnitHom_ofUnitHom]
    have hmem : TauCeti.CuspForm.levelRaise d (TauCeti.Gamma1_map_le_conjAct_scaleGL_of_dvd h) g ∈
        cuspSpace k χ := by
      change _ ∈ TauCeti.cuspFormCharSpace k χ.toUnitHom
      rw [hψ]
      exact TauCeti.CuspForm.levelRaise_mem_cuspFormCharSpace_of_dvd h ψ hg
    refine Submodule.subset_span ⟨⟨_, hmem⟩, ⟨M, d, hM, ?_, hM0, inferInstance, h, χ', hχ',
      ⟨g, hg'⟩, trivial, rfl⟩, rfl⟩
    rw [← hχ']
    exact conductor_changeLevel_dvd hMN χ'

/-- **Miyake's `𝒮_k^0(N, χ)` is wave 4's `newSpace`.** An element of `𝒮_k(N, χ)` lies in
`newSpace k χ` (Tau Ceti's new forms) if and only if it is Petersson-orthogonal to Miyake's
`𝒮_k^1(N, χ)`. -/
@[kb "miyake1989" "definition of S_k^0(N, chi), p. 162"]
theorem mem_newSpace_iff (k : ℤ) (χ : DirichletCharacter ℂ N) (f : cuspSpace k χ) :
    f ∈ newSpace k χ ↔
      ∀ g ∈ oldSpace k χ, CuspForm.peterssonInnerCosets
        (g : CuspForm ((Gamma1 N).map (mapGL ℝ)) k) (f : CuspForm _ k) = 0 := by
  rw [Submodule.mem_comap, Submodule.coe_subtype,
    TauCeti.mem_cuspFormsNew_iff_of_mem_cuspFormCharSpace f.2,
    TauCeti.CuspForm.mem_peterssonOrthogonal_iff, ← map_oldSpace]
  constructor
  · intro H g hg
    exact H _ (Submodule.mem_map_of_mem hg)
  · rintro H _ ⟨g, hg, rfl⟩
    exact H g hg

/-- **Miyake, Lemma 4.6.9 (1)**: if `χ` is a primitive Dirichlet character of conductor `N`, then
`𝒮_k(N, χ) = 𝒮_k^0(N, χ)`. -/
@[kb "miyake1989" "Lemma 4.6.9 (1), p. 162"]
theorem newSpace_eq_top_of_isPrimitive (k : ℤ) {χ : DirichletCharacter ℂ N}
    (hχ : χ.IsPrimitive) : newSpace k χ = ⊤ := by
  refine eq_top_iff.mpr fun f _ ↦ ?_
  have hχ' : DirichletCharacter.IsPrimitive (MulChar.ofUnitHom χ.toUnitHom : DirichletCharacter ℂ N) := by
    rwa [ofUnitHom_toUnitHom]
  exact TauCeti.cuspFormCharSpace_le_cuspFormsNew_of_isPrimitive hχ' f.2

/-- **Miyake, Lemma 4.6.9 (2)**: if `m_χ ∣ M`, `M ∣ N` and `M ≠ N`, then
`𝒮_k(M, χ) ⊂ 𝒮_k^1(N, χ)` (through the natural embedding; `χ'` is `χ` read modulo `M`). -/
@[kb "miyake1989" "Lemma 4.6.9 (2), p. 162"]
theorem embed_mem_oldSpace (k : ℤ) {M : ℕ} [NeZero M] (hMN : M ∣ N) (hM : M ≠ N)
    {χ' : DirichletCharacter ℂ M} (f : cuspSpace k χ') :
    embed k χ' hMN f ∈ oldSpace k (DirichletCharacter.changeLevel hMN χ') := by
  have h1 : 1 * M ∣ N := by rwa [one_mul]
  refine Submodule.subset_span ⟨M, 1, hM, conductor_changeLevel_dvd hMN χ', inferInstance,
    inferInstance, h1, χ', rfl, f, trivial, ?_⟩
  rw [CuspForm.levelRaise_one]
  rfl

/-- The generators of Lemma 4.6.9 (3), as cusp forms of level `Γ₁(N)`. -/
def newGens (k : ℤ) (χ : DirichletCharacter ℂ N) : Set (CuspForm ((Gamma1 N).map (mapGL ℝ)) k) :=
  {F | ∃ M l : ℕ, χ.conductor ∣ M ∧ IsRaiseFrom k χ (fun M _ χ' ↦ newSpace k χ') F M l}

lemma newGens_subset (k : ℤ) (χ : DirichletCharacter ℂ N) :
    newGens k χ ⊆ (cuspSpace k χ : Set (CuspForm ((Gamma1 N).map (mapGL ℝ)) k)) := by
  rintro _ ⟨M, l, -, hM0, hl0, h, χ', hχ', f, -, rfl⟩
  change _ ∈ TauCeti.cuspFormCharSpace k χ.toUnitHom
  rw [← hχ', toUnitHom_changeLevel]
  exact TauCeti.CuspForm.levelRaise_mem_cuspFormCharSpace_of_dvd h χ'.toUnitHom f.2

/-- Level-raising carries the generators at level `M` into those at level `N`. -/
lemma levelRaise_mem_span_newGens (k : ℤ) {M l : ℕ} [NeZero M] [NeZero l] (h : l * M ∣ N)
    (χ' : DirichletCharacter ℂ M) {g : CuspForm ((Gamma1 M).map (mapGL ℝ)) k}
    (hg : g ∈ Submodule.span ℂ (newGens k χ')) :
    TauCeti.CuspForm.levelRaise l (TauCeti.Gamma1_map_le_conjAct_scaleGL_of_dvd h) g ∈
      Submodule.span ℂ (newGens k (DirichletCharacter.changeLevel
        ((Dvd.intro_left l rfl).trans h) χ')) := by
  have hMN : M ∣ N := (Dvd.intro_left l rfl).trans h
  have key : (Submodule.span ℂ (newGens k χ')).map
      (TauCeti.CuspForm.levelRaiseₗ (k := k) l (TauCeti.Gamma1_map_le_conjAct_scaleGL_of_dvd h)) ≤
      Submodule.span ℂ (newGens k (DirichletCharacter.changeLevel hMN χ')) := by
    rw [Submodule.map_span, Submodule.span_le]
    rintro _ ⟨_, ⟨M', l', hc, hM'0, hl'0, h', χ'', hχ'', f, hf, rfl⟩, rfl⟩
    have hM'M : M' ∣ M := (Dvd.intro_left l' rfl).trans h'
    have h'' : (l' * l) * M' ∣ N := by
      have : l * (l' * M') ∣ l * M := mul_dvd_mul_left l h'
      exact (by rw [show l' * l * M' = l * (l' * M') by ring]; exact this.trans h)
    refine Submodule.subset_span ⟨M', l' * l, ?_, hM'0, inferInstance, h'', χ'', ?_, f, hf, ?_⟩
    · rw [← hχ'', ← DirichletCharacter.changeLevel_trans]
      exact conductor_changeLevel_dvd _ χ''
    · rw [← hχ'', ← DirichletCharacter.changeLevel_trans]
    · rw [TauCeti.CuspForm.levelRaiseₗ_apply, TauCeti.CuspForm.levelRaise_levelRaise]
  have := key (Submodule.mem_map_of_mem hg)
  rwa [TauCeti.CuspForm.levelRaiseₗ_apply] at this

/-- The ambient form of Lemma 4.6.9 (3), by strong induction on the level. -/
theorem cuspSpace_le_span_newGens (k : ℤ) :
    ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N),
      (cuspSpace k χ : Submodule ℂ _) ≤ Submodule.span ℂ (newGens k χ) := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro _ χ f hf
  have hf' : f ∈ TauCeti.cuspFormCharSpace k χ.toUnitHom := hf
  rw [← TauCeti.sup_cuspFormsOld_cuspFormsNew_inf_cuspFormCharSpace, Submodule.mem_sup] at hf'
  obtain ⟨a, ha, b, hb, rfl⟩ := hf'
  refine add_mem ?_ ?_
  · rw [← map_oldSpace, oldSpace, Submodule.map_span] at ha
    refine (Submodule.span_le.mpr ?_) ha
    rintro _ ⟨F, ⟨M, l, hM, -, hM0, hl0, h, χ', hχ', g, -, hF⟩, rfl⟩
    simp only [Submodule.coe_subtype, SetLike.mem_coe]
    have hMN : M ∣ N := (Dvd.intro_left l rfl).trans h
    have hlt : M < N := lt_of_le_of_ne (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne N)) hMN) hM
    rw [hF]
    have := levelRaise_mem_span_newGens k h χ' (ih M hlt χ' g.2)
    rwa [hχ'] at this
  · have h1 : 1 * N ∣ N := by rw [one_mul]
    refine Submodule.subset_span ⟨N, 1, DirichletCharacter.conductor_dvd_level χ, inferInstance,
      inferInstance, h1, χ, DirichletCharacter.changeLevel_self χ, ⟨b, hb.2⟩, hb.1, ?_⟩
    exact (CuspForm.levelRaise_one_self _ b).symm

/-- **Miyake, Lemma 4.6.9 (3)**: `𝒮_k(N, χ)` is generated by the forms `f(lz)` with
`f ∈ 𝒮_k^0(M, χ)`, `m_χ ∣ M ∣ N` and `l ∣ N/M`. -/
@[kb "miyake1989" "Lemma 4.6.9 (3), p. 162"]
theorem span_raise_newSpace_eq_top (k : ℤ) (χ : DirichletCharacter ℂ N) :
    Submodule.span ℂ {F : cuspSpace k χ | ∃ M l : ℕ, χ.conductor ∣ M ∧
      IsRaiseFrom k χ (fun M _ χ' ↦ newSpace k χ') (F : CuspForm _ k) M l} = ⊤ := by
  refine eq_top_iff.mpr fun f _ ↦ ?_
  have hmap : (Submodule.span ℂ {F : cuspSpace k χ | (F : CuspForm _ k) ∈ newGens k χ}).map
      (cuspSpace k χ).subtype = Submodule.span ℂ (newGens k χ) := by
    rw [Submodule.map_span]
    congr 1
    exact Set.image_preimage_eq_of_subset (by
      intro F hF
      exact ⟨⟨F, newGens_subset k χ hF⟩, rfl⟩)
  have hf : (f : CuspForm _ k) ∈ Submodule.span ℂ (newGens k χ) :=
    cuspSpace_le_span_newGens k N χ f.2
  rw [← hmap] at hf
  obtain ⟨g, hg, hgf⟩ := hf
  rw [Subtype.ext hgf] at hg
  exact hg

end ModularFormsKB.Miyake.Wave6
