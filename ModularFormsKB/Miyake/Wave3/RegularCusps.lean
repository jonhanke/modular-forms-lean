import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import Mathlib.NumberTheory.ModularForms.Cusps
import ModularFormsKB.Citation
/-!
# Miyake, Theorem 4.2.10: the cusps of `Γ(N)` are regular for `N ≥ 3`

Miyake, *Modular Forms* (Springer 1989), §4.2, p. 112, Theorem 4.2.10, the clause "When `N ≥ 3`,
all cusps are regular". (Parts (1) and (2), no elliptic elements and the number of cusps, are
`ModularFormsKB.Miyake.not_isElliptic_of_mem_Gamma`, `card_cuspOrbits_Gamma`,
`card_cuspOrbits_Gamma_two` in `Miyake/CongruenceModularGroups.lean`.)

Miyake (§1.5, p. 19, before Lemma 1.5.6): a cusp `x` of `Γ`, with `σ ∈ SL₂(ℝ)`, `σx = ∞`, is *irregular* if
`-1 ∉ Γ` and `σ Γ_x σ⁻¹` is generated by `-[1 h; 0 1]`, and *regular* otherwise. For `N ≥ 3`,
`-1 ∉ Γ(N)`, so regularity of every cusp means: every element of `Γ(N)` fixing a cusp is
conjugate in `SL₂(ℝ)` to some `+[1 h; 0 1]`, never to `-[1 h; 0 1]`. Equivalently its trace is
`2` (the trace of `±[1 h; 0 1]` is `±2`). This is `trace_eq_two_of_mem_Gamma_of_smul_eq`.
-/

open Matrix OnePoint
open scoped MatrixGroups

namespace ModularFormsKB.Miyake

/-- **Miyake, Theorem 4.2.10, "all cusps of `Γ(N)` are regular" (`N ≥ 3`)**: an element `γ` of
`Γ(N)` fixing a cusp `c ∈ ℙ¹(ℚ)` of `SL₂(ℤ)` has trace `2`; hence `σγσ⁻¹ = [1 h; 0 1]` (not
`-[1 h; 0 1]`) for `σ ∈ SL₂(ℝ)` with `σc = ∞`. -/
@[kb "miyake1989" "Theorem 4.2.10, p. 112: all cusps of Gamma(N) are regular for N >= 3"]
theorem trace_eq_two_of_mem_Gamma_of_smul_eq {N : ℕ} (hN : 3 ≤ N) {γ : SL(2, ℤ)}
    (hγ : γ ∈ CongruenceSubgroup.Gamma N) {c : OnePoint ℝ} (hc : IsCusp c 𝒮ℒ)
    (hfix : (Matrix.SpecialLinearGroup.mapGL ℝ γ) • c = c) :
    (γ : Matrix (Fin 2) (Fin 2) ℤ).trace = 2 := by
  obtain ⟨δ, hδ⟩ := isCusp_SL2Z_iff'.mp hc
  have hmem : δ⁻¹ * γ * δ ∈ CongruenceSubgroup.Gamma N := by
    have := (CongruenceSubgroup.Gamma_normal N).conj_mem γ hγ δ⁻¹
    simpa using this
  have hfix' : (Matrix.SpecialLinearGroup.mapGL ℝ (δ⁻¹ * γ * δ)) • (∞ : OnePoint ℝ) = ∞ := by
    have h1 : (Matrix.SpecialLinearGroup.mapGL ℝ γ) • (Matrix.SpecialLinearGroup.mapGL ℝ δ • (∞ : OnePoint ℝ))
        = Matrix.SpecialLinearGroup.mapGL ℝ δ • (∞ : OnePoint ℝ) := by
      rw [← hδ]; exact hfix
    have h2 := congrArg (fun x => (Matrix.SpecialLinearGroup.mapGL ℝ δ)⁻¹ • x) h1
    simp only [inv_smul_smul] at h2
    simp only [map_mul, map_inv, mul_smul]
    simpa [mul_smul] using h2
  have h10 : (δ⁻¹ * γ * δ) 1 0 = 0 := by
    have := smul_infty_eq_self_iff.mp hfix'
    have e : ((Matrix.SpecialLinearGroup.mapGL ℝ (δ⁻¹ * γ * δ) : GL (Fin 2) ℝ) 1 0)
        = (((δ⁻¹ * γ * δ) 1 0 : ℤ) : ℝ) := rfl
    rw [e] at this
    exact_mod_cast this
  set γ' := δ⁻¹ * γ * δ with hγ'
  have hdet : γ' 0 0 * γ' 1 1 = 1 := by
    have := γ'.2
    rw [Matrix.det_fin_two] at this
    simpa [h10] using this
  have hc := (CongruenceSubgroup.Gamma_mem).mp hmem
  have hneg : ∀ a : ℤ, (a : ZMod N) = 1 → a ≠ -1 := by
    intro a ha h
    subst h
    have h2 : ((2 : ℤ) : ZMod N) = 0 := by
      have : ((-1 : ℤ) : ZMod N) = 1 := ha
      push_cast at this ⊢
      linear_combination -this
    have := Int.le_of_dvd (by norm_num) ((ZMod.intCast_zmod_eq_zero_iff_dvd 2 N).mp h2)
    omega
  have ha : γ' 0 0 = 1 := by
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hdet with h | h
    · exact h
    · exact absurd h (hneg _ hc.1)
  have hd : γ' 1 1 = 1 := by
    rcases Int.eq_one_or_neg_one_of_mul_eq_one' hdet with ⟨h, _⟩ | ⟨h, _⟩
    · omega
    · omega
  have htr : (γ' : Matrix (Fin 2) (Fin 2) ℤ).trace = 2 := by
    simp [Matrix.trace_fin_two, ha, hd]
  rw [← htr, hγ']
  simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  rw [Matrix.trace_mul_comm, ← mul_assoc, Matrix.mul_adjugate]
  simp

/-- For `N ≥ 3`, `-1 ∉ Γ(N)`. -/
@[kb "miyake1989" "Theorem 4.2.10, p. 112: -1 is not in Gamma(N) for N >= 3"]
theorem neg_one_not_mem_Gamma {N : ℕ} (hN : 3 ≤ N) :
    (-1 : SL(2, ℤ)) ∉ CongruenceSubgroup.Gamma N := by
  intro h
  have h1 := (CongruenceSubgroup.Gamma_mem).mp h
  have h2 : ((2 : ℤ) : ZMod N) = 0 := by
    have : (((-1 : SL(2, ℤ)) 0 0 : ℤ) : ZMod N) = 1 := h1.1
    simp at this
    push_cast
    linear_combination -this
  have := Int.le_of_dvd (by norm_num) ((ZMod.intCast_zmod_eq_zero_iff_dvd 2 N).mp h2)
  omega

end ModularFormsKB.Miyake
